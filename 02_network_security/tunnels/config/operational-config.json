{
  "version": "2.1.0",
  "description": "Tunnel Tools Operational Configuration — Multi-service support aligned with Dockerfile.tor-proxy-02 (/app layout)",
  "service_name": "tunnel-tools",
  "compatible_services": [
    "tunnel-tools",
    "tor-proxy",
    "tor-socks",
    "api-gateway",
    "lucid-auth-service",
    "rdp-server-manager-http",
    "rdp-controller-http",
    "service-mesh-controller",
    "server-core-system",
    "server",
    "server-manager",
    "server-controller"
  ],
  "paths": {
    "service_bin": "/app/02_network_security/[service]/scripts/[script_name]",
    "service_config": "/app/service_configs/[service_name].yml",
    "tor_binary": "/app/bin/tor",
    "tor_config": "/app/run/lucid/tor/torrc",
    "tor_control_socket": "/app/var/lib/tor/control",
    "tor_data_dir": "/app/var/lib/tor",
    "tor_log_file": "/app/run/lucid/tor/log/tor.log",
    "tor_onion_service_dir": "/app/run/lucid/onion",
    "tor_seed_dir": "/app/var/lib/tor/seed",
    "geoip_dir": "/app/opt/share/tor",
    "scripts_dir": "/app/02_network_security/[service]/scripts",
    "bin_helpers": "/app/bin",
    "bash_binary": "/app/bin/bash",
    "tini_binary": "/app/bin/tini",
    "python_binary": "/app/usr/bin/python3.11",
    "metrics_file": "/app/run/lucid/[service]/metrics.json",
    "onion_env_file": "/app/run/lucid/onion/.onion.env",
    "lucid_config_path": "/app/configs/host-config.yml",
    "lucid_services_config_dir": "/app/service_configs"
  },
  "operations": {
    "create_onion": {
      "enabled": true,
      "script": "create_ephemeral_onion.sh",
      "description": "Create a new ephemeral onion service",
      "timeout_seconds": 30,
      "retry": {
        "max_attempts": 3,
        "delay_seconds": 5,
        "exponential_backoff": true
      }
    },
    "rotate_onion": {
      "enabled": true,
      "script": "rotate_onion.sh",
      "description": "Rotate existing onion service",
      "timeout_seconds": 60,
      "depends_on": ["verify_tunnel"],
      "retry": {
        "max_attempts": 2,
        "delay_seconds": 10
      }
    },
    "verify_tunnel": {
      "enabled": true,
      "script": "verify_tunnel.sh",
      "description": "Verify tunnel reachability",
      "timeout_seconds": 20,
      "health_check": {
        "enabled": true,
        "interval_seconds": 60,
        "failure_threshold": 3
      }
    },
    "refresh_tunnel": {
      "enabled": true,
      "script": "refresh_tunnel.sh",
      "description": "Refresh tunnel by rotating and verifying",
      "timeout_seconds": 90,
      "depends_on": ["rotate_onion", "verify_tunnel"]
    },
    "teardown_tunnel": {
      "enabled": true,
      "script": "teardown_tunnel.sh",
      "description": "Remove ephemeral onion tunnel",
      "timeout_seconds": 30
    },
    "list_tunnels": {
      "enabled": true,
      "script": "list_tunnels.sh",
      "description": "List current tunnel information",
      "timeout_seconds": 10
    },
    "tunnel_status": {
      "enabled": true,
      "script": "tunnel_status.sh",
      "description": "Check tunnel status",
      "timeout_seconds": 15
    }
  },
  "workflows": {
    "startup": {
      "enabled": true,
      "steps": [
        {
          "operation": "create_onion",
          "on_failure": "retry"
        },
        {
          "operation": "verify_tunnel",
          "on_failure": "retry",
          "wait_after_seconds": 5
        }
      ],
      "on_failure": "alert"
    },
    "rotation": {
      "enabled": true,
      "steps": [
        {
          "operation": "rotate_onion",
          "on_failure": "abort"
        },
        {
          "operation": "verify_tunnel",
          "on_failure": "retry",
          "wait_after_seconds": 10
        }
      ],
      "on_failure": "alert"
    },
    "refresh": {
      "enabled": true,
      "steps": [
        {
          "operation": "refresh_tunnel"
        }
      ],
      "on_failure": "retry"
    }
  },
  "schedules": {
    "daily_rotation": {
      "enabled": false,
      "workflow": "rotation",
      "cron": "0 2 * * *",
      "timezone": "UTC"
    },
    "hourly_verification": {
      "enabled": true,
      "operation": "verify_tunnel",
      "cron": "0 * * * *",
      "timezone": "UTC"
    }
  },
  "monitoring": {
    "health_checks": {
      "tunnel_reachability": {
        "enabled": true,
        "operation": "verify_tunnel",
        "interval_seconds": 60,
        "timeout_seconds": 20,
        "alert_on_failure": true,
        "failure_threshold": 3
      },
      "tor_connection": {
        "enabled": true,
        "check_type": "control_port",
        "interval_seconds": 30,
        "timeout_seconds": 5,
        "alert_on_failure": true
      }
    },
    "metrics": {
      "enabled": true,
      "collection_interval_seconds": 60,
      "retention_days": 7,
      "export_formats": ["json"]
    },
    "alerts": {
      "enabled": true,
      "channels": [],
      "rules": [
        {
          "name": "TunnelUnreachable",
          "condition": "verification_failures >= 3",
          "severity": "critical",
          "cooldown_seconds": 300
        },
        {
          "name": "TorConnectionFailed",
          "condition": "tor_connection_failed",
          "severity": "critical",
          "cooldown_seconds": 60
        },
        {
          "name": "OnionCreationFailed",
          "condition": "onion_creation_failed",
          "severity": "warning",
          "cooldown_seconds": 180
        }
      ]
    },
    "performance": {
      "connection_timeout_seconds": 10,
      "command_timeout_seconds": 30,
      "max_retries": 3,
      "retry_delay_seconds": 5
    }
  },
  "service_specific_config": {
    "description": "Service-specific overrides for different Lucid services",
    "notes": "Each service can override default paths and enable/disable specific operations",
    "tunnel-tools": {
      "service_name": "tunnel-tools",
      "description": "Tunnel management and monitoring tools service",
      "paths_override": {
        "service_scripts_dir": "/app/02_network_security/tunnels/scripts",
        "service_config_file": "/app/service_configs/tunnel-tools.yml"
      },
      "operations_enabled": {
        "create_onion": true,
        "rotate_onion": true,
        "verify_tunnel": true,
        "refresh_tunnel": true,
        "teardown_tunnel": true,
        "list_tunnels": true,
        "tunnel_status": true
      },
      "monitoring_enabled": {
        "tunnel_reachability": true,
        "tor_connection": true,
        "metrics": true
      },
      "expose": {
        "ports": [7000]
      }
    },
    "tor-proxy": {
      "service_name": "tor-proxy",
      "description": "Tor SOCKS proxy service",
      "paths_override": {
        "service_scripts_dir": "/app/02_network_security/tor/scripts",
        "service_config_file": "/app/service_configs/tor-socks.yml",
        "tor_binary": "/app/bin/tor",
        "tor_config": "/app/run/lucid/tor/torrc"
      },
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "tor_connection": true,
        "metrics": false
      },
      "expose": {
        "ports": [9050, 9051]
      }
    },
    "tor-socks": {
      "service_name": "tor-socks",
      "description": "Tor SOCKS service (service mesh component)",
      "paths_override": {
        "service_config_file": "/app/service_configs/tor/tor-socks.yml"
      },
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "tor_connection": true
      },
      "expose": {
        "ports": [9050, 9051]
      }
    },
    "api-gateway": {
      "service_name": "api-gateway",
      "description": "API Gateway service",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [8080]
      }
    },
    "lucid-auth-service": {
      "service_name": "lucid-auth-service",
      "description": "Lucid Authentication service",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [8113]
      }
    },
    "rdp-server-manager-http": {
      "service_name": "rdp-server-manager-http",
      "description": "RDP Server Manager HTTP service",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [28120]
      }
    },
    "rdp-controller-http": {
      "service_name": "rdp-controller-http",
      "description": "RDP Controller HTTP service",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [28121]
      }
    },
    "service-mesh-controller": {
      "service_name": "service-mesh-controller",
      "description": "Service Mesh Controller",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [19091]
      }
    },
    "server-core-system": {
      "service_name": "server-core-system",
      "description": "Server Core System",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [8081]
      }
    },
    "server": {
      "service_name": "server",
      "description": "Server service",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [8120]
      }
    },
    "server-manager": {
      "service_name": "server-manager",
      "description": "Server Manager service",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [28120]
      }
    },
    "server-controller": {
      "service_name": "server-controller",
      "description": "Server Controller service",
      "operations_enabled": {
        "create_onion": false,
        "rotate_onion": false,
        "verify_tunnel": false,
        "refresh_tunnel": false,
        "teardown_tunnel": false,
        "list_tunnels": false,
        "tunnel_status": false
      },
      "monitoring_enabled": {
        "metrics": true
      },
      "expose": {
        "ports": [28121]
      }
    }
  }
}
