# LUCID TOR PROXY - SPEC-4 Stage 0 Beta Sidecar
# Distroless Tor proxy for Lucid (ARM64), aligned with project spin-up
# Build from project root: docker build -f 02_network_security/tor/Dockerfile.tor .
# syntax=docker/dockerfile:1.5

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=2.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64

# STAGE 1
FROM --platform=$TARGETPLATFORM debian:12-slim AS tor-builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update && apt-get install -y --no-install-recommends \
      tor \
      tor-geoipdb \
      obfs4proxy \
      tini \
      bash \
      busybox \
      coreutils \
      netcat-openbsd \
      xxd \
      gosu \
      ca-certificates \
      dnsutils \
      curl \
      jq \
      adduser \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && adduser --disabled-password --shell /bin/bash --gecos "" lucid

WORKDIR /build

# Create the container's internal runtime directory structure.

RUN \
    # ── Container runtime data root ──────────────────────────────────────── \
    install -d -o debian-tor -g debian-tor -m 755 /app/run/lucid                 \
 && install -d -o debian-tor -g debian-tor -m 755 /app/run/lucid/onion           \
 && install -d -o debian-tor -g debian-tor -m 700 /app/run/lucid/tor             \
 && install -d -o root       -g root       -m 755 /app/run/lucid/tor/bin         \
 && printf 'dir=run/lucid/tor/bin\nplatform=lucid-tor-proxy\n' 
        > /app/run/lucid/tor/bin/.keep \
        > /app/run/lucid/tor/.keep \
        > /app/run/lucid/onion/.keep \
        > /app/run/lucid/.keep \      
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_admin                        \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_admin/authorized_clients     \
 && printf 'service=lucid_admin\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_admin/.keep                                              \
        > /app/run/lucid/tor/lucid_admin/authorized_clients/.keep \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_vm                           \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_vm/authorized_clients        \
 && printf 'service=lucid_vm\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_vm/.keep                                                 \
        > /app/run/lucid/tor/lucid_vm/authorized_clients/.keep \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_node                         \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_node/authorized_clients      \
 && printf 'service=lucid_node\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_node/.keep                                               \
        > /app/run/lucid/tor/lucid_node/authorized_clients/.keep \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_blockchain                   \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_blockchain/authorized_clients \
 && printf 'service=lucid_blockchain\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_blockchain/.keep                                         \
        > /app/run/lucid/tor/lucid_blockchain/authorized_clients/.keep \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_governance                   \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_governance/authorized_clients \
 && printf 'service=lucid_governance\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_governance/.keep                                         \
        > /app/run/lucid/tor/lucid_governance/authorized_clients/.keep \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_payment                      \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_payment/authorized_clients   \
 && printf 'service=lucid_payment\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_payment/.keep                                            \
        > /app/run/lucid/tor/lucid_payment/authorized_clients/.keep  \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_session                      \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_session/authorized_clients   \
 && printf 'service=lucid_session\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_session/.keep                                            \
        > /app/run/lucid/tor/lucid_session/authorized_clients/.keep                           \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_rdp                          \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_rdp/authorized_clients       \
 && printf 'service=lucid_rdp\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_rdp/.keep                                                \
        > /app/run/lucid/tor/lucid_rdp/authorized_clients/.keep  \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_wallet                       \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_wallet/authorized_clients    \
 && printf 'service=lucid_wallet\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_wallet/.keep                                          \
        > /app/run/lucid/tor/lucid_wallet/authorized_clients/.keep  \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_voting                       \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_voting/authorized_clients    \
 && printf 'service=lucid_voting\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_voting/.keep                                             \
        > /app/run/lucid/tor/lucid_voting/authorized_clients/.keep   \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_voting_system                \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_voting_system/authorized_clients \
 && printf 'service=lucid_voting_system\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_voting_system/.keep                                      \
        > /app/run/lucid/tor/lucid_voting_system/authorized_clients/.keep              \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_voting_system_admin          \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_voting_system_admin/authorized_clients \
 && printf 'service=lucid_voting_system_admin\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_voting_system_admin/.keep                                \
        > /app/run/lucid/tor/lucid_voting_system_admin/authorized_clients/.keep             \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_voting_system_admin_admin    \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_voting_system_admin_admin/authorized_clients \
 && printf 'service=lucid_voting_system_admin_admin\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_voting_system_admin_admin/.keep                          \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_server                       \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_server/authorized_clients    \
 && printf 'service=lucid_server\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_server/.keep                                             \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/myservice                          \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/myservice/authorized_clients       \
 && printf 'service=myservice\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/myservice/.keep                                                \
    \
 && install -d -o root -g root -m 755 /app/run/lucid/tor/lucid_portal                       \
 && install -d -o root -g root -m 700 /app/run/lucid/tor/lucid_portal/authorized_clients    \
 && printf 'service=lucid_portal\ntype=hidden-service\nplatform=lucid-tor-proxy\n' \
        > /app/run/lucid/tor/lucid_portal/.keep                                             \
    \


    # ── Ephemeral scratch and config dirs ─────────────────────────────────── 
 && install -d -o debian-tor -g debian-tor -m 700 /tmp/lucid/tor                        \
 && install -d -o root       -g root       -m 755 /tmp/lucid/tor/lucid_admin            \
 && printf 'service=lucid_admin\ntype=tmp-scratch\nplatform=lucid-tor-proxy\n' \
        > /tmp/lucid/tor/lucid_admin/.keep                                              \
 && install -d -o root -g root -m 755 /tmp/lucid/tor/tunnels                            \
    \
    # ── Application root ──────────────────────────────────────────────────── \
 && install -d -o debian-tor -g debian-tor -m 755 /app/tor                              \
    \
    # ── Top-level marker files ────────────────────────────────────────────── \
 && printf 'dir=run/lucid\nplatform=lucid-tor-proxy\n' > /app/run/lucid/.keep               \
 && printf 'dir=app/tor\nplatform=lucid-tor-proxy\n'   > /app/tor/.keep                 \
 && chown debian-tor:debian-tor /run/lucid/.keep /app/tor/.keep \
    \
    # ── /opt directory scaffold ────────────────────────────────────────────── \
 && install -d -o root -g root -m 755 /opt                                               \
 && install -d -o root -g root -m 755 /opt/bin                                           \
 && install -d -o root -g root -m 755 /opt/sbin                                          \
 && install -d -o root -g root -m 755 /opt/lib                                           \
 && install -d -o root -g root -m 755 /opt/share                                         \
 && install -d -o root -g root -m 755 /opt/share/tor                                     \
 && printf 'dir=opt\nplatform=lucid-tor-proxy\n'           > /opt/.keep                  \
 && printf 'dir=opt/bin\nplatform=lucid-tor-proxy\n'       > /opt/bin/.keep              \
 && printf 'dir=opt/sbin\nplatform=lucid-tor-proxy\n'      > /opt/sbin/.keep             \
 && printf 'dir=opt/lib\nplatform=lucid-tor-proxy\n'       > /opt/lib/.keep              \
 && printf 'dir=opt/share/tor\nplatform=lucid-tor-proxy\n' > /opt/share/tor/.keep


RUN set -eux; \
    \
    echo "=== binary dependency checks ==="; \
    for bin in \
        /verify/usr/bin/tor \
        /verify/usr/bin/obfs4proxy \
        /verify/usr/sbin/gosu \
        /verify/usr/bin/tini \
        /verify/usr/bin/curl \
        /verify/usr/bin/jq; \
    do \
        echo "--> $bin"; \
        missing=$(LD_LIBRARY_PATH=/verify/lib/aarch64-linux-gnu:/verify/usr/lib \
            ldd "$bin" 2>&1 | grep "not found" || true); \
        if [ -n "$missing" ]; then \
            echo "MISSING DEPENDENCIES in $bin:"; echo "$missing"; exit 1; \
        fi; \
        echo "  OK"; \
    done; \
    \
    echo "=== directory structure ==="; \
    for dir in \
        /verify/run/lucid \
        /verify/run/lucid/onion \
        /verify/run/lucid/tor \
        /verify/run/lucid/tor/bin \
        /verify/run/lucid/tor/lucid_admin \
        /verify/run/lucid/tor/lucid_vm \
        /verify/run/lucid/tor/lucid_node \
        /verify/run/lucid/tor/lucid_blockchain \
        /verify/run/lucid/tor/lucid_governance \
        /verify/run/lucid/tor/lucid_payment \
        /verify/run/lucid/tor/lucid_session \
        /verify/run/lucid/tor/lucid_rdp \
        /verify/run/lucid/tor/lucid_wallet \
        /verify/run/lucid/tor/lucid_voting \
        /verify/run/lucid/tor/lucid_voting_system \
        /verify/run/lucid/tor/lucid_voting_system_admin \
        /verify/run/lucid/tor/lucid_voting_system_admin_admin \
        /verify/run/lucid/tor/lucid_server \
        /verify/run/lucid/tor/myservice \
        /verify/run/lucid/tor/lucid_portal \
        /verify/tmp/lucid/tor \
        /verify/tmp/lucid/tor/lucid_admin \
        /verify/app/tor \
        /verify/opt \
        /verify/opt/bin \
        /verify/opt/sbin \
        /verify/opt/lib \
        /verify/opt/share/tor; \
    do \
        test -d "$dir" || { echo "MISSING DIR: $dir"; exit 1; }; \
        echo "  OK  $dir"; \
    done; \
    \
    echo "=== authorized_clients subdirs ==="; \
    for acdir in \
        /verify/run/lucid/tor/lucid_admin/authorized_clients \
        /verify/run/lucid/tor/lucid_vm/authorized_clients \
        /verify/run/lucid/tor/lucid_node/authorized_clients \
        /verify/run/lucid/tor/lucid_blockchain/authorized_clients \
        /verify/run/lucid/tor/lucid_governance/authorized_clients \
        /verify/run/lucid/tor/lucid_payment/authorized_clients \
        /verify/run/lucid/tor/lucid_session/authorized_clients \
        /verify/run/lucid/tor/lucid_rdp/authorized_clients \
        /verify/run/lucid/tor/lucid_wallet/authorized_clients \
        /verify/run/lucid/tor/lucid_voting/authorized_clients \
        /verify/run/lucid/tor/lucid_voting_system/authorized_clients \
        /verify/run/lucid/tor/lucid_voting_system_admin/authorized_clients \
        /verify/run/lucid/tor/lucid_voting_system_admin_admin/authorized_clients \
        /verify/run/lucid/tor/lucid_server/authorized_clients \
        /verify/run/lucid/tor/myservice/authorized_clients \
        /verify/run/lucid/tor/lucid_portal/authorized_clients; \
    do \
        test -d "$acdir" || { echo "MISSING authorized_clients: $acdir"; exit 1; }; \
        echo "  OK  $acdir"; \
    done; \
    \
    echo "=== marker file content ==="; \
    for marker in \
        /verify/run/lucid/.keep \
        /verify/app/tor/.keep \
        /verify/run/lucid/tor/lucid_admin/.keep \
        /verify/run/lucid/tor/lucid_vm/.keep \
        /verify/run/lucid/tor/lucid_node/.keep \
        /verify/run/lucid/tor/lucid_blockchain/.keep \
        /verify/run/lucid/tor/lucid_governance/.keep \
        /verify/run/lucid/tor/lucid_payment/.keep \
        /verify/run/lucid/tor/lucid_session/.keep \
        /verify/run/lucid/tor/lucid_rdp/.keep \
        /verify/run/lucid/tor/lucid_wallet/.keep \
        /verify/run/lucid/tor/lucid_voting/.keep \
        /verify/run/lucid/tor/lucid_voting_system/.keep \
        /verify/run/lucid/tor/lucid_voting_system_admin/.keep \
        /verify/run/lucid/tor/lucid_voting_system_admin_admin/.keep \
        /verify/run/lucid/tor/lucid_server/.keep \
        /verify/run/lucid/tor/myservice/.keep \
        /verify/run/lucid/tor/lucid_portal/.keep \
        /verify/tmp/lucid/tor/lucid_admin/.keep \
        /verify/opt/.keep \
        /verify/opt/bin/.keep \
        /verify/opt/sbin/.keep \
        /verify/opt/lib/.keep \
        /verify/opt/share/tor/.keep \
        /verify/run/lucid/tor/bin/.keep \
        /verify/run/lucid/tor/.keep \
        /verify/run/lucid/onion/.keep \
        /verify/run/lucid/.keep \
        /verify/tmp/lucid/tor/lucid_admin/.keep \
        /verify/tmp/lucid/tor/lucid_vm/.keep \
        /verify/tmp/lucid/tor/lucid_node/.keep \
        /verify/tmp/lucid/tor/lucid_blockchain/.keep \
        /verify/tmp/lucid/tor/lucid_governance/.keep \
        /verify/tmp/lucid/tor/lucid_payment/.keep \
        /verify/tmp/lucid/tor/lucid_session/.keep \
        /verify/tmp/lucid/tor/lucid_rdp/.keep \
    
    do \
        test -f "$marker" || { echo "MISSING MARKER: $marker"; exit 1; }; \
        test -s "$marker" || { echo "EMPTY MARKER:   $marker"; exit 1; }; \
        grep -q "lucid-tor-proxy" "$marker" \
            || { echo "INVALID MARKER CONTENT: $marker"; exit 1; }; \
        echo "  OK  $marker"; \
    done; \
    \
    echo "=== binary executability ==="; \
    for bin in \
        /verify/usr/bin/tor \
        /verify/usr/bin/obfs4proxy \
        /verify/usr/sbin/gosu \
        /verify/usr/bin/tini \
        /verify/usr/bin/curl \
        /verify/usr/bin/jq; \
    do \
        test -x "$bin" || { echo "NOT EXECUTABLE: $bin"; exit 1; }; \
        echo "  OK  $bin"; \
    done; \
    \
    echo "All verification checks passed."; \
    echo "verified" > /verified

# =============================================================================
# STAGE 3: Distroless Runtime
# =============================================================================

FROM --platform=$TARGETPLATFORM gcr.io/distroless/base-debian12:latest AS runtime

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=2.0.0

LABEL maintainer="Lucid Development Team" \
      org.opencontainers.image.title="Lucid Tor Proxy" \
      org.opencontainers.image.description="Distroless Tor proxy for Lucid project" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="tor-proxy" \
      com.lucid.layer="0" \
      org.lucid.layer="0" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="9050,9051,8888" \
      com.lucid.cluster="foundation" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.tunnel-tools,.env.secrets,.env.foundation" \
      com.lucid.tor.inherent="true" \
      com.lucid.tor.system="built-in"

ENV PATH="/app/run/lucid/tor/bin:/app/bin:/app/sbin:/app/lib:/app/share/tor:/app/bin" \
    LD_LIBRARY_PATH="/app/lib" \
    TOR_CONTROL_PORT="9051" \
    TOR_DATA_DIR="/app/lib/tor" \
    TOR_SOCKS_PORT="9050"


# ── /opt scaffold (dirs + .keep markers) — created in Stage 1 ─────────────
COPY --from=tor-builder /opt /app/opt

# ── Core binaries (/opt/bin, /opt/sbin) — build-time installed tools ──────
COPY --from=tor-builder /usr/bin/tor        /app/bin/tor
COPY --from=tor-builder /usr/bin/obfs4proxy /app/bin/obfs4proxy
COPY --from=tor-builder /usr/bin/tini       /app/bin/tini
COPY --from=tor-builder /usr/sbin/gosu      /app/sbin/gosu
COPY --from=tor-builder /bin/bash           /app/bin/bash
COPY --from=tor-builder /bin/busybox        /app/bin/busybox
COPY --from=tor-builder /bin/cat            /app/bin/cat
COPY --from=tor-builder /bin/chmod          /app/bin/chmod
COPY --from=tor-builder /bin/chown          /app/bin/chown
COPY --from=tor-builder /bin/mkdir          /app/bin/mkdir
COPY --from=tor-builder /bin/rm             /app/bin/rm
COPY --from=tor-builder /bin/sleep          /app/bin/sleep
COPY --from=tor-builder /bin/tail           /app/bin/tail
COPY --from=tor-builder /usr/bin/curl       /app/bin/curl
COPY --from=tor-builder /usr/bin/jq         /app/bin/jq
COPY --from=tor-builder /bin/nc             /app/bin/nc
COPY --from=tor-builder /usr/bin/timeout    /app/bin/timeout
COPY --from=tor-builder /usr/bin/xxd        /app/bin/xxd

# ── ARM64 dynamic linker + shared libraries (/opt/lib) ────────────────────
COPY --from=tor-builder /lib/ld-linux-aarch64.so.1 /lib/ld-linux-aarch64.so.1
COPY --from=tor-builder /lib/aarch64-linux-gnu      /app/lib/aarch64-linux-gnu
COPY --from=tor-builder /usr/lib                    /app/lib

# ── Tor GeoIP static data (/opt/share/tor) — build-time installed ─────────
COPY --from=tor-builder /usr/share/tor /opt/share/tor

# ── Runtime config (/run/lucid) — operational at container start ──────────
COPY --from=tor-builder /etc/ssl/certs/ca-certificates.crt /app/run/lucid/ssl/certs/ca-certificates.crt
COPY --from=tor-builder /etc/passwd /app/run/lucid/passwd
COPY --from=tor-builder /run/lucid/passwd /app/run/lucid/passwd
COPY --from=tor-builder /usr/lib/openvpn /app/run/lucid/openvpn
COPY --from=tor-builder /usr/lib/openssh /app/run/lucid/openssh
# ── Internal container directory structure ─────────────────────────────────

COPY --from=tor-builder --chown=debian-tor:debian-tor /etc/host.conf /app/run/lucid/host.conf
COPY --from=tor-builder --chown=debian-tor:debian-tor /etc/hostname /app/run/lucid/hostname
COPY --from=tor-builder --chown=debian-tor:debian-tor /run/lucid /app/run/lucid
COPY --from=tor-builder --chown=debian-tor:debian-tor /etc/tor /app/run/lucid/tor
COPY --from=tor-builder --chown=debian-tor:debian-tor /run/lucid/tor /app/run/lucid/tor/configs
COPY --from=tor-builder --chown=debian-tor:debian-tor /run/lucid/tor/logs /app/run/lucid/tor/logs
COPY --from=tor-builder --chmod=755 /app/var/lib/tor/lucid_admin /app/run/lucid/tor/lucid_admin
COPY --from=tor-builder --chmod=755 /app/var/lib/tor/lucid_vm /app/run/lucid/tor/lucid_vm
COPY --from=tor-builder --chmod=755 /app/var/lib/tor/lucid_node /app/run/lucid/tor/lucid_node
COPY --from=tor-builder --chmod=755 /app/var/lib/tor/lucid_blockchain /app/run/lucid/tor/lucid_blockchain
COPY --from=tor-builder --chmod=755 /app/var/lib/tor/lucid_governance /app/run/lucid/tor/lucid_server
# ── Lucid operational scripts (/run/lucid/tor/bin) — operate the container ─

COPY --chmod=644 tor/torrc /app/run/lucid/tor/torrc
COPY --chmod=644 tor/torrc /app/run/lucid/tor/configs/torrc
COPY --chmod=755 tor/entrypoint.sh /app/run/lucid/tor/bin/entrypoint.sh
COPY --chmod=755 tor/tor-health.sh /app/run/lucid/tor/bin/tor-health.sh
COPY --chmod=755 tor/tor-show-onion.sh /app/run/lucid/tor/bin/tor-show-onion.sh
COPY --chmod=755 tor/scripts/create_ephemeral_onion.sh /app/run/lucid/tor/bin/create-ephemeral-onion.sh
COPY --chmod=755 tor/scripts/create_ephemeral_onion.sh /app/run/lucid/tor/bin/create-ephemeral-onion.sh
COPY --chmod=755 tor/scripts/create_dynamic_onion.sh /app/run/lucid/tor/bin/create-dynamic-onion.sh
COPY --chmod=755 tor/scripts/check_tor_bootstrap.sh /app/run/lucid/tor/bin/check-tor-bootstrap.sh
COPY --chmod=755 tor/scripts/start_tor.sh /app/run/lucid/tor/bin/start-tor.sh

# ── Tunnel configurations ──────────────────────────────────────────────────
COPY --chmod=644 tunnels /app/run/lucid/tor/tunnels
COPY --from=tor-builder --chown=65532:65532 /run/lucid/onion /app/run/lucid/onion


HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=5 \
  CMD ["/app/bin/bash", "/app/run/lucid/tor/bin/tor-health.sh"]

EXPOSE 9050 9051 8888

USER 107
WORKDIR /app/tor

# no entrypoint.sh as command is recieved from docker-compose.foundation.yml
# ENTRYPOINT ["/opt/bin/tini", "--", "/run/lucid/tor/bin/entrypoint.sh"]
