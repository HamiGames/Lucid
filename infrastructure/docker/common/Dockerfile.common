# syntax=docker/dockerfile:1.5
# Lucid server-tools (distroless) — slimmer variant: scripts + MongoDB CLIs + bootstrap helpers.
# Build context: repository root (.)
# Dockerfile path: infrastructure/docker/common/Dockerfile.common
#
# Runtime env on Pi via compose: .env.foundation, .env.core, .env.support, .env.server-tools
# Layout: infrastructure/containers/host-config.yml → /app/configs/host-config.yml

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64

# -----------------------------------------------------------------------------
# Stage 1 — Builder
# -----------------------------------------------------------------------------
ARG TARGETARCH

FROM --platform=$TARGETPLATFORM debian:12-slim AS builder

