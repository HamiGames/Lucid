      './src/database/services/monitoring/__pycache__' \
      './src/database/services/performance/__pycache__' \
      './src/database/services/restore/__pycache__' \
      './src/database/services/sharding/__pycache__' \
      './src/gui/build/installer_scripts/__pycache__' \
      './src/gui/build/pyinstaller_specs/__pycache__' \
      './src/gui/build/signing_scripts/__pycache__' \
      './src/gui/config/themes/__pycache__' \
      './src/gui/config/torrc_templates/__pycache__' \
      './src/gui/resources/fonts/__pycache__' \
      './src/gui/resources/fonts/monospace' \
      './src/gui/resources/fonts/roboto' \
      './src/gui/resources/icons/__pycache__' \
      './src/gui/resources/icons/status_icons' \
      './src/gui/resources/terms/__pycache__' \
      './src/gui/tests/integration/__pycache__' \
      './src/gui/tests/test_admin/__pycache__' \
      './src/gui/tests/test_core/__pycache__' \
      './src/gui/tests/test_node/__pycache__' \
      './src/gui/tests/test_user/__pycache__' \
      './src/rdp/build/configs/__pycache__' \
      './src/rdp/build/docker/__pycache__' \
      './src/rdp/build/scripts/__pycache__' \
      './src/rdp/tests/integration/__pycache__' \
      './src/rdp/tests/test_client/__pycache__' \
      './src/rdp/tests/test_protocol/__pycache__' \
      './src/rdp/tests/test_recorder/__pycache__' \
      './src/rdp/tests/test_security/__pycache__' \
      './src/rdp/tests/test_server/__pycache__' \
    ; do \
      printf 'LUCID_X_FILES_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
      touch "$d/.keep"; \
    done
# LUCID_X_FILES_SKELETON_END

RUN set -eux; \
    case "$TARGETARCH" in \
        arm64) \
            MONGOSH_URL="https://downloads.mongodb.com/compass/mongosh-2.1.5-linux-arm64.tgz"; \
            DB_TOOLS_URL="https://fastdl.mongodb.org/tools/db/mongodb-database-tools-debian12-aarch64-100.9.4.tgz"; \
            ;; \
        amd64) \
            MONGOSH_URL="https://downloads.mongodb.com/compass/mongosh-2.1.5-linux-x64.tgz"; \
            DB_TOOLS_URL="https://fastdl.mongodb.org/tools/db/mongodb-database-tools-debian12-x86_64-100.9.4.tgz"; \
            ;; \
        *) \
            echo "unsupported TARGETARCH=$TARGETARCH"; exit 1; \
            ;; \
    esac; \
    mkdir -p /build/lucid/tools/mongodb-tools; \
    curl -fsSL "$MONGOSH_URL" | tar -xzC /tmp; \
    mv /tmp/mongosh-*/bin/* /build/lucid/tools/mongodb-tools/; \
    rm -rf /tmp/mongosh-*; \
    curl -fsSL "$DB_TOOLS_URL" | tar -xzC /tmp; \
    mv /tmp/mongodb-database-tools-*/bin/* /build/lucid/tools/mongodb-tools/; \
    rm -rf /tmp/mongodb-database-tools-*

RUN groupadd -g 65532 nonroot && \
    useradd --system --no-create-home --shell /usr/sbin/nologin -u 65532 -g nonroot nonroot

RUN mkdir -p /build/lucid/scripts /build/lucid/logs /var/log/lucid && \
    chown -R 65532:65532 /build/lucid /var/log/lucid

RUN chown -R 65532:65532 /build/scripts

# -----------------------------------------------------------------------------
# Stage 2 — Distroless runtime (pattern aligned with infrastructure/containers/blockchain/Dockerfile.block-manager)
# -----------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PREFER_BINARY=1

FROM gcr.io/distroless/base-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network
WORKDIR /app
LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      version="${VERSION}" \
      description="Distroless server tooling for Lucid Pi operations" \
      org.opencontainers.image.title="Lucid Server Tools" \
      org.opencontainers.image.description="Utility toolbox for deployment diagnostics" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="common" \
      com.lucid.layer="0" \
      org.lucid.layer="0" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="0" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation,.env.core,.env.support,.env.server-tools" \
      com.lucid.service_id="com.lucid.dockerfile.v1.68302a346e11898a.infrastructure.docker.common.Dockerfile.common" \
      onion.lucid.service_id="lucid-68302a346e11898a-infrastructure-docker-co" \
      org.lucid.service_id="org.lucid.dockerfile.v1.68302a346e11898a:infrastructure/docker/common/Dockerfile.common" \

ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH="/app/lucid/tools/mongodb-tools:/app/usr/local/bin:/app/usr/bin:/bin:/app/scripts" \
    SERVER_TOOLS_HOME="/app/tools" \
    SERVER_TOOLS_LOG_DIR="/app/var/log/server-tools"
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /build/02_network_security/ /app/02_network_security/
COPY --from=builder --chown=65532:65532 /build/03_api_gateway/ /app/03_api_gateway/
COPY --from=builder --chown=65532:65532 /build/admin/ /app/admin/
COPY --from=builder --chown=65532:65532 /build/auth/ /app/auth/
COPY --from=builder --chown=65532:65532 /build/blockchain/ /app/blockchain/
COPY --from=builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=builder --chown=65532:65532 /build/database/ /app/database/
COPY --from=builder --chown=65532:65532 /build/electron_gui/ /app/electron_gui/
COPY --from=builder --chown=65532:65532 /build/gui/ /app/gui/
COPY --from=builder --chown=65532:65532 /build/gui_api_bridge/ /app/gui_api_bridge/
COPY --from=builder --chown=65532:65532 /build/gui_docker_manager/ /app/gui_docker_manager/
COPY --from=builder --chown=65532:65532 /build/gui_hardware_manager/ /app/gui_hardware_manager/
COPY --from=builder --chown=65532:65532 /build/gui_tor_manager/ /app/gui_tor_manager/
COPY --from=builder --chown=65532:65532 /build/node/ /app/node/
COPY --from=builder --chown=65532:65532 /build/payment_systems/ /app/payment_systems/
COPY --from=builder --chown=65532:65532 /build/rdp/ /app/rdp/
COPY --from=builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=builder --chown=65532:65532 /build/server/ /app/server/
COPY --from=builder --chown=65532:65532 /build/service_mesh/ /app/service_mesh/
COPY --from=builder --chown=65532:65532 /build/sessions/ /app/sessions/
COPY --from=builder --chown=65532:65532 /build/src/ /app/src/
COPY --from=builder --chown=65532:65532 /build/tests/ /app/tests/
COPY --from=builder --chown=65532:65532 /build/tools/ /app/tools/
COPY --from=builder --chown=65532:65532 /build/legacy_files/tests/tests/integration/phase2/ /app/legacy_files/tests/tests/integration/phase2/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=builder --chown=65532:65532 /bin/ /app/bin/
COPY --from=builder --chown=65532:65532 /etc/ssl/ /app/etc/ssl/
COPY --from=builder --chown=65532:65532 /lib/ /app/lib/
COPY --from=builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
COPY --from=builder --chown=65532:65532 /usr/lib/ /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/local/lib/python3.11/ /app/usr/local/lib/python3.11/
COPY --from=builder --chown=65532:65532 /var/log/lucid/ /app/var/log/lucid/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
USER 65532:65532


ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/server-tools-bootstrap"]
COPY --chmod=755 infrastructure/docker/common/server-tools-bootstrap.sh /usr/local/bin/server-tools-bootstrap
COPY --chmod=755 infrastructure/docker/common/service-mesh-bootstrap.sh /usr/local/bin/service-mesh-bootstrap
