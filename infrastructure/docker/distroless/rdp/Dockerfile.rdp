      './src/gui/tests/test_user/__pycache__' \
      './src/rdp/build/configs/__pycache__' \
      './src/rdp/build/docker/__pycache__' \
      './src/rdp/build/scripts/__pycache__' \
      './src/rdp/tests/integration/__pycache__' \
      './src/rdp/tests/test_client/__pycache__' \
      './src/rdp/tests/test_protocol/__pycache__' \
      './src/rdp/tests/test_recorder/__pycache__' \
      './src/rdp/tests/test_security/__pycache__' \
      './src/rdp/tests/test_server/__pycache__' \
    ; do \
      printf 'LUCID_X_FILES_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
      touch "$d/.keep"; \
    done
# LUCID_X_FILES_SKELETON_END

# Non-root user used in runtime (distroless stage will copy passwd/group)
RUN useradd --system --create-home --shell /bin/bash lucid

# Lucid tooling tree under WORKDIR /build (aligned with /build → /app/lucid runtime copy)
RUN mkdir -p ./lucid/tools/mongodb-tools \
    && curl -fsSL --retry 5 --retry-connrefused "${MONGODB_TOOLS_URL}" -o "/tmp/${MONGODB_TOOLS_ARCHIVE}" \
    && tar -xzf "/tmp/${MONGODB_TOOLS_ARCHIVE}" -C ./lucid/tools/mongodb-tools --strip-components=1 \
    && rm -f "/tmp/${MONGODB_TOOLS_ARCHIVE}"

# Optional Python virtual environment warm-up (PEP 668 friendly)
RUN python3 -m venv ./lucid/tools/venv \
    && ./lucid/tools/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && ./lucid/tools/venv/bin/pip --version \
    && ./lucid/tools/venv/bin/python -m wheel version

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_PREFER_BINARY=1

FROM gcr.io/distroless/base-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

WORKDIR /app/lucid

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      version="${VERSION}" \
      description="Distroless RDP tooling image for Lucid Pi operations" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="Lucid RDP Service Tools" \
      org.opencontainers.image.description="Utility toolbox for Lucid RDP deployment diagnostics" \
      com.lucid.plane="ops" \
      com.lucid.service="rdp" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation,.env.core,.env.support,.env.rdp" \
      com.lucid.deployment.path="/mnt/myssd/Lucid/Lucid"

# =============================================================================
# ENVIRONMENT VARIABLES - MINIMAL DEFAULTS ONLY
# All connection and API variables are injected via Pi-side .env files.
# ============================================================================= \
      com.lucid.service_id="com.lucid.dockerfile.v1.b3fd7496b0afd757.infrastructure.docker.distroless.rdp.Dockerfile.rdp" \
      onion.lucid.service_id="lucid-b3fd7496b0afd757-infrastructure-docker-di" \
      org.lucid.service_id="org.lucid.dockerfile.v1.b3fd7496b0afd757:infrastructure/docker/distroless/rdp/Dockerfile.rdp" \
ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH=/app/lucid/scripts:/app/lucid/tools/venv/bin:/usr/local/bin:/usr/bin:/bin \
    RDP_SERVICE_HOME=/app/lucid \
    RDP_LOG_DIR=/app/lucid/logs
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /build/02_network_security/ /app/02_network_security/
COPY --from=builder --chown=65532:65532 /build/03_api_gateway/ /app/03_api_gateway/
COPY --from=builder --chown=65532:65532 /build/06-orchestration-runtime/ /app/06-orchestration-runtime/
COPY --from=builder --chown=65532:65532 /build/08-quality/ /app/08-quality/
COPY --from=builder --chown=65532:65532 /build/admin/ /app/admin/
COPY --from=builder --chown=65532:65532 /build/api/ /app/api/
COPY --from=builder --chown=65532:65532 /build/app/ /app/app/
COPY --from=builder --chown=65532:65532 /build/apps/ /app/apps/
COPY --from=builder --chown=65532:65532 /build/auth/ /app/auth/
COPY --from=builder --chown=65532:65532 /build/blockchain/ /app/blockchain/
COPY --from=builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=builder --chown=65532:65532 /build/compose/ /app/compose/
COPY --from=builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=builder --chown=65532:65532 /build/core/ /app/core/
COPY --from=builder --chown=65532:65532 /build/database/ /app/database/
COPY --from=builder --chown=65532:65532 /build/electron_gui/ /app/electron_gui/
COPY --from=builder --chown=65532:65532 /build/gui/ /app/gui/
COPY --from=builder --chown=65532:65532 /build/gui_docker_manager/ /app/gui_docker_manager/
COPY --from=builder --chown=65532:65532 /build/node/ /app/node/
COPY --from=builder --chown=65532:65532 /build/ops/ /app/ops/
COPY --from=builder --chown=65532:65532 /build/payment_systems/ /app/payment_systems/
COPY --from=builder --chown=65532:65532 /build/rdp/ /app/rdp/
COPY --from=builder --chown=65532:65532 /build/reports/ /app/reports/
COPY --from=builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=builder --chown=65532:65532 /build/service_configs/ /app/service_configs/
COPY --from=builder --chown=65532:65532 /build/service_mesh/ /app/service_mesh/
COPY --from=builder --chown=65532:65532 /build/sessions/ /app/sessions/
COPY --from=builder --chown=65532:65532 /build/src/ /app/src/
COPY --from=builder --chown=65532:65532 /build/tests/ /app/tests/
COPY --from=builder --chown=65532:65532 /build/tools/ /app/tools/
COPY --from=builder --chown=65532:65532 /build/user/ /app/user/
COPY --from=builder --chown=65532:65532 /build/user_content/ /app/user_content/
COPY --from=builder --chown=65532:65532 /build/vm/ /app/vm/
COPY --from=builder --chown=65532:65532 /build/wallet/ /app/wallet/
COPY --from=builder --chown=65532:65532 /build/legacy_files/tests/tests/integration/phase3/ /app/legacy_files/tests/tests/integration/phase3/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=builder --chown=lucid:lucid /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=builder --chown=lucid:lucid /bin/ /app/bin/
COPY --from=builder --chown=lucid:lucid /etc/ssl/ /app/etc/ssl/
COPY --from=builder --chown=lucid:lucid /usr/bin/ /app/usr/bin/
COPY --from=builder --chown=lucid:lucid /usr/lib/python3.11/ /app/usr/lib/python3.11/
COPY --from=builder --chown=lucid:lucid /usr/lib/python3/dist-packages/ /app/usr/lib/python3/dist-packages/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).

USER lucid:lucid

# No ports exposed by default; compose on the Pi defines exposure and environment.
CMD ["/bin/bash", "-c", "echo 'Lucid RDP tools ready. Configure via Pi .env files.' && tail -f /dev/null"]

# -----------------------------------------------------------------------------
# Runtime configuration notes
# -----------------------------------------------------------------------------
# - All RDP connection values (endpoints, credentials, ports) originate from
#   docker-compose env_file entries on the Pi console (.env.rdp and peers).
# - This Dockerfile contains no inline configuration; compose handles runtime
#   networking, volumes, and service orchestration within the Lucid project.
