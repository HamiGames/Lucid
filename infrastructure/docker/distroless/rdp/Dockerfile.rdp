# configs/docker/distroless/rdp/Dockerfile.rdp
# -----------------------------------------------------------------------------
# LUCID RDP SERVICE TOOLING - SPEC-1B Implementation
# Distroless utility toolbox for RDP operations, configurable via Pi-side .env files
# Build context: project root
#
# Configuration is provided at runtime via .env files on the Pi console:
#   /app/configs/.env.foundation
#   /app/configs/.env.core
#   /app/configs/.env.support
#   /app/configs/.env.rdp
#
# Layout registry: infrastructure/containers/host-config.yml → canonical runtime /app/configs/host-config.yml
# Service config root: infrastructure/containers/services/container-runtime-layout.yml (lucid_services_config_root: /app/service_configs)
# Path equivalences: x-files-listing.txt (repository root)
# -----------------------------------------------------------------------------

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG MONGODB_TOOLS_VERSION=100.9.4
ARG MONGODB_TOOLS_ARCHIVE="mongodb-database-tools-ubuntu2204-arm64-${MONGODB_TOOLS_VERSION}.tgz"
ARG MONGODB_TOOLS_URL="https://fastdl.mongodb.org/tools/db/${MONGODB_TOOLS_ARCHIVE}"

# =============================================================================
# Stage 1: Builder – install diagnostic tooling
# =============================================================================
FROM debian:12-slim AS builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG MONGODB_TOOLS_VERSION
ARG MONGODB_TOOLS_ARCHIVE
ARG MONGODB_TOOLS_URL

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_PREFER_BINARY=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        bash \
        curl \
        wget \
        jq \
        python3.11 \
        python3-venv \
        python3-pip \
        python3.11-setuptools \
        python3.11-wheel \
        python3.11-dev \
        dnsutils \
        iputils-ping \
        inetutils-traceroute \
        netcat-openbsd \
        socat \
        nmap \
        tcpdump \
        iperf3 \
        openssl \
        ca-certificates \
        gnupg \
        htop \
        procps \
        lsof \
        strace \
        rsync \
        unzip \
        tar \
        gzip \
        git \
        vim \
        nano \
        tree \
        util-linux \
        gosu \
        yq \
    && curl -fsSL https://pgp.mongodb.com/server-7.0.asc | gpg --dearmor -o /usr/share/keyrings/mongodb-org-7.0.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/mongodb-org-7.0.gpg] https://repo.mongodb.org/apt/debian bookworm/mongodb-org/7.0 main" \
         > /etc/apt/sources.list.d/mongodb-org-7.0.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends mongodb-mongosh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; overlaps with builder mkdir/.keep removed — see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib/python3/dist-packages'; \
  for d in \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib/python3/dist-packages'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END


RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    python3 -m pip install --break-system-packages --upgrade pip setuptools wheel && \
    python3 -m pip --version && \
    python3 -m wheel version

# Non-root user used in runtime (distroless stage will copy passwd/group)
RUN useradd --system --create-home --shell /bin/bash lucid

# Lucid tooling tree under WORKDIR /build (aligned with /build → /app/lucid runtime copy)
WORKDIR /build

# Fetch MongoDB Database Tools tarball (arm64) and stage for distroless copy
RUN mkdir -p ./lucid/tools/mongodb-tools \
    && curl -fsSL --retry 5 --retry-connrefused "${MONGODB_TOOLS_URL}" -o "/tmp/${MONGODB_TOOLS_ARCHIVE}" \
    && tar -xzf "/tmp/${MONGODB_TOOLS_ARCHIVE}" -C ./lucid/tools/mongodb-tools --strip-components=1 \
    && rm -f "/tmp/${MONGODB_TOOLS_ARCHIVE}"

# Optional Python virtual environment warm-up (PEP 668 friendly)
RUN python3 -m venv ./lucid/tools/venv \
    && ./lucid/tools/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && ./lucid/tools/venv/bin/pip --version \
    && ./lucid/tools/venv/bin/python -m wheel version

RUN mkdir -p ./lucid/scripts ./lucid/logs \
    && chown -R lucid:lucid ./lucid \
    && chmod -R 755 ./lucid/scripts
# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_BEGIN
# alignment-mat rdp_manifest.json: compose_service='rdp' — manifest py/yml/yaml/json → builder COPY (#10).
# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
RUN set -eux; \
    mkdir -p '.' './common' './configs' './scripts' './service_configs' './common/__pycache__' './common/governance' './common/security' './common/server-tools' './common/templates' './common/tor' './configs/.ssh' './configs/alignment-mats' './configs/container' './configs/database' './configs/docker' './configs/env' './configs/environment' './configs/gui-alignment' './configs/integration' './configs/kubernetes' './configs/logging' './configs/pi' './configs/secrets' './configs/security' './configs/tor' './scripts/__pycache__' './scripts/auth_sm_realignment' './scripts/build' './scripts/compliance' './scripts/config' './scripts/contracts' './scripts/database' './scripts/deployment' './scripts/devcontainer' './scripts/docs' './scripts/foundation' './scripts/gui' './scripts/gui_auth_realignment' './scripts/hardware' './scripts/integration' './scripts/lib' './scripts/load' './scripts/logging' './scripts/maintenance' './scripts/migration' './scripts/monitoring' './scripts/network' './scripts/re-build' './scripts/registry' './scripts/secrets' './scripts/security' './scripts/services' './scripts/testing' './scripts/validation' './scripts/verification' './common/governance/__pycache__' './common/security/__pycache__' './common/server-tools/__pycache__' './common/tor/__pycache__' './configs/container/admin' './configs/container/auth' './configs/container/base' './configs/container/blockchain' './configs/container/database' './configs/container/electron_gui' './configs/container/gui' './configs/container/node' './configs/container/payment_systems' './configs/container/rdp' './configs/container/server' './configs/container/sessions' './configs/container/storage' './configs/container/tor' './configs/database/elasticsearch' './configs/database/redis' './configs/docker/distroless' './configs/docker/docs' './configs/docker/multi-stage' './configs/environment/development' './configs/environment/pi' './configs/environment/production' './configs/environment/staging' './configs/pi/ssh' './configs/secrets/runtime' './scripts/auth_sm_realignment/.cache' './scripts/auth_sm_realignment/lib' './scripts/build/__pycache__' './scripts/build/components' './scripts/build/core' './scripts/build/distroless' './scripts/build/utils' './scripts/compliance/distroless' './scripts/compliance/general' './scripts/deployment/devcontainer' './scripts/deployment/distroless' './scripts/deployment/pi' './scripts/deployment/utils' './scripts/gui_auth_realignment/.cache' './scripts/gui_auth_realignment/lib' './scripts/maintenance/cleanup' './scripts/maintenance/optimization' './scripts/maintenance/recovery' './scripts/network/diagnostics' './scripts/network/security' './scripts/network/setup' './scripts/testing/integration' './scripts/testing/unit' './scripts/testing/utils' './scripts/validation/__pycache__' './scripts/verification/__pycache__' './configs/secrets/runtime/compose'; \
    for d in \
      '.' \
      './common' \
      './configs' \
      './scripts' \
      './service_configs' \
      './common/__pycache__' \
      './common/governance' \
      './common/security' \
      './common/server-tools' \
      './common/templates' \
      './common/tor' \
      './configs/.ssh' \
      './configs/alignment-mats' \
      './configs/container' \
      './configs/database' \
      './configs/docker' \
      './configs/env' \
      './configs/environment' \
      './configs/gui-alignment' \
      './configs/integration' \
      './configs/kubernetes' \
      './configs/logging' \
      './configs/pi' \
      './configs/secrets' \
      './configs/security' \
      './configs/tor' \
      './scripts/__pycache__' \
      './scripts/auth_sm_realignment' \
      './scripts/build' \
      './scripts/compliance' \
      './scripts/config' \
      './scripts/contracts' \
      './scripts/database' \
      './scripts/deployment' \
      './scripts/devcontainer' \
      './scripts/docs' \
      './scripts/foundation' \
      './scripts/gui' \
      './scripts/gui_auth_realignment' \
      './scripts/hardware' \
      './scripts/integration' \
      './scripts/lib' \
      './scripts/load' \
      './scripts/logging' \
      './scripts/maintenance' \
      './scripts/migration' \
      './scripts/monitoring' \
      './scripts/network' \
      './scripts/re-build' \
      './scripts/registry' \
      './scripts/secrets' \
      './scripts/security' \
      './scripts/services' \
      './scripts/testing' \
      './scripts/validation' \
      './scripts/verification' \
      './common/governance/__pycache__' \
      './common/security/__pycache__' \
      './common/server-tools/__pycache__' \
      './common/tor/__pycache__' \
      './configs/container/admin' \
      './configs/container/auth' \
      './configs/container/base' \
      './configs/container/blockchain' \
      './configs/container/database' \
      './configs/container/electron_gui' \
      './configs/container/gui' \
      './configs/container/node' \
      './configs/container/payment_systems' \
      './configs/container/rdp' \
      './configs/container/server' \
      './configs/container/sessions' \
      './configs/container/storage' \
      './configs/container/tor' \
      './configs/database/elasticsearch' \
      './configs/database/redis' \
      './configs/docker/distroless' \
      './configs/docker/docs' \
      './configs/docker/multi-stage' \
      './configs/environment/development' \
      './configs/environment/pi' \
      './configs/environment/production' \
      './configs/environment/staging' \
      './configs/pi/ssh' \
      './configs/secrets/runtime' \
      './scripts/auth_sm_realignment/.cache' \
      './scripts/auth_sm_realignment/lib' \
      './scripts/build/__pycache__' \
      './scripts/build/components' \
      './scripts/build/core' \
      './scripts/build/distroless' \
      './scripts/build/utils' \
      './scripts/compliance/distroless' \
      './scripts/compliance/general' \
      './scripts/deployment/devcontainer' \
      './scripts/deployment/distroless' \
      './scripts/deployment/pi' \
      './scripts/deployment/utils' \
      './scripts/gui_auth_realignment/.cache' \
      './scripts/gui_auth_realignment/lib' \
      './scripts/maintenance/cleanup' \
      './scripts/maintenance/optimization' \
      './scripts/maintenance/recovery' \
      './scripts/network/diagnostics' \
      './scripts/network/security' \
      './scripts/network/setup' \
      './scripts/testing/integration' \
      './scripts/testing/unit' \
      './scripts/testing/utils' \
      './scripts/validation/__pycache__' \
      './scripts/verification/__pycache__' \
      './configs/secrets/runtime/compose' \
    ; do \
      printf 'LUCID_X_FILES_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
      touch "$d/.keep"; \
    done
# LUCID_X_FILES_SKELETON_END
COPY common/ ./common/
COPY configs/ ./configs/
COPY infrastructure/containers/ ./infrastructure/containers/
# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_END
COPY scripts/ ./scripts/

# =============================================================================
# Stage 2: Distroless runtime
# =============================================================================
FROM gcr.io/distroless/base-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      version="${VERSION}" \
      description="Distroless RDP tooling image for Lucid Pi operations" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="Lucid RDP Service Tools" \
      org.opencontainers.image.description="Utility toolbox for Lucid RDP deployment diagnostics" \
      com.lucid.plane="ops" \
      com.lucid.service="rdp" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation,.env.core,.env.support,.env.rdp" \
      com.lucid.deployment.path="/mnt/myssd/Lucid/Lucid"

# =============================================================================
# ENVIRONMENT VARIABLES - MINIMAL DEFAULTS ONLY
# All connection and API variables are injected via Pi-side .env files.
# ============================================================================= \
      com.lucid.service_id="com.lucid.dockerfile.v1.b3fd7496b0afd757.infrastructure.docker.distroless.rdp.Dockerfile.rdp" \
      onion.lucid.service_id="lucid-b3fd7496b0afd757-infrastructure-docker-di" \
      org.lucid.service_id="org.lucid.dockerfile.v1.b3fd7496b0afd757:infrastructure/docker/distroless/rdp/Dockerfile.rdp" \
ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH=/app/lucid/scripts:/app/lucid/tools/venv/bin:/usr/local/bin:/usr/bin:/bin \
    RDP_SERVICE_HOME=/app/lucid \
    RDP_LOG_DIR=/app/lucid/logs
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=builder --chown=65532:65532 /build/service_configs/ /app/service_configs/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=builder --chown=lucid:lucid /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=builder --chown=lucid:lucid /bin/ /app/bin/
COPY --from=builder --chown=lucid:lucid /etc/ssl/ /app/etc/ssl/
COPY --from=builder --chown=lucid:lucid /usr/bin/ /app/usr/bin/
COPY --from=builder --chown=lucid:lucid /usr/lib/python3/dist-packages/ /app/usr/lib/python3/dist-packages/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END

COPY --from=builder --chown=lucid:lucid /build/lucid/ /app/lucid/

COPY --from=builder /bin/bash /bin/bash
COPY --from=builder /usr/bin /usr/bin
COPY --from=builder /usr/lib /usr/lib
COPY --from=builder /lib /lib
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

WORKDIR /app/lucid

USER lucid:lucid

# No ports exposed by default; compose on the Pi defines exposure and environment.
CMD ["/bin/bash", "-c", "echo 'Lucid RDP tools ready. Configure via Pi .env files.' && tail -f /dev/null"]

# -----------------------------------------------------------------------------
# Runtime configuration notes
# -----------------------------------------------------------------------------
# - All RDP connection values (endpoints, credentials, ports) originate from
#   docker-compose env_file entries on the Pi console (.env.rdp and peers).
# - This Dockerfile contains no inline configuration; compose handles runtime
#   networking, volumes, and service orchestration within the Lucid project.
