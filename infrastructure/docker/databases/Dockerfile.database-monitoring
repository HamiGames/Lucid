ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG PYTHON_VERSION=3.11

############################
# Stage 1 – Builder
############################
FROM --platform=$TARGETPLATFORM python:3.11-slim-bookworm AS builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG PYTHON_VERSION

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PREFER_BINARY=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /build

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
        pkg-config \
        curl \
        ca-certificates \
        tini \
        bash \
        python3.11-wheel \
        python3.11-dev \
        python3.11-pip \
        python3.11-setuptools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; overlaps with builder mkdir/.keep removed — see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/bin' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/sbin' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/local/lib/python3.11/site-packages'; \
  for d in \
    '/bin' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/sbin' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/local/lib/python3.11/site-packages'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END


RUN printf "LUCID_DB_MONITORING_RUNTIME" > /var/run/.keep && \
    printf "LUCID_DB_MONITORING_LIB" > /var/lib/.keep && \
    chown -R 65532:65532 /var/run /var/lib && \
    chmod 644 /var/run/.keep /var/lib/.keep

RUN mkdir -p /usr/local/lib/python3.11/site-packages /usr/local/bin && \
    chown -R 65532:65532 /usr/local/lib/python3.11/site-packages /usr/local/bin

RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    pip install --upgrade pip setuptools wheel && \
    pip --version && \
    /app/usr/bin/python3.11 -m wheel version

COPY database/services/monitoring/requirements-monitoring.txt ./requirements.txt
RUN sed -i \
    '/^pytest/d;/^black/d;/^ruff/d;/^mypy/d;/httpx\[cli\]/d;/^pandas/d;/^numpy/d' \
    ./requirements.txt || true
RUN printf '\nredis>=5.0.0\n' >> ./requirements.txt
RUN /app/usr/bin/python3.11 -m pip wheel --no-cache-dir --wheel-dir /build/wheels -r ./requirements.txt
