COPY database/services/monitoring/requirements-monitoring.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    pip install --upgrade pip setuptools wheel && \
    pip --version && \
    python3.11 -m wheel version

RUN python3.11 -m pip wheel --no-cache-dir --wheel-dir /build/wheels -r ./requirements.txt
