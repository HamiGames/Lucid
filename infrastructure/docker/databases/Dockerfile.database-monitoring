RUN printf "LUCID_DB_MONITORING_RUNTIME" > /var/run/.keep && \
    printf "LUCID_DB_MONITORING_LIB" > /var/lib/.keep && \
    chown -R 65532:65532 /var/run /var/lib && \
    chmod 644 /var/run/.keep /var/lib/.keep

RUN mkdir -p /usr/local/lib/python3.11/site-packages /usr/local/bin && \
    chown -R 65532:65532 /usr/local/lib/python3.11/site-packages /usr/local/bin

RUN sed -i \
    '/^pytest/d;/^black/d;/^ruff/d;/^mypy/d;/httpx\[cli\]/d;/^pandas/d;/^numpy/d' \
    ./requirements.txt || true
RUN printf '\nredis>=5.0.0\n' >> ./requirements.txt
RUN rm -rf configs/environment 2>/dev/null || true

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PREFER_BINARY=1 \
    DEBIAN_FRONTEND=noninteractive

FROM --platform=$TARGETPLATFORM gcr.io/distroless/python3-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

WORKDIR /app

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Database Monitoring" \
      org.opencontainers.image.description="MongoDB-oriented monitoring service (host-config mongodb-monitoring)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="database-monitoring" \
      com.lucid.layer="0" \
      org.lucid.layer="0" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="27020" \
      com.lucid.cluster="foundation" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.tunnel-tools,.env.foundation" \
      com.lucid.service_id="com.lucid.dockerfile.v1.c1584c59510bc35b.infrastructure.docker.databases.Dockerfile.database-monitoring" \
      onion.lucid.service_id="lucid-c1584c59510bc35b-infrastructure-docker-da" \
      org.lucid.service_id="org.lucid.dockerfile.v1.c1584c59510bc35b:infrastructure/docker/databases/Dockerfile.database-monitoring" \

ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH=/app/usr/local/bin:/app/usr/bin:/app/bin:$PATH \
    PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONPATH="/app:/app/usr/local/lib/python3.11/site-packages" \
    PYTHONIOENCODING="utf-8" \
    LANG="C.UTF-8" \
    LC_ALL="C.UTF-8" \
    API_GATEWAY_HOST="api-gateway" \
    API_GATEWAY_PORT="27020" \
    LUCID_HOST_CONFIG_PATH="/app/configs/host-config.yml" \
    LUCID_SERVICES_CONFIG_ROOT="/app/service_configs" \
    DATABASE_MONITORING_SERVICE_NAME="database-monitoring" \
    DATABASE_MONITORING_SERVICE_PORT="27020" \
    DATABASE_MONITORING_METRICS_PORT="27020" \
    DATABASE_MONITORING_METRICS_PATH="/metrics" \
    DATABASE_MONITORING_PROMETHEUS_ENABLED="true" \
    DATABASE_MONITORING_GRAFANA_ENABLED="false" \
    DATABASE_MONITORING_HEALTH_CHECK_ENABLED="true" \
    DATABASE_MONITORING_HEALTH_CHECK_INTERVAL="30" \
    DATABASE_MONITORING_HEALTH_CHECK_TIMEOUT="10" \
    DATABASE_MONITORING_HEALTH_CHECK_RETRIES="3"
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=builder --chown=65532:65532 /build/configs/ /app/configs/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=builder --chown=65532:65532 /usr/lib/*/libffi.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/libssl.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/ossl-modules/ /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /bin/ /app/bin/
COPY --from=builder --chown=65532:65532 /etc/ssl/ /app/etc/ssl/
COPY --from=builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
COPY --from=builder --chown=65532:65532 /usr/local/bin/ /app/usr/local/bin/
COPY --from=builder --chown=65532:65532 /usr/local/lib/python3.11/site-packages/ /app/usr/local/lib/python3.11/site-packages/
COPY --from=builder --chown=65532:65532 /usr/sbin/ /app/usr/sbin/
COPY --from=builder --chown=65532:65532 /var/lib/ /app/var/lib/
COPY --from=builder --chown=65532:65532 /var/run/ /app/var/run/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=builder --chown=65532:65532 /build/wheels/ /app/wheels/

RUN ["/app/usr/bin/python3.11", "-c", \
    "import os, sys; sys.path.insert(0, '/app/usr/local/lib/python3.11/site-packages'); \
     assert os.path.isfile('/app/configs/host-config.yml'); \
     assert os.path.isfile('/app/infrastructure/containers/services/container-runtime-layout.yml'); \
     assert os.path.isfile('/app/infrastructure/containers/services/kubernetes/database-config.yaml'); \
     import pymongo, motor, redis; \
     print('database-monitoring runtime ok')"]

EXPOSE 27020 9216

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["/app/usr/bin/python3.11", "-c", \
    "import urllib.request; urllib.request.urlopen('http://mongodb-monitoring:27020/health', timeout=5).read()"]

USER 65532:65532

COPY --from=builder --chown=65532:65532 /usr/bin/tini /app/bin/tini

ENTRYPOINT ["/app/bin/tini", "--"]

CMD ["/app/usr/bin/python3.11", "-m", "database.services.monitoring.main"]
