# LUCID RDP VM Manager - Virtual Machine Orchestration
# SPEC-4 Compliant: VM lifecycle management, resource allocation, isolation
#
# Layout registry: infrastructure/containers/host-config.yml → canonical runtime /app/configs/host-config.yml
# Service config root: infrastructure/containers/services/container-runtime-layout.yml (lucid_services_config_root: /app/service_configs)
# Path equivalences: x-files-listing.txt (repository root)

FROM python:3.11-slim-bookworm AS builder

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

WORKDIR /build

# Install VM management tools
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
      build-essential \
      gcc \
      g++ \
      libffi-dev \
      libssl-dev \
      pkg-config \
      curl \
      python3.11-dev \
      python3.11-pip \
      python3.11-setuptools \
      python3.11-wheel \
      ca-certificates \
      tini \
      bash \
      jq \
      netcat-openbsd \
      socat \
      xxd \
      rustc \
      cargo \
      libvirt-daemon-system \
      libvirt-clients \
      bridge-utils \
      virt-manager \
      cloud-image-utils \
      genisoimage \
      python3.11-libvirt \
      python3.11-requests \
      python3.11-yaml \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; overlaps with builder mkdir/.keep removed — see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib'; \
  for d in \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END




RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    pip install --no-cache-dir --no-index --find-links /build/wheels --upgrade pip setuptools wheel && \
    printf "LUCID_VM_WHEELS_$(date +%s)" > /build/wheels/.keep && \
    pip install -r ./requirements.vm.txt && \
# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
