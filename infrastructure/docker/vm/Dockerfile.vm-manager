# LUCID RDP VM Manager - Virtual Machine Orchestration
# SPEC-4 Compliant: VM lifecycle management, resource allocation, isolation
#
# Layout registry: infrastructure/containers/host-config.yml → canonical runtime /app/configs/host-config.yml
# Service config root: infrastructure/containers/services/container-runtime-layout.yml (lucid_services_config_root: /app/service_configs)
# Path equivalences: x-files-listing.txt (repository root)

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

# Install VM management tools
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
      build-essential \
      gcc \
      g++ \
      libffi-dev \
      libssl-dev \
      pkg-config \
      curl \
      python3.11-dev \
      python3.11-pip \
      python3.11-setuptools \
      python3.11-wheel \
      ca-certificates \
      tini \
      bash \
      jq \
      netcat-openbsd \
      socat \
      xxd \
      rustc \
      cargo \
      libvirt-daemon-system \
      libvirt-clients \
      bridge-utils \
      virt-manager \
      cloud-image-utils \
      genisoimage \
      python3.11-libvirt \
      python3.11-requests \
      python3.11-yaml \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; overlaps with builder mkdir/.keep removed — see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib'; \
  for d in \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END




RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    pip install --no-cache-dir --no-index --find-links /build/wheels --upgrade pip setuptools wheel && \
    printf "LUCID_VM_WHEELS_$(date +%s)" > /build/wheels/.keep && \
    pip install -r ./requirements.vm.txt && \
# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_BEGIN
# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
RUN set -eux; \
    mkdir -p '.' './common' './configs' './vm' './common/__pycache__' './common/governance' './common/security' './common/server-tools' './common/templates' './common/tor' './configs/.ssh' './configs/container' './configs/database' './configs/docker' './configs/env' './configs/environment' './configs/integration' './configs/kubernetes' './configs/logging' './configs/pi' './configs/secrets' './configs/security' './configs/tor' './vm/__pycache__' './common/governance/__pycache__' './common/security/__pycache__' './common/server-tools/__pycache__' './common/tor/__pycache__' './configs/container/admin' './configs/container/auth' './configs/container/base' './configs/container/blockchain' './configs/container/database' './configs/container/electron_gui' './configs/container/gui' './configs/container/node' './configs/container/payment_systems' './configs/container/rdp' './configs/container/server' './configs/container/sessions' './configs/container/storage' './configs/container/tor' './configs/database/elasticsearch' './configs/database/redis' './configs/docker/distroless' './configs/docker/docs' './configs/docker/multi-stage' './configs/pi/ssh'; \
    for d in \
      '.' \
      './common' \
      './configs' \
      './vm' \
      './common/__pycache__' \
      './common/governance' \
      './common/security' \
      './common/server-tools' \
      './common/templates' \
      './common/tor' \
      './configs/.ssh' \
      './configs/container' \
      './configs/database' \
      './configs/docker' \
      './configs/env' \
      './configs/environment' \
      './configs/integration' \
      './configs/kubernetes' \
      './configs/logging' \
      './configs/pi' \
      './configs/secrets' \
      './configs/security' \
      './configs/tor' \
      './vm/__pycache__' \
      './common/governance/__pycache__' \
      './common/security/__pycache__' \
      './common/server-tools/__pycache__' \
      './common/tor/__pycache__' \
      './configs/container/admin' \
      './configs/container/auth' \
      './configs/container/base' \
      './configs/container/blockchain' \
      './configs/container/database' \
      './configs/container/electron_gui' \
      './configs/container/gui' \
      './configs/container/node' \
      './configs/container/payment_systems' \
      './configs/container/rdp' \
      './configs/container/server' \
      './configs/container/sessions' \
      './configs/container/storage' \
      './configs/container/tor' \
      './configs/database/elasticsearch' \
      './configs/database/redis' \
      './configs/docker/distroless' \
      './configs/docker/docs' \
      './configs/docker/multi-stage' \
      './configs/pi/ssh' \
    ; do \
      printf 'LUCID_X_FILES_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
      touch "$d/.keep"; \
    done
# LUCID_X_FILES_SKELETON_END
# alignment-mat vm-manager_manifest.json: compose_service='vm-manager' — explicit manifest paths → 32 builder COPY line(s) (dockerfile_layout_structure.json section #10 COPY_DIRECTORIES).
COPY _gen_host_config.py ./_gen_host_config.py
COPY common/__init__.py ./common/__init__.py
COPY common/contact_profile_env.py ./common/contact_profile_env.py
COPY common/governance/__init__.py ./common/governance/__init__.py
COPY common/governance/lucid_governor.py ./common/governance/lucid_governor.py
COPY common/governance/param_registry.py ./common/governance/param_registry.py
COPY common/governance/timelock.py ./common/governance/timelock.py
COPY common/load_host_config.py ./common/load_host_config.py
COPY common/security/__init__.py ./common/security/__init__.py
COPY common/security/input_controller.py ./common/security/input_controller.py
COPY common/security/policy_validator.py ./common/security/policy_validator.py
COPY common/security/privacy_shield.py ./common/security/privacy_shield.py
COPY common/security/session_validator.py ./common/security/session_validator.py
COPY common/security/trust_nothing_engine.py ./common/security/trust_nothing_engine.py
COPY common/server-tools/__init__.py ./common/server-tools/__init__.py
COPY common/tor/__init__.py ./common/tor/__init__.py
COPY common/tor/onion_service.py ./common/tor/onion_service.py
COPY common/tor/socks_proxy.py ./common/tor/socks_proxy.py
COPY common/tor/tor_manager.py ./common/tor/tor_manager.py
COPY configs/x-files.json ./configs/x-files.json
COPY infrastructure/containers/config-listings.json ./infrastructure/containers/config-listings.json
COPY infrastructure/containers/dockerfile_recalibration_map.json ./infrastructure/containers/dockerfile_recalibration_map.json
COPY infrastructure/containers/dockerfile_recalibration_map_REPAIRED.json ./infrastructure/containers/dockerfile_recalibration_map_REPAIRED.json
COPY infrastructure/containers/host-config.yml ./infrastructure/containers/host-config.yml
COPY infrastructure/containers/services/middle-ware/master-endpoint.yml ./infrastructure/containers/services/middle-ware/master-endpoint.yml
COPY infrastructure/containers/services/vm/vm-manager.yml ./infrastructure/containers/services/vm/vm-manager.yml
COPY infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.json ./infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.json
COPY infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml ./infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml
COPY infrastructure/containers/services/x_lucid_cluster_calibration/application-cluster-host-alignment.yml ./infrastructure/containers/services/x_lucid_cluster_calibration/application-cluster-host-alignment.yml
COPY vm/__init__.py ./vm/__init__.py
COPY vm/main.py ./vm/main.py
COPY vm/vm_manager.py ./vm/vm_manager.py
# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_END

COPY vm/ ./vm/



# Create VM data directory
COPY <<EOF /etc/lucid/vm-manager.conf
[global]
vm_data_dir = /app/data/vm
template_dir = /app/data/vm/templates
instance_dir = /app/data/vm/instances
image_dir = /app/data/vm/images

[resource_limits]
max_vms = 10
default_memory = 2048
default_cpus = 2
max_memory_per_vm = 8192
max_cpus_per_vm = 8

[networking]
bridge_name = br-lucid
subnet = 192.168.100.0/24
gateway = 192.168.100.1

[security]
isolate_vms = true
enable_sandboxing = true
require_approval = false
EOF
RUN rm -rf configs/environment 2>/dev/null || true


RUN mkdir -p ./data/vm/{templates,instances,images}
RUN chmod 755 ./data/vm

# VM management configuration
FROM gcr.io/distroless/python3-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

WORKDIR /app

LABEL maintainer="Lucid Development Team" \
      org.opencontainers.image.title="Lucid VM Manager" \
      org.opencontainers.image.description="Distroless VM Manager for Lucid project" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="vm-manager" \
      com.lucid.layer="3" \
      com.lucid.expose="8285" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation" \
      com.lucid.service_id="com.lucid.dockerfile.v1.4c55d8feaf895eae.infrastructure.docker.vm.Dockerfile.vm-manager" \
      onion.lucid.service_id="lucid-4c55d8feaf895eae-infrastructure-docker-vm" \
      org.lucid.service_id="org.lucid.dockerfile.v1.4c55d8feaf895eae:infrastructure/docker/vm/Dockerfile.vm-manager" \

ENV PATH=/app/usr/local/bin:/app/usr/bin:/app/bin:$PATH \
    PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONPATH="/app:/app/usr/local/lib/python3.11/site-packages" \
    PYTHONIOENCODING="utf-8" \
    LANG="C.UTF-8" \
    LC_ALL="C.UTF-8" \
    VM_MANAGER_HOST="vm-manager" \
    VM_MANAGER_PORT="8285"
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=builder --chown=65532:65532 /build/vm/ /app/vm/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=builder --chown=65532:65532 /usr/lib/*/libffi.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/libssl.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/ossl-modules/ /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /bin/ /app/bin/
COPY --from=builder --chown=65532:65532 /dev/null/ /app/dev/null/
COPY --from=builder --chown=65532:65532 /etc/ssl/ /app/etc/ssl/
COPY --from=builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=base /build/wheels /app/wheels
COPY --from=base /build/app /app/app
COPY --from=base /build/configs /app/configs
COPY --from=base /build/vm /app/vm
COPY --from=base /build/gui_hardware_manager /app/gui_hardware_manager
COPY --from=base /build/service_manager /app/service_manager


# Health check
EXPOSE 8285

# Entry point
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["/app/usr/bin/python3.11", "-c", "import libvirt; conn = libvirt.open('qemu:///system'); conn.close()"]

# Expose VM management API
CMD ["/app/usr/bin/python3.11", "-m", "vm.vm_manager"]
