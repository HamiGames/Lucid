# File: infrastructure/docker/wallet/Dockerfile.role-manager
# Operational alignment: infrastructure/containers/tor/Dockerfile.tor-proxy-02 (repo-root context, LUCID_* / PUBLIC_TOR_IP, /app/bin/tini).
# LUCID ROLE MANAGER - SPEC-1C Role-Based Access Control (Distroless)
#
# Layout registry: infrastructure/containers/host-config.yml → canonical runtime /app/configs/host-config.yml

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

FROM --platform=$TARGETPLATFORM python:3.11-slim-bookworm AS role-manager-builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
ARG PUBLIC_TOR_IP
ARG LUCID_INTERNAL_NETWORK_NAME
ARG LUCID_TOR_EGRESS_NETWORK_NAME
ARG PYTHON_VERSION=3.11

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /build
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
      build-essential \
      gcc \
      g++ \
      libffi-dev \
      libssl-dev \
      pkg-config \
      curl \
      python3.11-dev \
      python3-pip \
      python3.11-setuptools \
      python3.11-wheel \
      ca-certificates \
      tini \
      bash \
      jq \
      netcat-openbsd \
      socat \
      xxd \
      rustc \
      cargo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \


# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; overlaps with builder mkdir/.keep removed — see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/bin' \
    '/lib' \
    '/usr/bin' \
    '/usr/sbin' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/lib/python3/dist-packages' \
    '/usr/local/lib/python3.11'; \
  for d in \
    '/bin' \
    '/lib' \
    '/usr/bin' \
    '/usr/sbin' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/lib/python3/dist-packages' \
    '/usr/local/lib/python3.11'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END

RUN apt-get remove -y rustc cargo && rm -rf /root/.cargo /root/.rustup && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    pip install --upgrade pip setuptools wheel && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels \
        "pip>=24.0" \
        "setuptools>=69.0" \
        "wheel>=0.42.0" && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels \
        "uvicorn[standard]>=0.24.0" \
        "fastapi>=0.104.0" \
        "pydantic>=2.0.0" \
        "httpx>=0.25.0" \
        "PyJWT>=2.8.0" \
        "passlib[bcrypt]>=1.7.4" \
        "cryptography>=41.0.0" \
        "structlog>=23.2.0" \
        "python-dotenv>=1.0.0" \
        "websockets>=11.0.0" && \
        echo "Total wheels built: $(ls -1 /build/wheels/ | wc -l)"
# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
RUN set -eux; \
    mkdir -p '.' './common' './configs' './wallet' './common/__pycache__' './common/governance' './common/security' './common/server-tools' './common/templates' './common/tor' './configs/.ssh' './configs/container' './configs/database' './configs/docker' './configs/env' './configs/environment' './configs/integration' './configs/kubernetes' './configs/logging' './configs/pi' './configs/secrets' './configs/security' './configs/tor' './tests/security' './wallet/__pycache__' './wallet/security' './wallet/walletd' './common/governance/__pycache__' './common/security/__pycache__' './common/server-tools/__pycache__' './common/tor/__pycache__' './configs/container/admin' './configs/container/auth' './configs/container/base' './configs/container/blockchain' './configs/container/database' './configs/container/electron_gui' './configs/container/gui' './configs/container/node' './configs/container/payment_systems' './configs/container/rdp' './configs/container/server' './configs/container/sessions' './configs/container/storage' './configs/container/tor' './configs/database/elasticsearch' './configs/database/redis' './configs/docker/distroless' './configs/docker/docs' './configs/docker/multi-stage' './configs/pi/ssh' './wallet/security/__pycache__' './wallet/walletd/__pycache__'; \
    for d in \
      '.' \
      './common' \
      './configs' \
      './wallet' \
      './common/__pycache__' \
      './common/governance' \
      './common/security' \
      './common/server-tools' \
