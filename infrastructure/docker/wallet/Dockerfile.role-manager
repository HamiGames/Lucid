      './blockchain/api/app/schemas/__pycache__' \
      './blockchain/api/app/services/__pycache__' \
    ; do \
      printf 'LUCID_X_FILES_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
      touch "$d/.keep"; \
    done
# LUCID_X_FILES_SKELETON_END

# Builder-stage verification - ensure all packages built correctly
RUN apt-get remove -y rustc cargo && rm -rf /root/.cargo /root/.rustup && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

RUN echo "=== Verifying pip installation success ===" && \
    python3 -c "import fastapi, uvicorn, pydantic, httpx, websockets, jsonschema, pyyaml; print('✅ All critical packages installed')" && \
    test -d /usr/local/lib/python3.11/site-packages && \
    echo "Package count: $(ls -1 /usr/local/lib/python3.11/site-packages/ | wc -l)"
COPY scripts/ ./scripts/

# Install Python dependencies for role management
RUN pip install --no-cache-dir \
        "uvicorn[standard]>=0.24.0" \
        "fastapi>=0.104.0" \
        "pydantic>=2.0.0" \
        "httpx>=0.25.0" \
        "PyJWT>=2.8.0" \
        "passlib[bcrypt]>=1.7.4" \
        "cryptography>=41.0.0" \
        "structlog>=23.2.0" \
        "python-dotenv>=1.0.0" \
        "websockets>=11.0.0"

# Copy application code
COPY wallet/ ./wallet/
COPY admin/ ./admin/
COPY common/ ./common/

RUN rm -rf configs/environment 2>/dev/null || true

COPY infrastructure/service_mesh/ ./service_mesh/
COPY 03_api_gateway/ ./03_api_gateway/
COPY server/ ./server/
COPY node/ ./node/
COPY auth/ ./auth/
COPY user_content/ ./user_content/
COPY storage/ ./storage/
COPY user/ ./user/
COPY wallet/ ./wallet/
COPY vm/ ./vm/
COPY blockchain/ ./blockchain/
COPY 03_api_gateway/ ./03_api_gateway/
COPY 02_network_security/ ./02_network_security/

COPY sessions/ ./sessions/
COPY service_mesh/ ./service_mesh/

# Create role management directories (runtime: /app/lucid/...)
RUN mkdir -p ./lucid/roles ./lucid/permissions /data/roles /tmp/roles \
    && chown -R 65532:65532 ./lucid /data /tmp/roles

# Create non-root user for runtime
RUN adduser --disabled-password --gecos '' role_user && \
    chown -R role_user:role_user /build /data /tmp/roles

# Stage 2: Distroless runtime with Python and authentication dependencies
FROM gcr.io/distroless/python3-debian12:nonroot
WORKDIR /app
# Metadata for runtime container
LABEL maintainer="Lucid Development Team" \
      version="1.0.0-distroless" \
      description="Role Manager for Lucid SPEC-1C Role-Based Access Control (Distroless)" \
      org.opencontainers.image.title="Lucid Role Manager" \
      org.opencontainers.image.description="Distroless role manager service for Lucid project" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="role-manager" \
      com.lucid.layer="1" \
      org.lucid.layer="1" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="8102" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation"


# Runtime environment for role manager \
      com.lucid.service_id="com.lucid.dockerfile.v1.b093417fba8bf777.infrastructure.docker.wallet.Dockerfile.role-manager" \
      onion.lucid.service_id="lucid-b093417fba8bf777-infrastructure-docker-wa" \
      org.lucid.service_id="org.lucid.dockerfile.v1.b093417fba8bf777:infrastructure/docker/wallet/Dockerfile.role-manager" \
ENV PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONPATH="/app" \
    DEBUG="false" \
    JWT_EXPIRATION_HOURS=${JWT_EXPIRATION_HOURS} \
    JWT_SECRET_KEY=${JWT_SECRET_KEY} \
    JWT_ALGORITHM=${JWT_ALGORITHM} \
    LOG_LEVEL="INFO" \
    LUCID_HOST_CONFIG_PATH="/app/configs/host-config.yml" \
    LUCID_SERVICES_CONFIG_ROOT="/app/service_configs" \
    MAX_LOGIN_ATTEMPTS=${MAX_LOGIN_ATTEMPTS} \
    MONGODB_URI=mongodb://lucid:${MONGODB_PASSWORD}@lucid-mongodb:27017/lucid?authSource=admin \
    PASSWORD_HASH_ROUNDS=${PASSWORD_HASH_ROUNDS} \
    PERMISSIONS_PATH="/app/lucid/permissions" \
    REDIS_PASSWORD=${REDIS_PASSWORD} \
    REDIS_URL="redis://lucid-redis:6379/0" \
    ROLES_PATH="/app/lucid/roles" \
    SERVICE_HOST="0.0.0.0" \
    SERVICE_NAME="wallet-role-manager" \
    SERVICE_PORT="8102" \
    USDT_CONTRACT_ADDRESS=${USDT_CONTRACT_ADDRESS} \
    WALLET_MANAGER_URL=${WALLET_MANAGER_URL} \
    XDG_RUNTIME_DIR="/app/tmp/roles"
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=role-manager-builder --chown=role_user /usr/lib/*/libffi.so* /app/usr/lib/
COPY --from=role-manager-builder --chown=role_user /usr/lib/*/libssl.so* /app/usr/lib/
COPY --from=role-manager-builder --chown=role_user /usr/lib/*/ossl-modules/ /app/usr/lib/
COPY --from=role-manager-builder --chown=role_user /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=role-manager-builder --chown=role_user ./ /app/./
COPY --from=role-manager-builder --chown=role_user /bin/ /app/bin/
COPY --from=role-manager-builder --chown=role_user /data/ /app/data/
COPY --from=role-manager-builder --chown=role_user /etc/ /app/etc/
COPY --from=role-manager-builder --chown=role_user /tmp/ /app/tmp/
COPY --from=role-manager-builder --chown=role_user /usr/bin/ /app/usr/bin/
COPY --from=role-manager-builder --chown=role_user /usr/lib/python3/dist-packages/ /app/usr/lib/python3/dist-packages/
COPY --from=role-manager-builder --chown=role_user /usr/local/bin/ /app/usr/local/bin/
COPY --from=role-manager-builder --chown=role_user /usr/local/lib/ /app/usr/local/lib/
COPY --from=role-manager-builder --chown=role_user /usr/sbin/ /app/usr/sbin/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END

# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=role-manager-builder --chown=65532:65532 /build/02_network_security/ /app/02_network_security/
COPY --from=role-manager-builder --chown=65532:65532 /build/03_api_gateway/ /app/03_api_gateway/
COPY --from=role-manager-builder --chown=65532:65532 /build/admin/ /app/admin/
COPY --from=role-manager-builder --chown=65532:65532 /build/auth/ /app/auth/
COPY --from=role-manager-builder --chown=65532:65532 /build/blockchain/ /app/blockchain/
COPY --from=role-manager-builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=role-manager-builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=role-manager-builder --chown=65532:65532 /build/node/ /app/node/
COPY --from=role-manager-builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=role-manager-builder --chown=65532:65532 /build/server/ /app/server/
COPY --from=role-manager-builder --chown=65532:65532 /build/service_mesh/ /app/service_mesh/
COPY --from=role-manager-builder --chown=65532:65532 /build/sessions/ /app/sessions/
COPY --from=role-manager-builder --chown=65532:65532 /build/storage/ /app/storage/
COPY --from=role-manager-builder --chown=65532:65532 /build/user/ /app/user/
COPY --from=role-manager-builder --chown=65532:65532 /build/user_content/ /app/user_content/
COPY --from=role-manager-builder --chown=65532:65532 /build/vm/ /app/vm/
COPY --from=role-manager-builder --chown=65532:65532 /build/wallet/ /app/wallet/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

COPY --from=role-manager-builder /usr/local/lib/python3.11 /app/usr/local/lib/python3.11
COPY --from=role-manager-builder /usr/local/bin/python3.11 /app/usr/local/bin/python3.11
COPY --from=role-manager-builder /usr/local/bin/uvicorn /app/usr/local/bin/uvicorn

COPY --from=role-manager-builder /usr/bin/openssl /app/usr/bin/openssl
COPY --from=role-manager-builder /usr/bin/sqlite3 /app/usr/bin/sqlite3
COPY --from=role-manager-builder /usr/bin/curl /app/usr/bin/curl
COPY --from=role-manager-builder /bin/nc /app/bin/nc
COPY --from=role-manager-builder /usr/bin/jq /app/usr/bin/jq
COPY --from=role-manager-builder /usr/sbin/gosu /app/usr/sbin/gosu

COPY --from=role-manager-builder /lib/*-linux-*/libc.so.6 /app/lib/
COPY --from=role-manager-builder /lib/*-linux-*/libssl.so.3 /app/lib/
COPY --from=role-manager-builder /lib/*-linux-*/libcrypto.so.3 /app/lib/
COPY --from=role-manager-builder /lib/*-linux-*/libz.so.1 /app/lib/
COPY --from=role-manager-builder /lib/*-linux-*/liblzma.so.5 /app/lib/
COPY --from=role-manager-builder /lib/*-linux-*/libzstd.so.1 /app/lib/
COPY --from=role-manager-builder /lib*/ld-linux-*.so.2 /app/lib64/

COPY --from=role-manager-builder /etc/passwd /app/etc/passwd
COPY --from=role-manager-builder /etc/group /app/etc/group

COPY --from=role-manager-builder /etc/ssl/certs/ca-certificates.crt /app/etc/ssl/certs/ca-certificates.crt

COPY --from=role-manager-builder --chown=role_user:role_user /data /app/data
COPY --from=role-manager-builder --chown=role_user:role_user /tmp/roles /app/tmp/roles


EXPOSE 8102
USER role_user


# Default command for role manager service
ENTRYPOINT ["/app/usr/local/bin/python3.11", "/app/wallet/walletd/role_manager.py"]
