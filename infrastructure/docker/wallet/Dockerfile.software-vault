COPY wallet/ ./wallet/


# Create vault directories (runtime: /app/lucid/...)
RUN groupadd --gid 1000 lucid \
    && useradd --uid 1000 --gid 1000 --shell /bin/bash --create-home lucid

RUN chown -R lucid:lucid /build

RUN pip install --no-cache-dir \
        "uvicorn[standard]>=0.24.0" \
        "fastapi>=0.104.0" \
        "pydantic>=2.0.0" \
        "httpx>=0.25.0" \
        "cryptography>=41.0.0" \
        "argon2-cffi>=21.3.0" \
        "structlog>=23.2.0" \
        "python-dotenv>=1.0.0" \
        "websockets>=11.0.0"

# Copy application code
RUN rm -rf configs/environment 2>/dev/null || true

RUN mkdir -p ./lucid/wallet ./lucid/vaults ./lucid/keys /data/vaults /tmp/vault \
    && chown -R 65532:65532 ./lucid /data /tmp/vault

# Create non-root user for runtime
RUN adduser --disabled-password --gecos '' vault_user && \
    chown -R vault_user:vault_user /build /data /tmp/vault

# Stage 2: Distroless runtime with Python and cryptographic dependencies
LABEL maintainer="Lucid Development Team" \
      version="1.0.0-distroless" \
      description="Passphrase-Protected Vault (Distroless)" \
      com.lucid.plane="ops" \
      com.lucid.service="software-vault" \
      com.lucid.layer="1" \
      org.lucid.layer="1" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="8101" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation"

# Build-time environment for dependency installation
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PREFER_BINARY=1 \
    DEBIAN_FRONTEND=noninteractive

# Install build dependencies and cryptographic tools
FROM --platform=$TARGETPLATFORM gcr.io/distroless/python3-debian12:latest

# Metadata for runtime container
LABEL maintainer="Lucid Development Team" \
      version="1.0.0-distroless" \
      description="Passphrase-Protected Vault (Distroless Runtime)" \
      com.lucid.plane="ops" \
      com.lucid.service="software-vault" \
      com.lucid.layer="1" \
      org.lucid.layer="1" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="8101" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation" \
      com.lucid.service_id="com.lucid.dockerfile.v1.d0795488fdbd0fd6.infrastructure.docker.wallet.Dockerfile.software-vault" \
      onion.lucid.service_id="lucid-d0795488fdbd0fd6-infrastructure-docker-wa" \
      org.lucid.service_id="org.lucid.dockerfile.v1.d0795488fdbd0fd6:infrastructure/docker/wallet/Dockerfile.software-vault" \
ENV PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONPATH="/app" \
    KEYS_PATH="/app/lucid/keys" \
    KEY_DERIVATION_ITERATIONS="100000" \
    LUCID_HOST_CONFIG_PATH="/app/configs/host-config.yml" \
    LUCID_SERVICES_CONFIG_ROOT="/app/service_configs" \
    MAX_LOGIN_ATTEMPTS="3" \
    VAULT_ENCRYPTION="argon2" \
    VAULT_PATH="/app/lucid/vaults" \
    VAULT_TIMEOUT="300" \
    WALLET_PATH="/app/lucid/wallet" \
    XDG_RUNTIME_DIR="/app/tmp/vault"
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=vault-builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=vault-builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=vault-builder --chown=65532:65532 /build/wallet/ /app/wallet/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

