RUN printf "LUCID_NODE_REGISTRY_RUNTIME" > /var/run/.keep && \
    printf "LUCID_NODE_REGISTRY_LIB" > /var/lib/.keep && \
    chown -R 65532:65532 /var/run /var/lib && chmod 644 /var/run/.keep /var/lib/.keep

