COPY payment_systems/tron_node/payout_manager.py ./payment_systems/tron_node/payout_manager.py
COPY payment_systems/tron_node/payout_router_kyc.py ./payment_systems/tron_node/payout_router_kyc.py
COPY infrastructure/service_mesh/service_mesh_translator.py ./service_mesh/service_mesh_translator.py
