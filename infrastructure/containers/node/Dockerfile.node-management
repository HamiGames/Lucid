      com.lucid.cluster="application" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation,.env.secrets" \
      com.lucid.service_id="com.lucid.dockerfile.v1.a6e21e69f127616e.infrastructure.containers.node.Dockerfile.node-management" \
