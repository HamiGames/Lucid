  mkdir -p \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/var/lib' \
    '/var/run' \
    '/usr/lib/python3/dist-packages' \
    '/usr/local/lib/python3.11/site-packages'; \
  for d in \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/var/lib' \
    '/var/run' \
    '/usr/lib/python3/dist-packages' \
    '/usr/local/lib/python3.11/site-packages'; \
  do \
