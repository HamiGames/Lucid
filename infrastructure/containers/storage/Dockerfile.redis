# LUCID_X_FILES_SKELETON_END
COPY common/ ./common/
COPY configs/container/auth/ ./configs/container/auth/
COPY configs/container/blockchain/ ./configs/container/blockchain/
COPY configs/container/database/ ./configs/container/database/
COPY configs/container/node/ ./configs/container/node/
COPY configs/container/payment_systems/ ./configs/container/payment_systems/
COPY configs/container/rdp/ ./configs/container/rdp/
COPY configs/docker/ ./configs/docker/
COPY configs/integration/ ./configs/integration/
COPY configs/security/ ./configs/security/
COPY service_configs/ ./service_configs/
COPY infrastructure/containers/ ./infrastructure/containers/
COPY infrastructure/service_mesh/config/ ./infrastructure/service_mesh/config/
# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_END
RUN rm -rf configs/environment 2>/dev/null || true


COPY infrastructure/containers/storage/redis.conf /build/service_configs/storage/redis.conf
COPY scripts/ ./scripts/

############################
# Stage 2: distroless runtime (capacity at /data)
############################
FROM --platform=$TARGETPLATFORM gcr.io/distroless/python3-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

WORKDIR /app

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Storage Plane — Redis durability" \
      org.opencontainers.image.description="Volume-backed Redis persistence (RDB/AOF) for Lucid storage plane" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="lucid-redis-storage" \
      com.lucid.layer="storage-plane" \
      org.lucid.layer="storage-plane" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="6380" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.tunnel-tools,.env.foundation" \
      com.lucid.storage.engine="redis" \
      com.lucid.redis.version="7.2"

# LUCID_IMAGE_CONFIG: (runtime) \
      com.lucid.service_id="com.lucid.dockerfile.v1.61fd3450f8ba8a48.infrastructure.containers.storage.Dockerfile.redis" \
      onion.lucid.service_id="lucid-61fd3450f8ba8a48-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.61fd3450f8ba8a48:infrastructure/containers/storage/Dockerfile.redis" \
ENV PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH="/app/usr/local/bin:/app/usr/bin:/bin" \
    LUCID_HOST_SERVICE_NAME=lucid-redis-storage \
    LUCID_SERVICE_HOST_IP=172.20.10.67 \
    LUCID_SERVICE_HTTP_PATH=http://lucid-redis-storage:6380/app \
    LUCID_STORAGE_VOLUME_ROLE="redis-storage"
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=redis-builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=redis-builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=redis-builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=redis-builder --chown=65532:65532 /build/service_configs/ /app/service_configs/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=redis-builder --chown=65532:65532 /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=redis-builder --chown=65532:65532 /bin/ /app/bin/
COPY --from=redis-builder --chown=65532:65532 /etc/ssl/ /app/etc/ssl/
COPY --from=redis-builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
COPY --from=redis-builder --chown=65532:65532 /usr/lib/python3.11/ /app/usr/lib/python3.11/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END
# LUCID_RUNTIME_COPY_FROM_BUILD_END
# LUCID_IMAGE_CONFIG: (builder)

EXPOSE 6380

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD ["/app/usr/bin/python3", "-c", "import socket; s=socket.socket(); s.settimeout(2); r=s.connect_ex(('127.0.0.1', 6379)); s.close(); exit(0 if r==0 else 1)"]

USER 65532:65532

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/redis-server"]

CMD ["/app/etc/redis/redis.conf"]
COPY infrastructure/containers/storage/redis.conf /app/etc/redis/redis.conf

VOLUME ["/app/redis/storage/data"]
