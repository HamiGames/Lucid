# syntax=docker/dockerfile:1.5
# File: infrastructure/containers/storage/Dockerfile.redis
#
# LUCID STORAGE PLANE — Redis durability on attached capacity (RDB/AOF in /data).
# Purpose here: bind Lucid to real persistence (volume-backed bytes). Query/cache policy
# and higher-level data organisation are database/operational concerns.
# Build context: repository root (.)

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64

############################
# Stage 1: extract redis-server + health tooling
############################
ARG BUILDPLATFORM
ARG TARGETPLATFORM

FROM --platform=$TARGETPLATFORM redis:7.2 AS redis-builder

WORKDIR /build

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        tini \
        redis-server \
        redis-cli \
        bash \
        build-essential \
        ca-certificates \
        curl \
        dnsutils \
        gnupg \
        gosu \
        openssl \
        gzip \
        htop \
        inetutils-traceroute \
        iperf3 \
        iputils-ping \
        jq \
        netcat-openbsd \
        net-tools \
        python3.11 \
        python3.11-pip \
        python3.11-setuptools \
        python3.11-wheel \
        rustc \
        cargo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# LUCID_LIB_SKELETON_BEGIN
# (no non-/build/ FHS COPY --from paths under /app/ found; no directories to create.)
# LUCID_LIB_SKELETON_END

# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
