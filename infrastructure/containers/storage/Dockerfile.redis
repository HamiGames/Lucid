# syntax=docker/dockerfile:1.5
# LUCID STORAGE PLANE — Redis durability on attached capacity (RDB/AOF in /data).
# Purpose here: bind Lucid to real persistence (volume-backed bytes). Query/cache policy
# and higher-level data organisation are database/operational concerns.
# Build context: repository root (.)

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64

############################
# Stage 1: extract redis-server + health tooling
############################
FROM --platform=$TARGETPLATFORM redis:7.2 AS redis-builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM

ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true

# LUCID_IMAGE_CONFIG: .env.secrets + .env.master (builder)

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        tini \
        redis-server \
        redis-cli \
        bash \
        build-essential \
        ca-certificates \
        curl \
        dnsutils \
        gnupg \
        gosu \
        openssl \
        gzip \
        htop \
        inetutils-traceroute \
        iperf3 \
        iputils-ping \
        jq \
        netcat-openbsd \
        net-tools \
        python3.11 \
        python3.11-pip \
        python3.11-setuptools \
        python3.11-wheel \
        rustc \
        cargo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
RUN set -eux; \
    mkdir -p '.' './configs' './scripts' './service_configs' './configs/.devcontainer' './configs/.ssh' './configs/admin' './configs/auth' './configs/base' './configs/blockchain' './configs/compose' './configs/container' './configs/database' './configs/docker' './configs/electron_gui' './configs/environment' './configs/gui' './configs/integration' './configs/logging' './configs/network' './configs/node' './configs/overlord' './configs/payment_systems' './configs/pi' './configs/rdp' './configs/secrets' './configs/security' './configs/server' './configs/tor' './configs/user' './scripts/build' './scripts/compliance' './scripts/config' './scripts/contracts' './scripts/database' './scripts/deployment' './scripts/devcontainer' './scripts/docs' './scripts/foundation' './scripts/gui' './scripts/hardware' './scripts/integration' './scripts/lib' './scripts/load' './scripts/logging' './scripts/maintenance' './scripts/migration' './scripts/monitoring' './scripts/network' './scripts/registry' './scripts/secrets' './scripts/security' './scripts/services' './scripts/testing' './scripts/validation' './scripts/verification' './service_configs/distroless' './service_configs/kubernetes' './service_configs/logging' './service_configs/multi-stage' './service_configs/node' './service_configs/payment_services' './service_configs/rdp' './service_configs/security' './service_configs/service_mesh' './service_configs/sessions' './service_configs/storage' './service_configs/tor' './service_configs/x_lucid_cluster_calibration' './configs/admin/admin-system-gateway' './configs/admin/config' './configs/blockchain/chain-to-pay' './configs/blockchain/config' './configs/container/admin' './configs/container/auth' './configs/container/base' './configs/container/blockchain' './configs/container/database' './configs/container/electron_gui' './configs/container/gui' './configs/container/node' './configs/container/payment_systems' './configs/container/rdp' './configs/container/server' './configs/container/sessions' './configs/container/storage' './configs/container/tor' './configs/database/elasticsearch' './configs/database/redis' './configs/docker/compose' './configs/docker/distroless' './configs/docker/docs' './configs/docker/multi-stage' './configs/docker/on-system-chain' './configs/environment/development' './configs/environment/pi' './configs/environment/production' './configs/environment/staging' './configs/node/config' './configs/node/node-system-gateway' './configs/overlord/runtime' './configs/pi/ssh' './scripts/build/components' './scripts/build/core' './scripts/build/distroless' './scripts/build/utils' './scripts/compliance/distroless' './scripts/compliance/general' './scripts/deployment/devcontainer' './scripts/deployment/distroless' './scripts/deployment/pi' './scripts/deployment/utils' './scripts/maintenance/cleanup' './scripts/maintenance/optimization' './scripts/maintenance/recovery' './scripts/network/diagnostics' './scripts/network/security' './scripts/network/setup' './scripts/testing/integration' './scripts/testing/unit' './scripts/testing/utils' './service_configs/kubernetes/01_configmaps' './service_configs/kubernetes/02-secrets' './service_configs/kubernetes/03-databases' './service_configs/kubernetes/04-auth' './service_configs/kubernetes/04-network' './service_configs/kubernetes/05-core' './service_configs/kubernetes/06-application' './service_configs/kubernetes/07-support' './service_configs/kubernetes/08-ingress' './service_configs/kubernetes/patches' './configs/docker/compose/mongodb' './configs/docker/compose/nats' './configs/docker/compose/nginx' './configs/docker/compose/redis' './configs/docker/compose/vault' './configs/docker/distroless/base'; \
    for d in \
      '.' \
      './configs' \
      './scripts' \
      './service_configs' \
      './configs/.devcontainer' \
      './configs/.ssh' \
      './configs/admin' \
      './configs/auth' \
      './configs/base' \
      './configs/blockchain' \
      './configs/compose' \
      './configs/container' \
      './configs/database' \
      './configs/docker' \
      './configs/electron_gui' \
      './configs/environment' \
      './configs/gui' \
      './configs/integration' \
      './configs/logging' \
      './configs/network' \
      './configs/node' \
      './configs/overlord' \
      './configs/payment_systems' \
      './configs/pi' \
      './configs/rdp' \
      './configs/secrets' \
      './configs/security' \
      './configs/server' \
      './configs/tor' \
      './configs/user' \
      './scripts/build' \
      './scripts/compliance' \
      './scripts/config' \
      './scripts/contracts' \
      './scripts/database' \
      './scripts/deployment' \
      './scripts/devcontainer' \
      './scripts/docs' \
      './scripts/foundation' \
      './scripts/gui' \
      './scripts/hardware' \
      './scripts/integration' \
      './scripts/lib' \
      './scripts/load' \
      './scripts/logging' \
      './scripts/maintenance' \
      './scripts/migration' \
      './scripts/monitoring' \
      './scripts/network' \
      './scripts/registry' \
      './scripts/secrets' \
      './scripts/security' \
      './scripts/services' \
      './scripts/testing' \
      './scripts/validation' \
      './scripts/verification' \
      './service_configs/distroless' \
      './service_configs/kubernetes' \
      './service_configs/logging' \
      './service_configs/multi-stage' \
      './service_configs/node' \
      './service_configs/payment_services' \
      './service_configs/rdp' \
      './service_configs/security' \
      './service_configs/service_mesh' \
      './service_configs/sessions' \
      './service_configs/storage' \
      './service_configs/tor' \
      './service_configs/x_lucid_cluster_calibration' \
      './configs/admin/admin-system-gateway' \
      './configs/admin/config' \
      './configs/blockchain/chain-to-pay' \
      './configs/blockchain/config' \
      './configs/container/admin' \
      './configs/container/auth' \
      './configs/container/base' \
      './configs/container/blockchain' \
      './configs/container/database' \
      './configs/container/electron_gui' \
      './configs/container/gui' \
      './configs/container/node' \
      './configs/container/payment_systems' \
      './configs/container/rdp' \
      './configs/container/server' \
      './configs/container/sessions' \
      './configs/container/storage' \
      './configs/container/tor' \
      './configs/database/elasticsearch' \
      './configs/database/redis' \
      './configs/docker/compose' \
      './configs/docker/distroless' \
      './configs/docker/docs' \
      './configs/docker/multi-stage' \
      './configs/docker/on-system-chain' \
      './configs/environment/development' \
      './configs/environment/pi' \
      './configs/environment/production' \
      './configs/environment/staging' \
      './configs/node/config' \
      './configs/node/node-system-gateway' \
      './configs/overlord/runtime' \
      './configs/pi/ssh' \
      './scripts/build/components' \
      './scripts/build/core' \
      './scripts/build/distroless' \
      './scripts/build/utils' \
      './scripts/compliance/distroless' \
      './scripts/compliance/general' \
      './scripts/deployment/devcontainer' \
      './scripts/deployment/distroless' \
      './scripts/deployment/pi' \
      './scripts/deployment/utils' \
      './scripts/maintenance/cleanup' \
      './scripts/maintenance/optimization' \
      './scripts/maintenance/recovery' \
      './scripts/network/diagnostics' \
      './scripts/network/security' \
      './scripts/network/setup' \
      './scripts/testing/integration' \
      './scripts/testing/unit' \
      './scripts/testing/utils' \
      './service_configs/kubernetes/01_configmaps' \
      './service_configs/kubernetes/02-secrets' \
      './service_configs/kubernetes/03-databases' \
      './service_configs/kubernetes/04-auth' \
      './service_configs/kubernetes/04-network' \
      './service_configs/kubernetes/05-core' \
      './service_configs/kubernetes/06-application' \
      './service_configs/kubernetes/07-support' \
      './service_configs/kubernetes/08-ingress' \
      './service_configs/kubernetes/patches' \
      './configs/docker/compose/mongodb' \
      './configs/docker/compose/nats' \
      './configs/docker/compose/nginx' \
      './configs/docker/compose/redis' \
      './configs/docker/compose/vault' \
      './configs/docker/distroless/base' \
    ; do \
      printf 'LUCID_X_FILES_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
      touch "$d/.keep"; \
    done
# LUCID_X_FILES_SKELETON_END
COPY configs/ ./configs/
RUN rm -rf ./configs/environment && \
    echo ".env.* files removed"
COPY configs/environment/.env.secrets ./configs/.env.secrets
COPY master-env-config.txt ./configs/.env.master
COPY infrastructure/containers/services/container-runtime-layout.yml /build/service_configs/container-runtime-layout.yml
COPY infrastructure/containers/storage/redis.conf /build/service_configs/storage/redis.conf
COPY scripts/ ./scripts/

############################
# Stage 2: distroless runtime (capacity at /data)
############################
FROM --platform=$TARGETPLATFORM gcr.io/distroless/python3-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: master-env-config.txt; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Storage Plane — Redis durability" \
      org.opencontainers.image.description="Volume-backed Redis persistence (RDB/AOF) for Lucid storage plane" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="lucid-redis-storage" \
      com.lucid.layer="storage-plane" \
      org.lucid.layer="storage-plane" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="6380" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.tunnel-tools,.env.secrets,.env.foundation" \
      com.lucid.storage.engine="redis" \
      com.lucid.redis.version="7.2"

# LUCID_IMAGE_CONFIG: .env.secrets + .env.master (runtime) \
      com.lucid.service_id="com.lucid.dockerfile.v1.61fd3450f8ba8a48.infrastructure.containers.storage.Dockerfile.redis" \
      onion.lucid.service_id="lucid-61fd3450f8ba8a48-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.61fd3450f8ba8a48:infrastructure/containers/storage/Dockerfile.redis" \
COPY --from=redis-builder --chown=65532:65532 /build/configs/.env.secrets /app/configs/.env.secrets
COPY --from=redis-builder --chown=65532:65532 /build/configs/.env.master /app/configs/.env.master
COPY --from=redis-builder --chown=65532:65532 /build/service_configs /app/service_configs

COPY --from=redis-builder /usr/local/bin/redis-server /app/usr/local/bin/redis-server
COPY --from=redis-builder /usr/local/bin/redis-cli /app/usr/local/bin/redis-cli
COPY --from=redis-builder /usr/bin/python3 /app/usr/bin/python3
COPY --from=redis-builder /usr/lib/python3.* /app/usr/lib/
COPY --from=redis-builder /usr/bin/tini /app/usr/bin/tini

COPY --from=redis-builder /lib/*/libc.so.6 /app/lib/
COPY --from=redis-builder /lib/*/libssl.so.3 /app/lib/
COPY --from=redis-builder /lib/*/libcrypto.so.3 /app/lib/
COPY --from=redis-builder /lib/*/libz.so.1 /app/lib/
COPY --from=redis-builder /lib*/ld-linux-*.so.2 /app/lib64/

COPY --from=redis-builder /etc/ssl/certs/ca-certificates.crt /app/etc/ssl/certs/ca-certificates.crt

COPY infrastructure/containers/storage/redis.conf /app/etc/redis/redis.conf

ENV PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH="/app/usr/local/bin:/app/usr/bin:/bin" \
    LUCID_HOST_SERVICE_NAME=lucid-redis-storage \
    LUCID_SERVICE_HOST_IP=172.20.10.67 \
    LUCID_SERVICE_HTTP_PATH=http://lucid-redis-storage:6380/app \
    LUCID_STORAGE_VOLUME_ROLE="redis-storage"
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=redis-builder --chown=65532:65532 /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=redis-builder --chown=65532:65532 /bin/ /app/bin/
COPY --from=redis-builder --chown=65532:65532 /etc/ssl/ /app/etc/ssl/
COPY --from=redis-builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
COPY --from=redis-builder --chown=65532:65532 /usr/lib/python3.11/ /app/usr/lib/python3.11/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END

# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=redis-builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=redis-builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=redis-builder --chown=65532:65532 /build/service_configs/ /app/service_configs/
# LUCID_RUNTIME_COPY_FROM_BUILD_END


WORKDIR /app

VOLUME ["/app/redis/storage/data"]

EXPOSE 6380

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD ["/app/usr/bin/python3", "-c", "import socket; s=socket.socket(); s.settimeout(2); r=s.connect_ex(('127.0.0.1', 6379)); s.close(); exit(0 if r==0 else 1)"]

USER 65532:65532

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/redis-server"]

CMD ["/app/etc/redis/redis.conf"]
