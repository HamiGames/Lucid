FROM --platform=$TARGETPLATFORM gcr.io/distroless/java17-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: master-env-config.txt; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=${PUBLIC_TOR_IP}
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Storage Plane — Elasticsearch durability" \
      org.opencontainers.image.description="Volume-backed Elasticsearch data paths for Lucid storage plane" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="elasticsearch-storage" \
      com.lucid.layer="storage-plane" \
      org.lucid.layer="storage-plane" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="9300,9200" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.master,.env.secrets" \
      com.lucid.storage.engine="elasticsearch" \
      com.lucid.elasticsearch.version="8.11.0" \
      com.lucid.service_id="com.lucid.dockerfile.v1.48701e1a21b14772.infrastructure.containers.storage.Dockerfile.elasticsearch" \
      onion.lucid.service_id="lucid-48701e1a21b14772-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.48701e1a21b14772:infrastructure/containers/storage/Dockerfile.elasticsearch" \



ENV   PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
      LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
      LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      PATH="/usr/share/elasticsearch/bin:/usr/bin:/bin" \
      LUCID_HOST_CONFIG_SERVICE_NAME=elasticsearch-storage \
      LUCID_SERVICE_HOST_IP=${ES_STORAGE_HOST_IP} \
      LUCID_SERVICE_HTTP_PATH=http://elasticsearch-storage:9300/app \
      LUCID_STORAGE_VOLUME_ROLE="elasticsearch-storage"
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_BEGIN
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=elasticsearch-builder --chown=65532:65532 /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=elasticsearch-builder --chown=65532:65532 /usr/lib/*/libffi.so* /app/usr/lib/
COPY --from=elasticsearch-builder --chown=65532:65532 /usr/lib/*/libssl.so* /app/usr/lib/
COPY --from=elasticsearch-builder --chown=65532:65532 /usr/lib/*/ossl-modules/ /app/usr/lib/
COPY --from=elasticsearch-builder --chown=65532:65532 /etc/ssl/ /app/etc/ssl/
COPY --from=elasticsearch-builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
COPY --from=elasticsearch-builder --chown=65532:65532 /usr/lib/python3.11/ /app/usr/lib/python3.11/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END

# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=elasticsearch-builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=elasticsearch-builder --chown=65532:65532 /build/database/ /app/database/
COPY --from=elasticsearch-builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=elasticsearch-builder --chown=65532:65532 /build/service_configs/ /app/service_configs/
COPY --from=elasticsearch-builder --chown=65532:65532 /build/storage/ /app/storage/
# LUCID_RUNTIME_COPY_FROM_BUILD_END
# LUCID_IMAGE_CONFIG: .env.secrets + .env.master (runtime)
COPY --from=elasticsearch-builder --chown=65532:65532 /build/configs/.env.secrets /app/configs/.env.secrets
COPY --from=elasticsearch-builder --chown=65532:65532 /build/configs/.env.master /app/configs/.env.master
COPY --from=elasticsearch-builder --chown=65532:65532 /build/service_configs /app/service_configs

COPY --from=elasticsearch-builder /usr/share/elasticsearch/ /usr/share/elasticsearch/

COPY --from=elasticsearch-builder /usr/bin/curl /usr/bin/curl
COPY --from=elasticsearch-builder /bin/bash /bin/bash
COPY --from=elasticsearch-builder /usr/bin/dirname /usr/bin/dirname
COPY --from=elasticsearch-builder /usr/bin/tini /usr/bin/tini
COPY --from=elasticsearch-builder /usr/share/elasticsearch/bin/elasticsearch-cli /usr/share/elasticsearch/bin/elasticsearch-cli

COPY --from=elasticsearch-builder /lib/*/libc.so.6 /lib/
COPY --from=elasticsearch-builder /lib/*/libssl.so.3 /lib/
COPY --from=elasticsearch-builder /lib/*/libcrypto.so.3 /lib/
COPY --from=elasticsearch-builder /lib/*/libz.so.1 /lib/
COPY --from=elasticsearch-builder /lib/*/libtinfo.so.6 /lib/
COPY --from=elasticsearch-builder /lib/*/libncurses.so.6 /lib/
COPY --from=elasticsearch-builder /lib*/ld-linux-*.so.2 /lib64/

COPY --from=elasticsearch-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY infrastructure/containers/storage/elasticsearch.yml /usr/share/elasticsearch/config/elasticsearch.yml




WORKDIR /app

VOLUME ["/app/data/elasticsearch", "/app/logs/elasticsearch"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["/app/usr/bin/curl", "-f", "http://127.0.0.1:9300/_cluster/health"]

EXPOSE 9300 9200

USER 65532:65532

ENTRYPOINT ["/app/usr/bin/tini", "--", "/app/usr/share/elasticsearch/bin/elasticsearch"]

CMD []
