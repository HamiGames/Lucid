# syntax=docker/dockerfile:1.5
# File: infrastructure/containers/database/Dockerfile.redis
#
# LUCID Redis - Distroless Python + redis-server
# Design aligned with 03_api_gateway/Dockerfile (stages, ARGs, markers, labels, /app layout, tini, 65532)
# Builder: official Redis image (correct base for redis-server / redis-cli binaries)
# Build context: repository root

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64

############################
# Stage 1 – Builder (Redis + Python deps for entrypoint/healthcheck)
############################
# Use global ARG TARGETPLATFORM (lines above); bare ARG TARGETPLATFORM before FROM can be empty.
FROM --platform=$TARGETPLATFORM redis:7.2 AS redis-builder

WORKDIR /build

COPY common/ ./common/  
COPY configs/container/database/ ./configs/container/database/
COPY database/redis/ ./database/redis/
COPY database/config/ ./database/config/
COPY infrastructure/containers/services/database/ ./infrastructure/containers/services/database/
COPY infrastructure/containers/services/storage/ ./infrastructure/containers/services/storage/
COPY infrastructure/containers/config-listings.json ./infrastructure/containers/config-listings.json
COPY infrastructure/containers/host-config.yml ./infrastructure/containers/host-config.yml
COPY infrastructure/containers/services/middle-ware/master-endpoint.yml ./infrastructure/containers/services/middle-ware/master-endpoint.yml
COPY infrastructure/containers/services/storage/redis-storage.yml ./infrastructure/containers/services/storage/redis-storage.yml
COPY infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml ./infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml
COPY infrastructure/docker/databases/ ./infrastructure/docker/databases/
COPY infrastructure/docker/common/ ./infrastructure/docker/common/
COPY infrastructure/service_mesh/communication/ ./infrastructure/service_mesh/
COPY service_configs/kubernetes/03-databases/ ./service_configs/kubernetes/03-databases/
COPY sessions/storage/ ./sessions/storage/

# Entry + health scripts and Redis config template (paths expected by database/redis/start-redis.py)
RUN mkdir -p ./usr/local/bin ./etc && \
    printf "LUCID_REDIS_USR_LOCAL_BIN" > ./usr/local/bin/.keep && \
    printf "LUCID_REDIS_ETC" > ./etc/.keep && \
    chmod 644 ./usr/local/bin/.keep ./etc/.keep

COPY database/redis/start-redis.py ./usr/local/bin/start-redis.py
COPY database/redis/healthcheck.py ./usr/local/bin/redis-healthcheck.py
COPY infrastructure/containers/storage/redis.conf ./etc/redis.conf.template



RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        python3-pip \
        tini \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# LUCID_LIB_SKELETON_BEGIN
# (no non-/build/ FHS COPY --from paths under /app/ found; no directories to create.)
# LUCID_LIB_SKELETON_END

# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
RUN set -eux; \
    mkdir -p '.' './common' './configs' './database' './etc' './service_configs' './sessions' './usr' './common/__pycache__' './common/governance' './common/security' './common/server-tools' './common/templates' './common/tor' './configs/.ssh' './configs/container' './configs/database' './configs/docker' './configs/env' './configs/environment' './configs/integration' './configs/kubernetes' './configs/logging' './configs/pi' './configs/secrets' './configs/security' './configs/tor' './database/__pycache__' './database/admin' './database/api' './database/config' './database/elasticsearch' './database/models' './database/mongodb' './database/redis' './database/repositories' './database/schema' './database/schemas' './database/services' './etc/apt' './etc/redis' './etc/redis.conf.template' './etc/ssl' './etc/tor' './sessions/__pycache__' './sessions/api' './sessions/config' './sessions/core' './sessions/encryption' './sessions/integration' './sessions/pipeline' './sessions/processor' './sessions/recorder' './sessions/security' './sessions/session_systems_control' './sessions/storage' './usr/bin' './usr/lib' './usr/local' './usr/sbin' './usr/share' './usr/var' './common/governance/__pycache__' './common/security/__pycache__' './common/server-tools/__pycache__' './common/tor/__pycache__' './configs/container/admin' './configs/container/auth' './configs/container/base' './configs/container/blockchain' './configs/container/database' './configs/container/electron_gui' './configs/container/gui' './configs/container/node' './configs/container/payment_systems' './configs/container/rdp' './configs/container/server' './configs/container/sessions' './configs/container/storage' './configs/container/tor' './configs/database/elasticsearch' './configs/database/redis' './configs/docker/distroless' './configs/docker/docs' './configs/docker/multi-stage' './configs/pi/ssh' './database/admin/__pycache__' './database/api/__pycache__' './database/config/__pycache__' './database/elasticsearch/__pycache__' './database/models/__pycache__' './database/mongodb/__pycache__' './database/redis/__pycache__' './database/repositories/__pycache__' './database/schema/__pycache__' './database/services/__pycache__' './database/services/backup' './database/services/migration' './database/services/monitoring' './etc/apt/apt.conf.d' './etc/ssl/certs' './service_configs/kubernetes/03-databases' './sessions/api/__pycache__' './sessions/api/config' './sessions/api/integration' './sessions/core/__pycache__' './sessions/encryption/__pycache__' './sessions/integration/__pycache__' './sessions/pipeline/__pycache__' './sessions/pipeline/integration' './sessions/processor/__pycache__' './sessions/processor/config' './sessions/processor/integration' './sessions/recorder/__pycache__' './sessions/recorder/config' './sessions/recorder/integration' './sessions/security/__pycache__' './sessions/session_systems_control/__pycache__' './sessions/storage/__pycache__' './sessions/storage/config' './usr/lib/python3' './usr/local/bin' './usr/local/lib' './usr/share/elasticsearch' './database/services/backup/__pycache__' './database/services/migration/__pycache__' './database/services/monitoring/__pycache__' './sessions/api/integration/__pycache__' './sessions/pipeline/integration/__pycache__' './sessions/processor/integration/__pycache__' './sessions/recorder/integration/__pycache__' './usr/local/lib/python3.11'; \
    for d in \
      '.' \
      './common' \
      './configs' \
      './database' \
      './etc' \
      './service_configs' \
      './sessions' \
      './usr' \
      './common/__pycache__' \
      './common/governance' \
      './common/security' \
      './common/server-tools' \
      './common/templates' \
      './common/tor' \
      './configs/.ssh' \
      './configs/container' \
      './configs/database' \
      './configs/docker' \
      './configs/env' \
      './configs/environment' \
      './configs/integration' \
      './configs/kubernetes' \
      './configs/logging' \
      './configs/pi' \
      './configs/secrets' \
      './configs/security' \
      './configs/tor' \
      './database/__pycache__' \
      './database/admin' \
      './database/api' \
      './database/config' \
      './database/elasticsearch' \
      './database/models' \
      './database/mongodb' \
      './database/redis' \
      './database/repositories' \
      './database/schema' \
      './database/schemas' \
      './database/services' \
      './etc/apt' \
      './etc/redis' \
      './etc/redis.conf.template' \
      './etc/ssl' \
      './etc/tor' \
      './sessions/__pycache__' \
      './sessions/api' \
      './sessions/config' \
      './sessions/core' \
      './sessions/encryption' \
      './sessions/integration' \
      './sessions/pipeline' \
      './sessions/processor' \
      './sessions/recorder' \
      './sessions/security' \
      './sessions/session_systems_control' \
      './sessions/storage' \
      './usr/bin' \
      './usr/lib' \
      './usr/local' \
      './usr/sbin' \
      './usr/share' \
      './usr/var' \
      './common/governance/__pycache__' \
      './common/security/__pycache__' \
      './common/server-tools/__pycache__' \
      './common/tor/__pycache__' \
      './configs/container/admin' \
      './configs/container/auth' \
      './configs/container/base' \
      './configs/container/blockchain' \
      './configs/container/database' \
      './configs/container/electron_gui' \
      './configs/container/gui' \
      './configs/container/node' \
      './configs/container/payment_systems' \
      './configs/container/rdp' \
      './configs/container/server' \
      './configs/container/sessions' \
      './configs/container/storage' \
      './configs/container/tor' \
      './configs/database/elasticsearch' \
      './configs/database/redis' \
      './configs/docker/distroless' \
      './configs/docker/docs' \
      './configs/docker/multi-stage' \
      './configs/pi/ssh' \
      './database/admin/__pycache__' \
      './database/api/__pycache__' \
      './database/config/__pycache__' \
      './database/elasticsearch/__pycache__' \
      './database/models/__pycache__' \
      './database/mongodb/__pycache__' \
      './database/redis/__pycache__' \
      './database/repositories/__pycache__' \
      './database/schema/__pycache__' \
      './database/services/__pycache__' \
      './database/services/backup' \
      './database/services/migration' \
      './database/services/monitoring' \
      './etc/apt/apt.conf.d' \
      './etc/ssl/certs' \
      './service_configs/kubernetes/03-databases' \
      './sessions/api/__pycache__' \
      './sessions/api/config' \
      './sessions/api/integration' \
      './sessions/core/__pycache__' \
      './sessions/encryption/__pycache__' \
      './sessions/integration/__pycache__' \
      './sessions/pipeline/__pycache__' \
      './sessions/pipeline/integration' \
      './sessions/processor/__pycache__' \
      './sessions/processor/config' \
      './sessions/processor/integration' \
      './sessions/recorder/__pycache__' \
      './sessions/recorder/config' \
      './sessions/recorder/integration' \
      './sessions/security/__pycache__' \
      './sessions/session_systems_control/__pycache__' \
      './sessions/storage/__pycache__' \
      './sessions/storage/config' \
      './usr/lib/python3' \
      './usr/local/bin' \
      './usr/local/lib' \
      './usr/share/elasticsearch' \
      './database/services/backup/__pycache__' \
      './database/services/migration/__pycache__' \
      './database/services/monitoring/__pycache__' \
      './sessions/api/integration/__pycache__' \
      './sessions/pipeline/integration/__pycache__' \
      './sessions/processor/integration/__pycache__' \
      './sessions/recorder/integration/__pycache__' \
      './usr/local/lib/python3.11' \
    ; do \
      printf 'LUCID_X_FILES_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
      touch "$d/.keep"; \
    done
# LUCID_X_FILES_SKELETON_END

# redis-py for healthcheck (install into /build/py-site for COPY into distroless)
RUN python3 -m pip install --no-cache-dir \
        --target /build/py-site \
        "redis==5.0.1" \
    && chmod +x /build/usr/local/bin/start-redis.py /build/usr/local/bin/redis-healthcheck.py \
    && test -f /build/etc/redis.conf.template \
    && test -x /usr/local/bin/redis-server \
    && PYTHONPATH=/build/py-site python3 -c "import redis; print('OK redis py')"

############################
# Stage 2 – Runtime (Distroless Python 3.11)
############################
FROM --platform=$TARGETPLATFORM gcr.io/distroless/python3-debian12:latest

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

WORKDIR /app
LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Redis" \
      org.opencontainers.image.description="Distroless Redis with Python entrypoint for Lucid" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.service="lucid-redis" \
      com.lucid.platform="arm64" \
      com.lucid.cluster="foundation" \
      com.lucid.security="distroless"

ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH=/app/usr/local/bin:/app/usr/bin:/app/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/usr/local/lib/python3.11/site-packages \
    LANG=C \
    LC_ALL=C \
    LUCID_HOST_CONFIG_SERVICE_NAME=lucid_redis \
    LUCID_SERVICE_HOST_IP=172.20.10.67 \
    LUCID_SERVICE_HTTP_PATH=http://lucid-redis:6379/app \
    REDIS_PASSWORD=${REDIS_PASSWORD} \
    REDIS_MAX_MEMORY="512mb" \
    REDIS_MAX_MEMORY_POLICY="allkeys-lru" \
    REDIS_PORT=6379 \
    REDIS_BIND_ADDR=0.0.0.0 \
    LD_LIBRARY_PATH=/app/lib:/app/usr/lib:/app/usr/local/lib
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=redis-builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=redis-builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=redis-builder --chown=65532:65532 /build/database/ /app/database/
COPY --from=redis-builder --chown=65532:65532 /build/etc/ /app/etc/
COPY --from=redis-builder --chown=65532:65532 /build/service_configs/ /app/service_configs/
COPY --from=redis-builder --chown=65532:65532 /build/sessions/ /app/sessions/
COPY --from=redis-builder --chown=65532:65532 /build/usr/ /app/usr/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN

# redis-server + dynamic linker + libs from redis:7.2 builder (after apt)
COPY --from=redis-builder --chown=65532:65532 /etc/ssl/ /app/etc/ssl/
COPY --from=redis-builder --chown=65532:65532 /bin/ /app/bin/
COPY --from=redis-builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
COPY --from=redis-builder --chown=65532:65532 /usr/local/bin/ /app/usr/local/bin/
COPY --from=redis-builder --chown=65532:65532 /sbin/ /app/sbin/
COPY --from=redis-builder --chown=65532:65532 /lib/ /app/lib/
COPY --from=redis-builder --chown=65532:65532 /usr/lib/ /app/usr/lib/
COPY --from=redis-builder --chown=65532:65532 /usr/local/lib/ /app/usr/local/lib/
COPY --from=redis-builder --chown=65532:65532 /usr/lib/python3.11/ /app/usr/lib/python3.11/

# Lucid scripts + template (after /usr/local/bin tree so redis-server stays, scripts added/overwritten paths are only our two files)
COPY --from=redis-builder --chown=65532:65532 /build/usr/local/bin/start-redis.py /app/usr/local/bin/start-redis.py
COPY --from=redis-builder --chown=65532:65532 /build/usr/local/bin/redis-healthcheck.py /app/usr/local/bin/redis-healthcheck.py
COPY --from=redis-builder --chown=65532:65532 /build/etc/redis.conf.template /app/etc/redis.conf.template
COPY --from=redis-builder --chown=65532:65532 /build/py-site/ /app/py-site/

COPY --from=redis-builder --chown=65532:65532 /build/infrastructure/ /app/infrastructure/
COPY --from=redis-builder --chown=65532:65532 /build/scripts/ /app/scripts/


COPY --from=redis-builder --chown=65532:65532 /build/usr/local/bin/start-redis.py /app/usr/local/bin/start-redis.py
COPY --from=redis-builder --chown=65532:65532 /build/usr/local/bin/redis-healthcheck.py /app/usr/local/bin/redis-healthcheck.py
COPY --from=redis-builder --chown=65532:65532 /build/etc/redis.conf.template /app/etc/redis.conf.template


EXPOSE 6379

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["/app/usr/bin/python3.11", "/app/usr/local/bin/redis-healthcheck.py"]

USER 65532:65532

ENTRYPOINT ["/app/usr/bin/tini", "--"]

CMD ["/app/usr/bin/python3.11", "/app/usr/local/bin/start-redis.py"]
