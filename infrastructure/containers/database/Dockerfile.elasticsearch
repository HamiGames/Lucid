############################
# Use global ARG TARGETPLATFORM (lines above); bare ARG TARGETPLATFORM before FROM can be empty.
FROM --platform=$TARGETPLATFORM elasticsearch:8.11.0 AS es-builder

WORKDIR /build

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        curl \
        tini \
        build-essential \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
        libpq-dev \
        pkg-config \
        curl \
        libcurl4-openssl-dev \
        python3.11 \
        python3.11-pip \
        python3.11-setuptools \
        python3.11-wheel \
        tini \
        xxd \
        openssl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

