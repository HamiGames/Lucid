COPY configs/alignment-mats/ ./configs/alignment-mats/
COPY configs/database/elasticsearch/ ./configs/database/elasticsearch/
COPY database/elasticsearch/ ./database/elasticsearch/
COPY common/ ./common/
COPY infrastructure/containers/config-listings.json ./infrastructure/containers/config-listings.json
COPY infrastructure/containers/host-config.yml ./infrastructure/containers/host-config.yml
COPY infrastructure/containers/services/middle-ware/master-endpoint.yml ./infrastructure/containers/services/middle-ware/master-endpoint.yml
COPY infrastructure/containers/services/storage/elasticsearch-storage.yml ./infrastructure/containers/services/storage/elasticsearch-storage.yml
COPY infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml ./infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml
COPY infrastructure/compose/ ./infrastructure/compose/
COPY infrastructure/service_mesh/communication/ ./infrastructure/service_mesh/communication/
COPY infrastructure/service_mesh/discovery/ ./infrastructure/service_mesh/discovery/
COPY infrastructure/service_mesh/sidecar/ ./infrastructure/service_mesh/sidecar/
COPY configs/all-operation-configs.json ./configs/all-operation-configs.json
COPY /usr/bin/ /build/usr/bin/
COPY  /usr/lib/*/ /build//usr/lib/*/

COPY /usr/share/elasticsearch/config/ /build/usr/share/elasticsearch/config/
COPY /usr/share/elasticsearch/data/ /build/usr/share/elasticsearch/data/
COPY /usr/share/elasticsearch/logs/ /build/usr/share/elasticsearch/logs/
COPY /usr/share/elasticsearch/plugins/ /build/usr/share/elasticsearch/plugins/
COPY /usr/share/elasticsearch/modules/ /build/usr/share/elasticsearch/modules/
COPY /usr/share/elasticsearch/bin/ /build/usr/share/elasticsearch/bin/
COPY /etc/ssl/ /build/etc/ssl/
COPY /etc/ssl/certs/ /build/etc/ssl/certs/
COPY /etc/ssl/certs/ca-certificates.crt /build/etc/ssl/certs/ca-certificates.crt
COPY /etc/passwd /build/etc/passwd
COPY /etc/group /build/etc/group
COPY /etc/host.conf /build/etc/host.conf
COPY /etc/hostname /build/etc/hostname
COPY /etc/resolv.conf /build/etc/resolv.conf
COPY /etc/hosts /build/etc/hosts

COPY infrastructure/kubernetes/ ./infrastructure/kubernetes/
COPY sessions/storage/ ./sessions/storage/
COPY scripts/ ./scripts/
COPY tools/ ./tools/
COPY utils/ ./utils/


RUN cat > ./usr/share/elasticsearch/config/elasticsearch.yml <<'EOFCONFIG'
cluster.name: lucid-cluster
node.name: lucid-node
discovery.type: single-node
xpack.security.enabled: false
xpack.security.enrollment.enabled: false
xpack.security.http.ssl.enabled: false
xpack.security.transport.ssl.enabled: false
bootstrap.memory_lock: false
network.host: lucid-pi-network
http.port: 9200
transport.port: 9300
EOFCONFIG

RUN ./usr/share/elasticsearch/bin/elasticsearch-keystore create && \
    chown elasticsearch:elasticsearch ./usr/share/elasticsearch/config/elasticsearch.keystore && \
    echo "✅ Elasticsearch keystore created during build"

RUN chmod 644 /usr/share/elasticsearch/config/elasticsearch.yml
RUN chown elasticsearch:elasticsearch /usr/share/elasticsearch/config/elasticsearch.yml
RUN echo "✅ Elasticsearch config copied and permissions set"

RUN test -f /usr/share/elasticsearch/bin/elasticsearch && \
    test -f /usr/share/elasticsearch/config/elasticsearch.yml && \
    test -f /usr/share/elasticsearch/config/elasticsearch.keystore && \
    test -f /etc/ssl/certs/ca-certificates.crt && \
    echo "✅ Elasticsearch builder artifacts verified"

# Export glibc + arch libs for distroless root overlay (multi-arch via dpkg-architecture)
RUN MULTIARCH=$(dpkg-architecture -qDEB_HOST_MULTIARCH) && \
    mkdir -p "/export/rootfs/lib/${MULTIARCH}" >> ./export/rootfs/lib64/.keep && \
    cp -a "/lib/${MULTIARCH}/." "/export/rootfs/lib/${MULTIARCH}/" >> ./export/rootfs/lib/${MULTIARCH}/.keep && \
    if [ -f /lib/ld-linux-aarch64.so.1 ]; then cp /lib/ld-linux-aarch64.so.1 ./export/rootfs/lib/ >>./export/rootfs/lib/.keep; fi && \
    if [ -f /lib64/ld-linux-x86-64.so.2 ]; then cp /lib64/ld-linux-x86-64.so.2 ./export/rootfs/lib64/ >>./export/rootfs/lib64/.keep; fi && \
    echo "✅ Exported dynamic linker layout for ${MULTIARCH}"

############################
# Stage 2 – Runtime (Distroless Java 17)
############################
FROM --platform=$TARGETPLATFORM gcr.io/distroless/java17-debian12:latest

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

WORKDIR /app

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Elasticsearch" \
      org.opencontainers.image.description="Distroless Elasticsearch search engine for Lucid" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.service="lucid-elasticsearch" \
      com.lucid.platform="arm64" \
      com.lucid.security="distroless" \
      com.lucid.cluster="foundation" \
      com.lucid.elasticsearch.version="8.11.0"

ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    ES_HOME=/app/usr/share/elasticsearch \
    PATH=/app/usr/share/elasticsearch/bin:/app/usr/bin:/app/bin \
    CLUSTER_NAME=lucid-cluster \
    NODE_NAME=lucid-node \
    DISCOVERY_TYPE=single-node \
    XPACK_SECURITY_ENABLED=false \
    LUCID_HOST_CONFIG_SERVICE_NAME=lucid_elasticsearch_http \
    LUCID_SERVICE_HOST_IP=172.20.10.68 \
    LUCID_SERVICE_HTTP_PATH=http://lucid-elasticsearch-http:9200/app \
    LUCID_ELASTICSEARCH_TRANSPORT_HOST_IP=172.20.10.69 \
    LUCID_ELASTICSEARCH_TRANSPORT_SERVICE_PATH=http://lucid-elasticsearch-transport:9300/app
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN

COPY --from=es-builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=es-builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=es-builder --chown=65532:65532 /build/infrastructure/service_mesh/ /app/infrastructure/service_mesh/
COPY --from=es-builder --chown=65532:65532 /build/sessions/ /app/sessions/
COPY --from=es-builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=es-builder --chown=65532:65532 /build/tools/ /app/tools/
COPY --from=es-builder --chown=65532:65532 /build/utils/ /app/utils/

COPY --from=es-builder --chown=root /build/usr/ /app/usr/
COPY --from=es-builder --chown=root /build/bin/ /app/bin/
COPY --from=es-builder --chown=root /build/var/ /app/var/
COPY --from=es-builder --chown=root /build/run/ /app/run/
COPY --from=es-builder --chown=root /build/bin/ /app/bin/
COPY --from=es-builder --chown=root /build/etc/ /app/etc/
COPY --from=es-builder --chown=root /build/dev/ /app/dev/
COPY --from=es-builder --chown=root /build/export/ /app/export/
COPY --from=es-builder --chown=root /build/lib/ /app/lib/
COPY --from=es-builder --chown=root /build/local/ /app/local/
COPY --from=es-builder --chown=root /build/sbin/ /app/sbin/



RUN test -d /app/usr/share/elasticsearch || { echo "CRITICAL: elasticsearch directory missing"; exit 1; } && \
    test -f /app/usr/share/elasticsearch/bin/elasticsearch || { echo "CRITICAL: elasticsearch binary missing"; exit 1; } && \
    test -f /app/usr/share/elasticsearch/config/elasticsearch.yml || { echo "CRITICAL: elasticsearch config missing"; exit 1; } && \
    test -f /app/usr/share/elasticsearch/config/elasticsearch.keystore || { echo "CRITICAL: keystore missing"; exit 1; } && \
    test -f /app/usr/bin/bash || { echo "CRITICAL: bash missing"; exit 1; } && \
    test -f /app/usr/bin/tini || { echo "CRITICAL: tini missing"; exit 1; } && \
    test -f /app/usr/bin/curl || { echo "CRITICAL: curl missing"; exit 1; } && \
    test -f /app/etc/ssl/certs/ca-certificates.crt || { echo "CRITICAL: CA bundle missing"; exit 1; } && \
    echo "✅ Elasticsearch runtime verification passed"

EXPOSE 9200 9300

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["/app/usr/bin/curl", "-f", "http://127.0.0.1:9200/_cluster/health"]

USER 65532:65532

# ES_JAVA_OPTS from compose (e.g. heap) must apply; configs/database/elasticsearch/elasticsearch.yml documents compose env for JVM.
USER root

USER elasticsearch
USER root

ENTRYPOINT ["/app/usr/bin/tini", "--", "/app/usr/bin/bash", "-c", "exec /app/usr/share/elasticsearch/bin/elasticsearch"]
CMD []
SHELL ["/app/usr/bin/bash", "-c"]
