# syntax=docker/dockerfile:1.5
# File: infrastructure/containers/database/Dockerfile.mongodb
#
# LUCID MONGODB — Distroless Python + mongod/mongosh
# Rewritten to follow 03_api_gateway/Dockerfile (ARGs, markers, /build export, /app runtime, tini, USER 65532)
# Image: pickme/lucid-mongodb:latest-arm64
# Port: 27017
# Builder: mongo:7.0 (WiredTiger + multiarch lib paths). Multi-arch: DEBIAN_MULTIARCH=x86_64-linux-gnu for amd64.
# Build context: repository root

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG PYTHON_VERSION=3.11
ARG DEBIAN_MULTIARCH=aarch64-linux-gnu

############################
# Stage 1 – Builder (MongoDB binaries + export tree under /build)
############################
# Use global ARG TARGETPLATFORM/BUILDPLATFORM (lines above); do not redeclare bare ARG here —
# that yields empty TARGETPLATFORM with plain docker build and breaks FROM --platform=.
FROM --platform=$TARGETPLATFORM mongo:7.0 AS builder

WORKDIR /build

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
        libpq-dev \
        pkg-config \
        curl \
        libcurl4-openssl-dev \
        python3.11 \
        python3.11-dev \
        python3.11-pip \
        python3.11-setuptools \
        python3.11-wheel \
        tini \
        openssl \
        xxd \
        bash \
        cargo \
        rustc \
        openssl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && dpkg --configure -a --force-unsafe-io --no-triggers 2>/dev/null || true
# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
