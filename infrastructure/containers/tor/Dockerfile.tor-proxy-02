  chown -R debian-tor:debian-tor /build/infrastructure/containers/services/host-config.yml /build/configs/host-config.yml; \
  chown -R debian-tor:debian-tor /build/service_configs/tor/docker-compose.proxy-systems.yml /build/service_configs/tor/tor-operational-layout.yml /build/service_configs/tor/tunnel-tools.yml /build/service_configs/tor/tor-socks.yml; \
  chown -R debian-tor:debian-tor /build/scripts/lib/lucid-host-config-path.sh /build/scripts/lib/lucid-x-file-paths.sh; \
  chown -R debian-tor:debian-tor /build/configs/x-files.json; \
  chown -R debian-tor:debian-tor /build/infrastructure/containers/services/host-config.yml /build/configs/host-config.yml; \
  chown -R debian-tor:debian-tor /build/service_configs/tor/docker-compose.proxy-systems.yml /build/service_configs/tor/tor-operational-layout.yml /build/service_configs/tor/tunnel-tools.yml /build/service_configs/tor/tor-socks.yml; \
  find /build/02_network_security/tor/scripts -type f -name '*.sh' -exec chmod 0755 {} +; \
  find /build/02_network_security/tor -maxdepth 1 -type f -name '*.sh' -exec chmod 0755 {} +; \
  chmod 0755 /build/scripts/lib/*.sh; \
  for op in dig host tor-gencert tor-resolve tor-print-ed-signing-cert; do \
    if [ -x "/build/usr/bin/${op}" ]; then install -m 0755 "/build/usr/bin/${op}" "/build/bin/${op}"; fi; \
  done; \
  install -d -o debian-tor -g debian-tor -m 0755 /build/run/lucid/tor/log /build/run/lucid/tunnels/scripts /build/run/lucid/onion; \
  chown -R debian-tor:debian-tor /build/run/lucid /build/var/lib/tor /build/tor /build/02_network_security/tor /build/02_network_security/tunnels; \
  chown -R debian-tor:debian-tor /build/scripts /build/configs /build/infrastructure /build/02_network_security ; \
  chown -R debian-tor:debian-tor /build/tmp/lucid; \
  echo "tor-builder OK."
# end of install content OK.

RUN set -eux; \
    test -f /build/02_network_security/tor/.keep; \
    test -x /build/bin/tor && test -x /build/bin/bash && test -x /build/bin/tini && test -x /build/bin/busybox; \
    test -x /build/bin/awk && test -x /build/bin/grep && test -x /build/bin/sed; \
    test -x /build/run/lucid/tunnels/scripts/create-ephemeral-onion.sh; \
    grep -q "LUCID_TOR_PROXY" /build/var/lib/tor/.keep; \
    test -r /build/opt/share/tor/geoip || test -r /build/opt/share/tor/geoip6; \
    test -x /build/run/lucid/tor/bin/tor_entrypoint.sh; \
    test -x /build/run/lucid/tor/scripts/set_host_config.sh; \
    grep -q "GeoIPFile /app/opt/share/tor/geoip" /build/run/lucid/tor/torrc; \
    echo "tor-builder OK."

# =============================================================================
# STAGE 2 — distroless (Debian 12 bookworm == base-debian12)
# =============================================================================
FROM --platform=$TARGETPLATFORM gcr.io/distroless/base-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
ARG PUBLIC_TOR_IP
ARG LUCID_INTERNAL_NETWORK_NAME
ARG LUCID_TOR_EGRESS_NETWORK_NAME

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Tor SOCKS proxy (distroless)" \
      org.opencontainers.image.description="Tor proxy: /app layout, 02_network_security/tor + scripts/lib, distroless Debian 12 (base-debian12)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="tor-socks" \
      com.lucid.layer="0" \
      org.lucid.layer="0" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="9050,9051,8888" \
      com.lucid.cluster="foundation" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.tunnel-tools,.env.foundation" \
      com.lucid.tor.inherent="true" \
      com.lucid.tor.system="gcr-distroless-base-debian12" \
      com.lucid.distroless.debian="12-bookworm" \
      com.lucid.service_id="com.lucid.dockerfile.v1.tor-proxy-02.infrastructure.containers.tor" \
      org.lucid.service_id="org.lucid.dockerfile.v1:infrastructure/containers/tor/Dockerfile.tor-proxy-02"

ENV PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH="/app/run/lucid/tor/bin:/app/run/lucid/tor/scripts:/app/bin:/app/sbin:/app/lib:/app/share/tor:/app/bin" \
    LD_LIBRARY_PATH="/app/lib" \
    SSL_CERT_FILE="/app/run/lucid/ssl/certs/ca-certificates.crt" \
    CURL_CA_BUNDLE="/app/run/lucid/ssl/certs/ca-certificates.crt" \
    LANG="C.UTF-8" \
    LC_ALL="C.UTF-8" \
    LUCID_HOST_CONFIG_PATH="/app/configs/host-config.yml" \
    LUCID_HOST_CONFIG_SERVICE_NAME="tor_socks" \
    LUCID_HOST_CONFIG_STABLE_ID="tor_socks" \
    LUCID_SERVICES_CONFIG_DIR="/app/service_configs" \
    LUCID_SERVICES_CONFIG_ROOT="/app/service_configs" \
    LUCID_SERVICE_NAME="tor-socks" \
    LUCID_SERVICE_PORT="9050" \
    TOR_CONTROL_HOST="127.0.0.1" \
    TOR_CONTROL_PORT="9051" \
    TOR_DATA_DIR="/app/var/lib/tor" \
    TOR_ONION_SERVICE_DIR="/app/run/lucid/onion" \
    TOR_SOCKS_PORT="9050"

WORKDIR /app

COPY --from=tor-builder --chown=65532:65532 /build/export-dynlink/ /app/export-dynlink/
COPY --from=tor-builder --chown=65532:65532 /build/opt/ /app/opt/
COPY --from=tor-builder --chown=65532:65532 /build/etc/ /app/etc/
COPY --from=tor-builder --chown=65532:65532 /build/tmp/ /app/tmp/
COPY --from=tor-builder --chown=65532:65532 /build/var/ /app/var/
COPY --from=tor-builder --chown=65532:65532 /build/lib/ /app/lib/
COPY --from=tor-builder --chown=65532:65532 /build/lib64/ /app/lib64/
COPY --from=tor-builder --chown=65532:65532 /build/run/ /app/run/
COPY --from=tor-builder --chown=65532:65532 /build/02_network_security/ /app/02_network_security/
COPY --from=tor-builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=tor-builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=tor-builder --chown=65532:65532 /build/infrastructure/ /app/infrastructure/
COPY --from=tor-builder --chown=65532:65532 /build/usr/ /app/usr/
COPY --from=tor-builder --chown=65532:65532 /build/bin/ /app/bin/


EXPOSE 9050 9051 8888

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD ["/app/bin/bash", "/app/run/lucid/tor/bin/tor-health.sh"]

USER debian-tor

ENTRYPOINT ["/app/bin/tini", "--"]
CMD ["/app/bin/bash", "/app/run/lucid/tor/bin/tor_entrypoint.sh"]
