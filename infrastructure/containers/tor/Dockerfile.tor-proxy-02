  install -m 0755 02_network_security/tor/scripts/create_dynamic_onion.sh /build/opt/share/tor/bin/create-dynamic-onion.sh; \
  install -m 0755 02_network_security/tor/scripts/check_tor_bootstrap.sh /build/opt/share/tor/bin/check-tor-bootstrap.sh; \
  install -m 0755 02_network_security/tor/scripts/start_tor.sh /build/opt/share/tor/bin/start-tor.sh; \
