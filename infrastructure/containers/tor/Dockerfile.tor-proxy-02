    '/build/usr/share/keyrings' \
    '/build/usr/share/numpy3' \
    '/build/usr/share/obfs4proxy' \
    '/build/usr/local/share' \
    '/build/usr/local/bin' \
    '/build/usr/local/sbin' \
    '/build/usr/local/lib' \
    '/build/usr/sbin' \
    '/build/bin/bash' \
    '/build/bin/busybox' \
    '/build/bin/mkdir' \
    '/build/bin/sleep' \
    '/build/bin/tail' \
    '/build/bin/chmod' \
    '/build/bin/chown' \
    '/build/bin/rm' \
    '/build/bin/nc' \
    '/build/bin/xxd' \
    '/build/bin/curl' \
    '/build/bin/jq' \
    '/build/bin/adduser' \
    '/build/bin/timeout' \
    '/build/sbin/ldconfig' \
    '/build/sbin/openvpn' \
    '/build/sbin/openssh' \
    '/build/sbin/tor' \
    '/build/sbin/obfs4proxy' \
    '/build/sbin/tini' \
    '/build/sbin/gosu' \
    '/build/sbin/nc' \
    '/build/sbin/xxd' \
    '/build/sbin/curl' \
    '/build/opt' \
    '/build/opt/share' \
    '/build/opt/share/tor' \
    '/build/opt/share/ssl-cert' \
    '/build/opt/share/ca-certificates' \
    '/build/opt/share/keyrings' \
    '/build/opt/share/obfs4proxy' \
    '/build/etc' \
    '/build/etc/tor' \
    '/build/etc/tor/torrc' \
    '/build/etc/tor/tunnels' \
    '/build/etc/tor/tunnels/scripts' \
    '/build/etc/ssl' \
    '/build/etc/ssl/certs' \
    '/build/etc/ssl/private' \
    '/build/etc/ssl/public' \
    '/build/etc/ssl/certs/ca-certificates.crt' \
    '/build/var/run' \
    '/build/var/run/lucid' \
    '/build/var/run/lucid/tor' \
    '/build/var/run/lucid/tunnels' \
    '/build/var/run/lucid/onion' \
    '/build/var/run/lucid/ssl' \
    '/build/var/run/lucid/ssl/certs' \
    '/build/var/run/lucid/ssl/private' \
    '/build/var/run/lucid/ssl/public' \
    '/build/02_network_security/tor/scripts' \
    '/build/scripts/lib' \
    '/build/infrastructure/containers/services' \
    '/build/service_configs/tor' \
    '/build/run/lucid/tor/bin' \
    '/build/run/lucid/tor/scripts' \
    '/build/run/lucid/tor/log' \
    '/build/run/lucid/tunnels/scripts' \
    '/build/run/lucid/onion' \
    '/build/run/lucid/ssl/certs' \
    '/build/export-dynlink' \
    '/build/export-dynlink/root' \
    '/build/export-dynlink/root/lib' \
    '/build/lib/ld-linux-aarch64.so.1' \
    '/build/export-dynlink/root/lib64' \
    '/build/lib/aarch64-linux-gnu'; do \
    mkdir -p "/build/${d}"; printf 'LUCID_X_FILES_%s\n' "$(date +%s)" > "/build/${d}/.keep"; \
  done
# LUCID_X_FILES_SKELETON_END


