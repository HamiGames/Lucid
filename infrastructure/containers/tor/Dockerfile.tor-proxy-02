# syntax=docker/dockerfile:1.5
# File: infrastructure/containers/tor/Dockerfile.tor-proxy-02
#
# Distroless Tor proxy: runtime root is /app (WORKDIR /app). Canonical source tree:
#   /app/02_network_security/tor/**     — full repo tor directory (paths match script headers)
#   /app/run/lucid/tor/**              — operational torrc, logs, bin helpers
#   /app/run/lucid/tor/scripts/**      — all 02_network_security/tor/scripts/*.sh
#   /app/scripts/lib/**                — repo scripts/lib support (host-config / x-files helpers)
#   /app/opt/share/tor                 — GeoIP (+ tor-geoipdb), referenced by torrc
#
# Final base: Google distroless Debian 12 userspace is published as:
#   gcr.io/distroless/base-debian12:latest
# (There is no gcr.io/distroless/debian-12 image; base-debian12 is Bookworm / Debian 12.)
#
# Build (repository root = context):
#   docker build -f infrastructure/containers/tor/Dockerfile.tor-proxy-02 -t lucid/tor-proxy-02:latest .
#
ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=2.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

# =============================================================================
# STAGE 1 — tor-builder
# =============================================================================
FROM --platform=$TARGETPLATFORM debian:12-slim AS tor-builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
ARG PUBLIC_TOR_IP
ARG LUCID_INTERNAL_NETWORK_NAME
ARG LUCID_TOR_EGRESS_NETWORK_NAME

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
      adduser \
      bash \
      busybox \
      ca-certificates \
      coreutils \
      curl \
      dnsutils \
      gosu \
      jq \
      mawk \
      netcat-openbsd \
      obfs4proxy \
      tini \
      tor \
      tor-geoipdb \
      xxd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && adduser --disabled-password --shell /bin/bash --gecos "" lucid

RUN set -eux; \
    for bin in /usr/bin/tor /usr/bin/tini; do \
      missing=$(ldd "$bin" 2>&1 | grep "not found" || true); \
      if [ -n "$missing" ]; then echo "MISSING in $bin:"; echo "$missing"; exit 1; fi; \
    done; \
    if ldd /usr/bin/obfs4proxy 2>&1 | grep -q "not a dynamic"; then :; \
    else \
      missing=$(ldd /usr/bin/obfs4proxy 2>&1 | grep "not found" || true); \
      if [ -n "$missing" ]; then echo "MISSING in obfs4proxy:"; echo "$missing"; exit 1; fi; \
    fi

WORKDIR /build

# LUCID_X_FILES_SKELETON_BEGIN
RUN set -eux; \
  for d in \
    02_network_security/tor/scripts \
    scripts/lib \
    configs \
    infrastructure/containers/services \
    service_configs/tor \
    run/lucid/tor/bin \
    run/lucid/tor/scripts \
    run/lucid/tor/log \
    run/lucid/tunnels/scripts \
    run/lucid/onion \
    run/lucid/ssl/certs; do \
    mkdir -p "$d"; printf 'LUCID_X_FILES_%s\n' "$(date +%s)" > "$d/.keep"; \
  done
# LUCID_X_FILES_SKELETON_END

RUN set -eux; \
    install -d -o debian-tor -g debian-tor -m 0755 run/lucid \
    && install -d -o debian-tor -g debian-tor -m 0755 run/lucid/onion \
    && install -d -o debian-tor -g debian-tor -m 0700 run/lucid/tor \
    && install -d -o root       -g root       -m 0755 run/lucid/tor/bin \
    && install -d -o root       -g root       -m 0755 run/lucid/tor/scripts \
    && printf 'dir=run/lucid/tor/bin\nplatform=lucid-tor-proxy\n' > run/lucid/tor/bin/.keep \
    && printf 'dir=run/lucid/tor\nplatform=lucid-tor-proxy\n' > run/lucid/tor/.keep \
    && printf 'dir=run/lucid/onion\nplatform=lucid-tor-proxy\n' > run/lucid/onion/.keep \
    && printf 'dir=run/lucid\nplatform=lucid-tor-proxy\n' > run/lucid/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_admin \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_admin/authorized_clients \
    && printf 'service=lucid_admin\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_admin/.keep \
    && printf 'service=lucid_admin\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_admin/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_vm \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_vm/authorized_clients \
    && printf 'service=lucid_vm\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_vm/.keep \
    && printf 'service=lucid_vm\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_vm/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_node \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_node/authorized_clients \
    && printf 'service=lucid_node\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_node/.keep \
    && printf 'service=lucid_node\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_node/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_blockchain \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_blockchain/authorized_clients \
    && printf 'service=lucid_blockchain\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_blockchain/.keep \
    && printf 'service=lucid_blockchain\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_blockchain/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_governance \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_governance/authorized_clients \
    && printf 'service=lucid_governance\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_governance/.keep \
    && printf 'service=lucid_governance\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_governance/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_payment \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_payment/authorized_clients \
    && printf 'service=lucid_payment\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_payment/.keep \
    && printf 'service=lucid_payment\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_payment/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_session \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_session/authorized_clients \
    && printf 'service=lucid_session\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_session/.keep \
    && printf 'service=lucid_session\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_session/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_rdp \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_rdp/authorized_clients \
    && printf 'service=lucid_rdp\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_rdp/.keep \
    && printf 'service=lucid_rdp\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_rdp/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_wallet \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_wallet/authorized_clients \
    && printf 'service=lucid_wallet\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_wallet/.keep \
    && printf 'service=lucid_wallet\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_wallet/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_voting \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_voting/authorized_clients \
    && printf 'service=lucid_voting\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_voting/.keep \
    && printf 'service=lucid_voting\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_voting/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_voting_system \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_voting_system/authorized_clients \
    && printf 'service=lucid_voting_system\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_voting_system/.keep \
    && printf 'service=lucid_voting_system\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_voting_system/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_voting_system_admin \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_voting_system_admin/authorized_clients \
    && printf 'service=lucid_voting_system_admin\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_voting_system_admin/.keep \
    && printf 'service=lucid_voting_system_admin\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_voting_system_admin/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_voting_system_admin_admin \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_voting_system_admin_admin/authorized_clients \
    && printf 'service=lucid_voting_system_admin_admin\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_voting_system_admin_admin/.keep \
    && printf 'service=lucid_voting_system_admin_admin\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_voting_system_admin_admin/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_server \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_server/authorized_clients \
    && printf 'service=lucid_server\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_server/.keep \
    && printf 'service=lucid_server\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_server/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/myservice \
    && install -d -o root -g root -m 0700 run/lucid/tor/myservice/authorized_clients \
    && printf 'service=myservice\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/myservice/.keep \
    && printf 'service=myservice\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/myservice/authorized_clients/.keep \
    && install -d -o root -g root -m 0755 run/lucid/tor/lucid_portal \
    && install -d -o root -g root -m 0700 run/lucid/tor/lucid_portal/authorized_clients \
    && printf 'service=lucid_portal\ntype=hidden-service\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_portal/.keep \
    && printf 'service=lucid_portal\ntype=authorized_clients\nplatform=lucid-tor-proxy\n' > run/lucid/tor/lucid_portal/authorized_clients/.keep \
    && install -d -o debian-tor -g debian-tor -m 0700 /tmp/lucid/tor \
    && install -d -o root       -g root       -m 0755 /tmp/lucid/tor/lucid_admin \
    && printf 'service=lucid_admin\ntype=tmp-scratch\nplatform=lucid-tor-proxy\n' > /tmp/lucid/tor/lucid_admin/.keep \
    && install -d -o root       -g root       -m 0755 /tmp/lucid/tor/tunnels \
    && install -d -o debian-tor -g debian-tor -m 0755 tor \
    && install -d -o debian-tor -g debian-tor -m 0700 var/lib/tor var/lib/tor/hidden_service \
    && install -d -o debian-tor -g debian-tor -m 0755 var/lib/tor/seed \
    && install -d -o root       -g root       -m 0755 etc/tor etc/tor/tunnels \
    && printf 'LUCID_TOR_PROXY_VAR_LIB_TOR\n' > var/lib/tor/.keep \
    && printf 'LUCID_TOR_PROXY_APP_TOR\n' > tor/.keep \
    && printf 'LUCID_TOR_PROXY_ETC_TOR\n' > etc/tor/.keep \
    && install -d -o root -g root -m 0755 opt opt/bin opt/sbin opt/lib opt/share opt/share/tor \
    && printf 'dir=opt\nplatform=lucid-tor-proxy\n' > opt/.keep \
    && printf 'dir=opt/bin\nplatform=lucid-tor-proxy\n' > opt/bin/.keep \
    && printf 'dir=opt/sbin\nplatform=lucid-tor-proxy\n' > opt/sbin/.keep \
    && printf 'dir=opt/lib\nplatform=lucid-tor-proxy\n' > opt/lib/.keep \
    && printf 'dir=opt/share/tor\nplatform=lucid-tor-proxy\n' > opt/share/tor/.keep \
    && chown debian-tor:debian-tor var/lib/tor/.keep tor/.keep run/lucid/.keep run/lucid/onion/.keep run/lucid/tor/.keep run/lucid/tor/bin/.keep

COPY 02_network_security/tor/ ./02_network_security/tor/
COPY 02_network_security/tunnels/ ./02_network_security/tunnels/
COPY scripts/lib/lucid-host-config-path.sh ./scripts/lib/lucid-host-config-path.sh
COPY scripts/lib/lucid-x-file-paths.sh ./scripts/lib/lucid-x-file-paths.sh
COPY configs/x-files.json ./configs/x-files.json
COPY infrastructure/containers/host-config.yml ./infrastructure/containers/services/host-config.yml
COPY infrastructure/containers/host-config.yml ./configs/host-config.yml
COPY infrastructure/containers/tor/docker-compose.proxy-systems.yml ./service_configs/tor/docker-compose.proxy-systems.yml
COPY infrastructure/containers/services/tor/tor-operational-layout.yml ./service_configs/tor/tor-operational-layout.yml
COPY infrastructure/containers/services/tor/tunnel-tools.yml ./service_configs/tor/tunnel-tools.yml
COPY infrastructure/containers/services/tor/tor-socks.yml ./service_configs/tor/tor-socks.yml

RUN set -eux; \
    mkdir -p ./lib ./usr ./bin ./sbin ./opt ./etc ./tmp ./var ./run; \
    for d in \
      '.' \
      './lib/usr'\
      './bin'\
      './bin/tor'\
      './bin/obfs4proxy'\
      './bin/tini'\
      './bin/busybox'\
      './bin/cat'\
      './bin/chmod'\
      './bin/chown'\
      './bin/mkdir'\
      './bin/rm'\
      './sbin'\
      './sbin/gosu'\
      './sbin/tini'\
      './sbin/busybox'\
      './sbin/cat'\
      './sbin/chmod'\
      './sbin/chown'\
      './sbin/mkdir'\
      './sbin/rm'\
      './sbin/sleep'\
      './sbin/tail'\
      './sbin/nc'\
      './sbin/xxd'\
      './sbin/curl'\
      './sbin/jq'\
      './sbin/head'\
      './sbin/cut'\
      './opt'\
      './opt/lucid'\
      './opt/lucid/tor'\
      './opt/lucid/tor/data'\
      './opt/lucid/tor/bin'\
      './opt/lucid/tor/log'\
      './opt/lucid/tor/pid'\
      './opt/lucid/tor/ssl'\
      './opt/lucid/tor/onion'\
      './opt/share'\
      './opt/share/tor'\
      './etc'\
      './etc/tor'\
      './etc/ssl'\
      './etc/ssl/certs'\
      './etc/ssl/private'\
      './etc/ssl/certs/ca-certificates.crt'\
      './etc/ssl/private/ca-certificates.key'\
      './etc/ssl/certs/ca-certificates.crt'\
      './tmp'\
      './tmp/lucid'\
      './tmp/lucid/tor'\
      './tmp/lucid/tunnels'\
      './tmp/lucid/onion'\
      './tmp/lucid/onion/lucid_admin'\
      './tmp/lucid/onion/lucid_api'\
      './tmp/lucid/onion/lucid_auth'\
      './tmp/lucid/onion/lucid_config'\
      './tmp/lucid/onion/lucid_dev'\
      './tmp/lucid/onion/lucid_node'\
      './tmp/lucid/onion/lucid_blockchain'\
      './tmp/lucid/onion/lucid_governance'\
      './tmp/lucid/onion/lucid_payment'\
      './tmp/lucid/onion/lucid_session'\
      './tmp/lucid/onion/lucid_rdp'\
      './tmp/lucid/onion/lucid_wallet'\
      './tmp/lucid/onion/lucid_voting'\
      './var'\
      './var/lib'\
      './var/bin'\
      './var/sbin'\
      './var/opt'\
      './var/etc'\
      './var/tmp'\
      './var/var'\
      './var/lib/tor'\
      './var/lib/tor/lucid_admin'\
      './var/lib/tor/lucid_api'\
      './var/lib/tor/lucid_auth'\
      './var/lib/tor/lucid_config'\
      './var/lib/tor/lucid_dev'\
      './var/lib/tor/lucid_node'\
      './var/lib/tor/lucid_blockchain'\
      './var/lib/tor/lucid_governance'\
      './var/lib/tor/lucid_payment'\
      './var/lib/tor/lucid_session'\
      './var/lib/tor/lucid_rdp'\
      './var/lib/tor/lucid_wallet'\
      './var/lib/tor/lucid_voting'\
      './run/lucid'\
      './run/lucid/tor'\
      './run/lucid/tunnels'\
      './run/lucid/onion'\
      './run/lucid/onion/lucid_admin'\
      './run/lucid/onion/lucid_api'\
      './run/lucid/onion/lucid_auth'\
      './run/lucid/onion/lucid_config'\
      './run/lucid/onion/lucid_dev'\
      './run/lucid/onion/lucid_node'\
      ; do \
      printf 'LUCID_TOR_PROXY_%s' "$(date +%s)" > "${d}/.keep"; \
      touch "${d}/.keep"; \
    done

# end of skeleton

COPY /lib/ ./lib/
COPY /usr/ ./usr/
COPY /bin/ ./bin/
COPY /sbin/ ./sbin/
COPY /opt/ ./opt/
COPY /etc/ ./etc/
COPY /tmp/ ./tmp/
COPY /var/ ./var/
COPY /lib64/ ./lib64/


# Dynamic linker + arch lib dir for TARGETPLATFORM (uname -m inside this stage matches target arch)
RUN set -eux; \
    mkdir -p ./export-dynlink/root/lib ./export-dynlink/root/lib64; \
    arch="$(uname -m)"; \
    case "$arch" in \
      aarch64) \
        cp -a ./lib/ld-linux-aarch64.so.1 ./export-dynlink/root/lib/; \
        cp -a ./lib/aarch64-linux-gnu ./export-dynlink/root/lib/; \
        ;; \
      x86_64) \
        if [ -f ./lib64/ld-linux-x86-64.so.2 ]; then \
          cp -a ./lib64/ld-linux-x86-64.so.2 ./export-dynlink/root/lib64/; \
        else \
          cp -a ./lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 ./export-dynlink/root/lib64/; \
        fi; \
        cp -a ./lib/x86_64-linux-gnu ./export-dynlink/root/lib/; \
        ;; \
      *) echo "unsupported uname -m=$arch"; exit 1 ;; \
    esac

# torrc, GeoIP paths, entrypoints, scripts; populate /build/bin + /build/sbin
RUN set -eux; \
  install -m 0644 ./02_network_security/tor/torrc ./run/lucid/tor/torrc; \
  { printf '\n# Distroless image: GeoIP from tor-geoipdb\n'; \
    printf 'GeoIPFile /app/opt/share/tor/geoip\n'; \
    printf 'GeoIPv6File /app/opt/share/tor/geoip6\n'; \
  } >> ./run/lucid/tor/torrc; \
  install -d -m 0755 ./run/lucid/tor/configs; \
  for f in tor_entrypoint.sh tor-health.sh bootstrap-helper.sh t_entrypoint.sh entrypoint.sh tor-show-onion.sh; do \
    install -m 0755 "./02_network_security/tor/${f}" "./run/lucid/tor/bin/${f}"; \
  done; \
  install -m 0755 ./02_network_security/tor/scripts/create_ephemeral_onion.sh ./run/lucid/tunnels/scripts/create-ephemeral-onion.sh; \
  install -m 0755 ./02_network_security/tor/bootstrap-helper.sh ./run/lucid/tunnels/scripts/bootstrap-helper.sh; \
  for s in check_tor_bootstrap.sh create_dynamic_onion.sh create_ephemeral_onion.sh demo_onion_usage.sh set_host_config.sh start_tor.sh tor_env.sh; do \
    install -m 0755 "./02_network_security/tor/scripts/${s}" "./run/lucid/tor/scripts/${s}"; \
  done; \
  install -d -m 0755 ./02_network_security/tor/scripts/ ./run/lucid/tor/bin/; \
  install -m 0755 ./02_network_security/tor/scripts/create_dynamic_onion.sh ./run/lucid/tor/bin/create-dynamic-onion.sh; \
  install -m 0755 ./02_network_security/tor/scripts/check_tor_bootstrap.sh ./run/lucid/tor/bin/check-tor-bootstrap.sh; \
  install -m 0755 ./02_network_security/tor/scripts/start_tor.sh ./run/lucid/tor/bin/start-tor.sh; \
  install -m 0755 ./02_network_security/tor/scripts/create_ephemeral_onion.sh ./run/lucid/tor/bin/create-ephemeral-onion.sh; \
  find ./02_network_security/tor/scripts -type f -name '*.sh' -exec chmod 0755 {} +; \
  find ./02_network_security/tor -maxdepth 1 -type f -name '*.sh' -exec chmod 0755 {} +; \
  chmod 0755 ./scripts/lib/*.sh; \
  install -d -m 0755 bin sbin opt usr etc tmp build lib lib64; \
  install -m 0755 ./usr/bin/tor /build/usr/bin/tor; \
  install -m 0755 ./usr/bin/obfs4proxy /build/usr/bin/obfs4proxy; \
  install -m 0755 ./usr/bin/tini /build/usr/bin/tini; \
  install -m 0755 ./usr/sbin/gosu /build/usr/sbin/gosu; \
  install -m 0755 ./bin/bash /build/bin/bash; \
  install -m 0755 ./bin/busybox /build/usr/bin/busybox; \
  install -m 0755 ./bin/cat /build/bin/cat; \
  install -m 0755 ./bin/chmod /build/bin/chmod; \
  install -m 0755 ./bin/chown /build/bin/chown; \
  install -m 0755 ./bin/mkdir /build/bin/mkdir; \
  install -m 0755 ./bin/rm /build/bin/rm; \
  install -m 0755 ./bin/sleep /build/bin/sleep; \
  install -m 0755 ./bin/tail /build/bin/tail; \
  install -m 0755 ./usr/bin/curl /build/usr/bin/curl; \
  install -m 0755 ./usr/bin/jq /build/usr/bin/jq; \
  install -m 0755 ./bin/nc /build/bin/nc; \
  install -m 0755 ./usr/bin/timeout /build/usr/bin/timeout; \
  install -m 0755 ./usr/bin/xxd /build/usr/bin/xxd; \
  install -m 0755 ./usr/bin/mawk /build/usr/bin/awk; \
  install -m 0755 ./bin/grep /build/bin/grep; \
  install -m 0755 ./bin/sed /build/bin/sed; \
  install -m 0755 ./usr/bin/head /build/usr/bin/head; \
  install -m 0755 ./usr/bin/cut /build/bin/cut; \
  install -m 0755 ./usr/bin/tr /build/usr/bin/tr; \
  install -m 0755 ./usr/bin/seq /build/usr/bin/seq; \
  for op in dig host tor-gencert tor-resolve tor-print-ed-signing-cert; do \
    if [ -x "./usr/bin/${op}" ]; then install -m 0755 "./usr/bin/${op}" "./build/bin/${op}"; fi; \
  done; \
  install -d -o debian-tor -g debian-tor -m 0755 ./run/lucid/tor/log ./run/lucid/tunnels/scripts ./run/lucid/onion; \
  chown -R debian-tor:debian-tor ./run/lucid ./var/lib/tor ./tor ./02_network_security/tor; \
  chown -R debian-tor:debian-tor ./scripts ./configs ./infrastructure ./02_network_security ; \
  chown -R debian-tor:debian-tor ./tmp/lucid

RUN set -eux; \
    test -f ./02_network_security/tor/keep.txt; \
    test -x /build/bin/tor && test -x /build/bin/bash && test -x /build/bin/tini && test -x /build/bin/busybox; \
    test -x /build/bin/awk && test -x /build/bin/grep && test -x /build/bin/sed; \
    for dir in \
      ./var/lib/tor \
      ./run/lucid \
      ./run/lucid/tor \
      ./run/lucid/tor/scripts \
      ./run/lucid/tor/tunnels \
      ./02_network_security/tor/scripts \
      ./02_network_security/tor; do \
      test -d "./${dir}" || exit 1; \
    done; \
    grep -q "LUCID_TOR_PROXY" ./var/lib/tor/.keep; \
    test -r ./opt/share/tor/geoip || test -r ./opt/share/tor/geoip6; \
    test -x ./run/lucid/tor/bin/tor_entrypoint.sh; \
    test -x ./run/lucid/tor/scripts/set_host_config.sh; \
    grep -q "GeoIPFile /app/opt/share/tor/geoip" ./run/lucid/tor/torrc; \
    echo "tor-builder OK."

# =============================================================================
# STAGE 2 — distroless (Debian 12 bookworm == base-debian12)
# =============================================================================
FROM --platform=$TARGETPLATFORM gcr.io/distroless/base-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
ARG PUBLIC_TOR_IP
ARG LUCID_INTERNAL_NETWORK_NAME
ARG LUCID_TOR_EGRESS_NETWORK_NAME

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Tor SOCKS proxy (distroless)" \
      org.opencontainers.image.description="Tor proxy: /app layout, 02_network_security/tor + scripts/lib, distroless Debian 12 (base-debian12)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="tor-socks" \
      com.lucid.layer="0" \
      org.lucid.layer="0" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="9050,9051,8888" \
      com.lucid.cluster="foundation" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.tunnel-tools,.env.foundation" \
      com.lucid.tor.inherent="true" \
      com.lucid.tor.system="gcr-distroless-base-debian12" \
      com.lucid.distroless.debian="12-bookworm" \
      com.lucid.service_id="com.lucid.dockerfile.v1.tor-proxy-02.infrastructure.containers.tor" \
      org.lucid.service_id="org.lucid.dockerfile.v1:infrastructure/containers/tor/Dockerfile.tor-proxy-02"

ENV PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH="/app/run/lucid/tor/bin:/app/run/lucid/tor/scripts:/app/bin:/app/sbin:/app/lib:/app/share/tor:/app/bin" \
    LD_LIBRARY_PATH="/app/lib" \
    SSL_CERT_FILE="/app/run/lucid/ssl/certs/ca-certificates.crt" \
    CURL_CA_BUNDLE="/app/run/lucid/ssl/certs/ca-certificates.crt" \
    LANG="C.UTF-8" \
    LC_ALL="C.UTF-8" \
    LUCID_HOST_CONFIG_PATH="/app/configs/host-config.yml" \
    LUCID_HOST_CONFIG_SERVICE_NAME="tor_socks" \
    LUCID_HOST_CONFIG_STABLE_ID="tor_socks" \
    LUCID_SERVICES_CONFIG_DIR="/app/service_configs" \
    LUCID_SERVICES_CONFIG_ROOT="/app/service_configs" \
    LUCID_SERVICE_NAME="tor-socks" \
    LUCID_SERVICE_PORT="9050" \
    TOR_CONTROL_HOST="127.0.0.1" \
    TOR_CONTROL_PORT="9051" \
    TOR_DATA_DIR="/app/var/lib/tor" \
    TOR_ONION_SERVICE_DIR="/app/run/lucid/onion" \
    TOR_SOCKS_PORT="9050"

WORKDIR /app

COPY --from=tor-builder /build/export-dynlink/ /app/export-dynlink/
COPY --from=tor-builder /build/usr/ /app/usr/
COPY --from=tor-builder /build/bin/ /app/bin/
COPY --from=tor-builder /build/sbin/ /app/sbin/
COPY --from=tor-builder /build/opt/ /app/opt/
COPY --from=tor-builder /build/etc/ /app/etc/
COPY --from=tor-builder /build/tmp/ /app/tmp/
COPY --from=tor-builder /build/var/ /app/var/
COPY --from=tor-builder /build/lib/ /app/lib/
COPY --from=tor-builder /build/lib64/ /app/lib64/
COPY --from=tor-builder --chown=debian-tor:debian-tor /build/ /app/


EXPOSE 9050 9051 8888

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD ["/app/bin/bash", "/app/run/lucid/tor/bin/tor-health.sh"]

USER debian-tor

ENTRYPOINT ["/app/bin/tini", "--"]
CMD ["/app/bin/bash", "/app/run/lucid/tor/bin/tor_entrypoint.sh"]
