# syntax=docker/dockerfile:1.5
# LUCID TOR PROXY — pickme/lucid-tor-proxy:latest-arm64 (SPEC-4 / distroless)
# Build context: repository root (aligned with infrastructure/containers/tor/Dockerfile tunnel-tools + infrastructure/containers/user/Dockerfile).
#
# Registry: infrastructure/containers/host-config.yml → tor_socks (service_name tor-socks, port 9050, http_path template).
# Runtime layout: infrastructure/containers/services/container-runtime-layout.yml → lucid_services_config_root: /app/service_configs
# Tor/tunnel shell alignment: infrastructure/containers/services/tor/tor-operational-layout.yml (packaged under /app/service_configs/tor/)
# Canonical host registry file in-image: /app/configs/host-config.yml (x-lucid-file-path in host-config.yml); mirror at /app/configs/host-config.yml.

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=2.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64

# =============================================================================
# STAGE 1: Tor System Builder (Debian 12 with full Tor installation)
# =============================================================================
ARG BUILDPLATFORM
ARG TARGETPLATFORM

FROM --platform=$TARGETPLATFORM debian:12-slim AS tor-builder

WORKDIR /build

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update && apt-get install -y --no-install-recommends \
      consul \
      build-essential \
      tor \
      tor-geoipdb \
      obfs4proxy \
      tini \
      bash \
      busybox \
      coreutils \
      netcat-openbsd \
      xxd \
      python3.11 \
      python3.11-dev \
      python3.11-pip \
      python3.11-setuptools \
      python3.11-venv \
      gosu \
      ca-certificates \
      dnsutils \
      curl \
      jq \
      adduser \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* 
# Dynamic linker + libc triplet + healthcheck helpers for distroless runtime (multi-arch; builder matches TARGETPLATFORM).
RUN python3.11 -c "import os; assert os.path.exists('/usr/local/lib/python3.11/site-packages'), 'CRITICAL: /usr/local/lib/python3.11/site-packages not found in distroless image'; assert os.path.exists('/usr/local/bin'), 'CRITICAL: /usr/local/bin not found in distroless image'; print('✅ Python executable verified: /usr/local/bin/python3.11')"

# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; overlaps with builder mkdir/.keep removed — see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/bin' \
    '/etc/ssl' \
    '/etc/tor' \
    '/usr/bin' \
    '/usr/lib/python3.11' \
    '/usr/local/bin' \
    '/var/lib/tor' \
    '/usr/local/lib/python3.11/site-packages'; \
  for d in \
    '/bin' \
    '/etc/ssl' \
    '/etc/tor' \
    '/usr/bin' \
    '/usr/lib/python3.11' \
    '/usr/local/bin' \
    '/var/lib/tor' \
    '/usr/local/lib/python3.11/site-packages'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END
# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
