  install -d -o debian-tor -g debian-tor -m 0755 /build/opt/share/tor/; \
  install -d -o debian-tor -g debian-tor -m 0755 /build/opt/share/ssl-cert/; \
  install -d -o debian-tor -g debian-tor -m 0755 /build/opt/share/ca-certificates/; \
  install -d -o debian-tor -g debian-tor -m 0755 /build/opt/share/keyrings/; \
  install -d -o debian-tor -g debian-tor -m 0755 /build/opt/share/numpy3/; \
  install -d -o debian-tor -g debian-tor -m 0755 /build/opt/share/obfs4proxy/; \
  printf 'dir=opt/share\nplatform=lucid-tor-proxy\n' > /build/opt/share/.keep \
