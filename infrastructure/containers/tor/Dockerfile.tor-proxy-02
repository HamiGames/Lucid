  printf 'dir=opt/share/ssl-cert\nplatform=lucid-tor-proxy\n' > /build/opt/share/ssl-cert/.keep \
  printf 'dir=opt/share/ca-certificates\nplatform=lucid-tor-proxy\n' > /build/opt/share/ca-certificates/.keep \
  printf 'dir=opt/share/keyrings\nplatform=lucid-tor-proxy\n' > /build/opt/share/keyrings/.keep \
  printf 'dir=opt/share/numpy3\nplatform=lucid-tor-proxy\n' > /build/opt/share/numpy3/.keep \
