# end of skeleton
RUN set -eux; \
    for bin in /build/usr/bin/tor /build/usr/bin/tini; do \
      missing=$(ldd "$bin" 2>&1 | grep "not found" || true); \
      if [ -n "$missing" ]; then echo "MISSING in $bin:"; echo "$missing"; exit 1; fi; \
    done; \
    if ldd /build/usr/bin/obfs4proxy 2>&1 | grep -q "not a dynamic"; then :; \
    else \
      missing=$(ldd /build/usr/bin/obfs4proxy 2>&1 | grep "not found" || true); \
      if [ -n "$missing" ]; then echo "MISSING in obfs4proxy:"; echo "$missing"; exit 1; fi; \
    fi
# check for missing files

# Dynamic linker + arch lib dir for TARGETPLATFORM (uname -m inside this stage matches target arch)
RUN set -eux; \
    mkdir -p /build/export-dynlink/root/lib /build/export-dynlink/root/lib64; \
    arch="$(uname -m)"; \
    case "$arch" in \
      aarch64) \
        cp -a /build/lib/ld-linux-aarch64.so.1 /build/export-dynlink/root/lib/; \
        cp -a /build/lib/aarch64-linux-gnu /build/export-dynlink/root/lib/; \
        ;; \
      x86_64) \
        if [ -f /build/lib64/ld-linux-x86-64.so.2 ]; then \
          cp -a /build/lib64/ld-linux-x86-64.so.2 /build/export-dynlink/root/lib64/; \
        else \
          cp -a /build/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /build/export-dynlink/root/lib64/; \
        fi; \
        cp -a /build/lib/x86_64-linux-gnu /build/export-dynlink/root/lib/; \
        ;; \
      *) echo "unsupported uname -m=$arch"; exit 1 ;; \
    esac

# torrc, GeoIP paths, entrypoints, scripts; populate /build/bin + /build/sbin
RUN set -eux; \
  install -m 0644 02_network_security/tor/torrc /build/run/lucid/tor/torrc; \
  { printf '\n# Distroless image: GeoIP from tor-geoipdb\n'; \
    printf 'GeoIPFile /app/opt/share/tor/geoip\n'; \
    printf 'GeoIPv6File /app/opt/share/tor/geoip6\n'; \
  } >> /build/run/lucid/tor/torrc; \
  install -d -m 0755 /build/run/lucid/tor/configs; \
  for f in tor_entrypoint.sh tor-health.sh bootstrap-helper.sh t_entrypoint.sh entrypoint.sh tor-show-onion.sh; do \
    install -m 0755 "02_network_security/tor/${f}" "/build/run/lucid/tor/bin/${f}"; \
  done; \
  install -m 0755 02_network_security/tor/scripts/create_ephemeral_onion.sh /build/run/lucid/tunnels/scripts/create-ephemeral-onion.sh; \
  install -m 0755 02_network_security/tor/bootstrap-helper.sh /build/run/lucid/tunnels/scripts/bootstrap-helper.sh; \
  for s in check_tor_bootstrap.sh create_dynamic_onion.sh create_ephemeral_onion.sh demo_onion_usage.sh set_host_config.sh start_tor.sh tor_env.sh; do \
    install -m 0755 "02_network_security/tor/scripts/${s}" "/build/run/lucid/tor/scripts/${s}"; \
  done; \
  install -d -m 0755 02_network_security/tor/scripts/ /build/run/lucid/tor/bin/; \
  install -m 0755 02_network_security/tor/scripts/create_dynamic_onion.sh /build/run/lucid/tor/bin/create-dynamic-onion.sh; \
  install -m 0755 02_network_security/tor/scripts/check_tor_bootstrap.sh /build/run/lucid/tor/bin/check-tor-bootstrap.sh; \
  install -m 0755 02_network_security/tor/scripts/start_tor.sh /build/run/lucid/tor/bin/start-tor.sh; \
  install -m 0755 02_network_security/tor/scripts/create_ephemeral_onion.sh /build/run/lucid/tor/bin/create-ephemeral-onion.sh; \
  find 02_network_security/tor/scripts -type f -name '*.sh' -exec chmod 0755 {} +; \
  find 02_network_security/tor -maxdepth 1 -type f -name '*.sh' -exec chmod 0755 {} +; \
  chmod 0755 scripts/lib/*.sh; \
  install -d -m 0755 bin sbin opt usr etc tmp build lib lib64; \
  install -m 0755 /usr/bin/tor /build/usr/bin/tor; \
  install -m 0755 /usr/bin/tor-gencert /build/usr/bin/tor-gencert; \
  install -m 0755 /usr/bin/torsocks /build/usr/bin/torsocks; \
  install -m 0755 /usr/bin/tor-resolve /build/usr/bin/tor-resolve; \
  install -m 0755 /usr/bin/openssl /build/usr/bin/openssl; \
  install -m 0755 /usr/bin/dnsmasq /build/usr/bin/dnsmasq; \
  install -m 0755 /usr/sbin/tor /build/usr/sbin/tor; \
  install -m 0755 /usr/sbin/dnsmasq /build/usr/sbin/dnsmasq; \
  install -m 0755 /usr/sbin/tor-instance-create /build/usr/sbin/tor-instance-create; \
  install -m 0755 /usr/sbin/tor /build/usr/sbin/tor; \
  install -m 0755 /usr/sbin/iptunnel /build/usr/sbin/iptunnel; \
  install -m 0755 /usr/bin/obfs4proxy /build/usr/bin/obfs4proxy; \
  install -m 0755 /usr/bin/tini /build/usr/bin/tini; \
  install -m 0755 /usr/sbin/gosu /build/usr/sbin/gosu; \
  install -m 0755 /bin/bash /build/bin/bash; \
  install -m 0755 /bin/busybox /build/usr/bin/busybox; \
  install -m 0755 /bin/cat /build/bin/cat; \
  install -m 0755 /bin/chmod /build/bin/chmod; \
  install -m 0755 /bin/chown /build/bin/chown; \
  install -m 0755 /bin/mkdir /build/bin/mkdir; \
  install -m 0755 /bin/rm /build/bin/rm; \
  install -m 0755 /bin/sleep /build/bin/sleep; \
  install -m 0755 /bin/tail /build/bin/tail; \
  install -m 0755 /bin/curl /build/bin/curl; \
  install -m 0755 /bin/jq /build/bin/jq; \
  install -m 0755 /bin/nc /build/bin/nc; \
  install -m 0755 /bin/timeout /build/bin/timeout; \
  install -m 0755 /bin/xxd /build/bin/xxd; \
  install -m 0755 /bin/mawk /build/bin/awk; \
  install -m 0755 /bin/grep /build/bin/grep; \
  install -m 0755 /bin/sed /build/bin/sed; \
  install -m 0755 /bin/head /build/bin/head; \
  install -m 0755 /bin/cut /build/bin/cut; \
  install -m 0755 /bin/tr /build/bin/tr; \
  install -m 0755 /bin/seq /build/bin/seq; \
  install -m 0755 /usr/local/share/ /build/opt/share/; \
