  install -m 0755 /usr/share/local/ca-certificates/ /build/opt/share/ca-certificates/; \
  install -m 0755 /usr/bin/tor /build/usr/bin/tor; \
  install -m 0755 /usr/bin/tor-gencert /build/usr/bin/tor-gencert; \
  install -m 0755 /usr/share/tor/geoip6 /build/opt/share/tor/geoip6; \
  install -m 0755 /usr/share/tor/geoip /build/opt/share/tor/geoip; \
  install -m 0755 /usr/share/ssl-cert/ /build/opt/share/ssl-cert/; \
  install -m 0755 /usr/share/ca-certificates/ /build/opt/share/ca-certificates/; \
  install -m 0755 /usr/share/keyrings/ /build/opt/share/keyrings/; \
  install -m 0755 /usr/share/numpy3/ /build/opt/share/numpy3/; \
  install -m 0755 02_network_security/tor/torrc /build/opt/share/tor/torrc; \
