ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG PYTHON_VERSION=3.11

############################
# Stage 1 – Builder
############################
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG PYTHON_VERSION

FROM --platform=$TARGETPLATFORM python:3.11-slim-bookworm AS builder

WORKDIR /build
RUN mkdir -p /var /var/cache /var/cache/apt /var/lib /var/lib/apt && \
    printf "LUCID_APT_GET_INSTALLER_VAR_$""$(date +%s)" > /var/.keep && \
    printf "LUCID_APT_GET_INSTALLER_VAR_CACHE_$""$(date +%s)" > /var/cache/.keep && \
    printf "LUCID_APT_GET_INSTALLER_VAR_CACHE_APT_$""$(date +%s)" > /var/cache/apt/.keep && \
    printf "LUCID_APT_GET_INSTALLER_VAR_LIB_$""$(date +%s)" > /var/lib/.keep && \
    printf "LUCID_APT_GET_INSTALLER_VAR_lib_APT_$""$(date +%s)" > /var/lib/apt/.keep && \
    touch /var/.keep /var/cache/.keep /var/cache/apt/.keep /var/lib.keep /var/lib/apt/.keep


RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        build-essential \
        bash \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
        pkg-config \
        curl \
        ca-certificates \
        tini \
        python3.11-wheel \
        python3.11-dev \
        python3.11-pip \
        python3.11-setuptools \
        rustc \
        cargo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; overlaps with builder mkdir/.keep removed — see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/lib/python3/dist-packages'; \
  for d in \
    '/bin' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/lib/python3/dist-packages'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END
# LUCID_RUST_INSTALL_BEGIN
RUN apt-get remove -y rustc cargo && \
    rm -rf /root/.cargo /root/.rustup && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
# LUCID_RUST_INSTALL_END
# COPY requirements.txt
COPY infrastructure/service_mesh/requirements.txt /build/requirements.txt
# LUCID_PIP_UPGRADE_BEGIN
RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    printf "LUCID_SERVICE_MESH_CONTROLLER_BUILD_WHEELS_$(date +%s)" > /build/wheels/.keep && \
    touch /build/wheels/.keep && \
    echo "upgrading pip setuptools wheel" && \
    pip install --upgrade pip setuptools wheel && \
    echo "pip toolchain upgrade complete" && \
    ls -lh /build/wheels/ | head -20 && \
    echo "total wheels: $(ls -1 /build/wheels/ | wc -l)"

RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    echo "building wheels from requirements.txt" && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels -r /build/requirements.txt && \
    echo "wheel build complete" && \
    ls -lh /build/wheels/ | head -20 && \
    echo "total wheels: $(ls -1 /build/wheels/ | wc -l)"
