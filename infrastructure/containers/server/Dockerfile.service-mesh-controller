# host-config.yml (bundled listeners in this image / compose stack):
#   lucid_service_mesh_controller — port 8500, host_ip 172.20.10.55, service_name lucid-service-mesh-controller
#   consul_dns — 8501 / consul-dns @ 172.20.10.56
#   consul_grpc — 8502 / consul-grpc @ 172.20.10.57
#   consul_lan_serf — 8600 / consul-lan-serf @ 172.20.10.58
#   service_mesh_http — 8088 / service-mesh-http-health @ 172.20.10.59
