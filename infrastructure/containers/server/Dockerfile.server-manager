ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

WORKDIR /app
# LUCID_IMAGE_CONFIG: host registry + services/*.yml (runtime)
LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Server Operations" \
      org.opencontainers.image.description="Distroless orchestrator for Lucid server subsystem handlers (lifecycle API + bundled handler modules)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="lucid-server-manager" \
      com.lucid.layer="1" \
      org.lucid.layer="1" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="8081" \
      com.lucid.cluster="core" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation" \
      com.lucid.role="server-handler-orchestrator" \
      com.lucid.hostconfig.registry_key="lucid_server_manager" \
      com.lucid.discovery.host_ip="172.20.10.3"

# LUCID_SERVER_OPERATIONS_PORT: preferred name for this image.
# RDP_SERVER_MANAGER_PORT: retained so server_manager/entrypoint.py and legacy compose keep working. \
      com.lucid.service_id="com.lucid.dockerfile.v1.fec05bf9884b5d04.infrastructure.containers.server.Dockerfile.server-manager" \
      onion.lucid.service_id="lucid-fec05bf9884b5d04-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.fec05bf9884b5d04:infrastructure/containers/server/Dockerfile.server-manager" \
ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH="/usr/local/bin:/usr/bin:/bin" \
    PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONPATH="/app:/usr/local/lib/python3.11/site-packages" \
    PYTHONIOENCODING="utf-8" \
    LANG="C.UTF-8" \
    LC_ALL="C.UTF-8" \
    CONSUL_BOOTSTRAP_EXPECT="1" \
    CONSUL_CONNECT_ENABLED="true" \
    CONSUL_DATACENTER="lucid-dc" \
    CONSUL_NODE_NAME="lucid-server-manager" \
    CONSUL_UI_ENABLED="true" \
