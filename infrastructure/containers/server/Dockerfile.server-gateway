# syntax=docker/dockerfile:1.5
# LUCID SERVER GATEWAY — Distroless Python (main HTTP entry for Lucid RDP server tier)
# Same application stack as 03_api_gateway/Dockerfile; packaged under infrastructure/containers/server/
# for the server plane. Build context: repository root (.).
#
# Startup: ``python -m server.run_server`` — validates master-endpoint.yml vs host-config (see
# infrastructure/containers/services/master-endpoint.yml), builds bind/port/env via server.build_server,
# then launches uvicorn (main_lucid_gateway → app.api.app.main:app).
#
# Role (host-config.yml alignment):
#   • main_lucid_gateway — service_name api-gateway, port 8080, host_ip 172.20.10.1, http://api-gateway:8080/app
#   • User-facing clients, node-system-gateway peers, and admin-system-gateway (e.g. portal → api-gateway)
#     reach Lucid core/session services through this gateway and published API_GATEWAY_URL patterns.
# Image: pickme/lucid-server-gateway:latest-arm64
# Port: 8450
#
# Run: set container hostname to api-gateway so uvicorn --host matches Docker DNS (see CMD / HEALTHCHECK).
# Aligned with dockerfile-design.md, Dockerfile-copy-pattern.md, and 03_api_gateway/Dockerfile.

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG PYTHON_VERSION=3.11

############################
# Stage 1 – Builder
############################
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG PYTHON_VERSION

FROM --platform=$TARGETPLATFORM python:3.11-slim-bookworm AS builder

WORKDIR /build

# System packages
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        build-essential \
        bash \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
        pkg-config \
        curl \
        ca-certificates \
        tini \
        python3.11-wheel \
        python3.11-dev \
        python3-pip \
        python3.11-setuptools \
        rustc \
        cargo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/bin' \
    '/usr' \
    '/etc/ssl' \
    '/root/.cargo' \
    '/root/.rustup' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/sbin' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/local/lib/python3.11/site-packages'; \
  for d in \
    '/bin' \
    '/usr' \
    '/etc/ssl' \
    '/root/.cargo' \
    '/root/.rustup' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/sbin' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/local/lib/python3.11/site-packages'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END

RUN apt-get remove -y rustc cargo && \
    rm -rf /root/.cargo /root/.rustup && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

COPY 03_api_gateway/requirements.txt ./requirements.txt

# Step 1: Build wheels explicitly - shows compilation happening
RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    printf "LUCID_SERVER_GATEWAY_BUILD_WHEELS_$(date +%s)" > /build/wheels/.keep && \
    touch /build/wheels/.keep && \
    echo "upgrading pip and setuptools" && \
    pip install --upgrade pip setuptools wheel &&\
    echo "upgrade complete" && \
    ls -lh /build/wheels/ | head -20 && \
    echo "total wheels built: $(ls -1 /build/wheels/ | wc -l)"

RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    echo "building wheels from source" &&\
    pip wheel --no-cache-dir --wheel-dir /build/wheels -r ./requirements.txt && \
    echo "wheel build complete" && \
    ls -lh /build/wheels/ | head -20 && \
    echo "total wheels built: $(ls -1 /build/wheels/ | wc -l)"
