# Primary + peer endpoints from infrastructure/containers/host-config.yml (see LABEL rdp_peers). \
      com.lucid.service_id="com.lucid.dockerfile.v1.03f85ade52648b36.infrastructure.containers.server.Dockerfile.rdp-server-manager" \
      onion.lucid.service_id="lucid-03f85ade52648b36-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.03f85ade52648b36:infrastructure/containers/server/Dockerfile.rdp-server-manager" \
ENV PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH=/app/usr/local/bin:/app/usr/bin:/app/bin:$PATH \
