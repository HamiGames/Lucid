# alignment-mat electron-gui-user_manifest.json: compose_service='electron-gui-user' — explicit manifest paths → 35 builder COPY line(s) (dockerfile_layout_structure.json section #10 COPY_DIRECTORIES).
COPY _gen_host_config.py ./_gen_host_config.py
COPY common/ ./common/
COPY scripts/ ./scripts/
COPY infrastructure/containers/user/docker-compose.user-gui.yml ./infrastructure/containers/user/docker-compose.user-gui.yml
COPY infrastructure/containers/services/gui/electron-gui-user.yml ./infrastructure/containers/services/gui/electron-gui-user.yml
COPY user/ ./user/
COPY user_content/ ./user_content/
COPY scripts/ ./scripts/
COPY gui_api_bridge/gui_api_bridge/ ./gui_api_bridge/gui_api_bridge/
COPY 03_api_gateway/api/app/routers/gui.py ./03_api_gateway/api/app/routers/gui.py
COPY 03_api_gateway/api/app/routers/gui_docker.py ./03_api_gateway/api/app/routers/gui_docker.py
COPY 03_api_gateway/api/app/routers/gui_tor.py ./03_api_gateway/api/app/routers/gui_tor.py
COPY 03_api_gateway/api/app/routers/gui_hardware.py ./03_api_gateway/api/app/routers/gui_hardware.py
COPY 03_api_gateway/api/app/services/gui_bridge_service.py ./03_api_gateway/api/app/services/gui_bridge_service.py
COPY 03_api_gateway/api/app/services/gui_docker_manager_service.py ./03_api_gateway/api/app/services/gui_docker_manager_service.py
COPY 03_api_gateway/api/app/services/gui_tor_manager_service.py ./03_api_gateway/api/app/services/gui_tor_manager_service.py
COPY 03_api_gateway/api/app/services/gui_hardware_manager_service.py ./03_api_gateway/api/app/services/gui_hardware_manager_service.py


COPY gui/user/ ./gui/user/
COPY gui/wallet/ ./gui/wallet/
COPY gui/shared/ ./gui/shared/
COPY gui/core/ ./gui/core/
COPY RDP/common/  ./RDP/common/
COPY RDP/protocol/  ./RDP/protocol/
COPY RDP/client/  ./RDP/client/
COPY RDP/resource-monitor/  ./RDP/resource-monitor/
COPY RDP/xrdp/  ./RDP/xrdp/
COPY RDP/recorder/  ./RDP/recorder/

COPY configs/container/electron_gui/docker-compose.electron-gui.yml ./configs/container/electron_gui/docker-compose.electron-gui.yml
COPY configs/container/gui/docker-compose.user-gui.yml ./configs/container/gui/docker-compose.user-gui.yml
COPY electron_gui/utils/load_host_config.py ./electron_gui/utils/load_host_config.py
COPY gui/user/connect_to _electron.py ./gui/user/connect_to _electron.py
COPY infrastructure/containers/_sync_dockerfile_lucid_env.py ./infrastructure/containers/_sync_dockerfile_lucid_env.py
COPY infrastructure/containers/config-listings.json ./infrastructure/containers/config-listings.json
COPY infrastructure/containers/dockerfile_recalibration_map.json ./infrastructure/containers/dockerfile_recalibration_map.json
COPY infrastructure/containers/dockerfile_recalibration_map_REPAIRED.json ./infrastructure/containers/dockerfile_recalibration_map_REPAIRED.json
COPY infrastructure/containers/electron_gui/docker-compose.electron-gui.yml ./infrastructure/containers/electron_gui/docker-compose.electron-gui.yml
COPY infrastructure/containers/gui/docker-compose.user-gui.yml ./infrastructure/containers/gui/docker-compose.user-gui.yml
COPY infrastructure/containers/host-config.yml ./infrastructure/containers/host-config.yml
COPY infrastructure/containers/services/gui/electron-gui-user.yml ./infrastructure/containers/services/gui/electron-gui-user.yml
COPY infrastructure/containers/services/middle-ware/master-endpoint.yml ./infrastructure/containers/services/middle-ware/master-endpoint.yml
COPY infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.json ./infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.json
COPY infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml ./infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml
COPY infrastructure/containers/services/x_lucid_cluster_calibration/gui-integration-cluster-host-alignment.yml ./infrastructure/containers/services/x_lucid_cluster_calibration/gui-integration-cluster-host-alignment.yml
# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_END
RUN (cd electron_gui && npm install --production --legacy-peer-deps --no-audit --no-fund)

# Create marker files with actual content (ensures directory structure is locked in)
RUN echo "LUCID_ELECTRON_GUI_USER_BUILT_$(date +%s)" > /build/.build-marker && \
    echo "LUCID_ELECTRON_GUI_USER_PACKAGES_INSTALLED_$(date +%s)" > /build/.packages-marker



# Verify source structure including config files
RUN test -d ./electron_gui/main && \
    test -d ./electron_gui/renderer/user && \
    test -d ./electron_gui/renderer/common && \
    test -d ./electron_gui/shared && \
    test -d ./electron_gui/configs && \
    test -f ./configs/api-services-user.conf && \
    test -f ./electron_gui/configs/docker.config.json && \
    test -f ./electron_gui/configs/env.production.json && \
    test -f ./electron_gui/configs/tor.config.json && \
    test -f .build-marker && \
    test -f .packages-marker && \
    echo "✅ Source structure verified (configs files present)"

# Build the application
RUN (cd electron_gui && npm run build:user)

############################
# Stage 2: Runtime (Distroless)
############################
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=1024"

FROM --platform=${TARGETPLATFORM} gcr.io/distroless/nodejs18-debian11

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=latest

WORKDIR /app

LABEL maintainer="Lucid Development Team" \
      org.opencontainers.image.title="Lucid User Interface" \
      org.opencontainers.image.description="electron_gui User Interface - Distroless" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="electron-gui-user" \
      com.lucid.layer="3" \
      org.lucid.layer="3" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="3001" \
      com.lucid.cluster="support" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation,.env.secrets" \
      com.lucid.hostconfig.service_name="electron-gui-user" \
      com.lucid.hostconfig.port="3001" \
      com.lucid.hostconfig.upstream_api_gateway_host="api-gateway" \
      com.lucid.hostconfig.upstream_api_gateway_port="8080"


ENV NODE_ENV="production" \
    ELECTRON_GUI_PROFILE=user \
    ELECTRON_GUI_NETWORK=lucid-pi-network \
    ELECTRON_GUI_API_BASE_URL=http://api-gateway:8080/api/v1 \
    ELECTRON_GUI_CONFIG_FILE=/app/configs/api-services-user.conf \
    LUCID_HOST_CONFIG_PATH=/app/configs/host-config.yml \
    LUCID_HOST_CONFIG_SERVICE_NAME=electron_gui_user
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /build/03_api_gateway/ /app/03_api_gateway/
COPY --from=builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=builder --chown=65532:65532 /build/dist/ /app/dist/
COPY --from=builder --chown=65532:65532 /build/electron_gui/ /app/electron_gui/
COPY --from=builder --chown=65532:65532 /build/gui/ /app/gui/
COPY --from=builder --chown=65532:65532 /build/gui_api_bridge/ /app/gui_api_bridge/
COPY --from=builder --chown=65532:65532 /build/node_modules/ /app/node_modules/
COPY --from=builder --chown=65532:65532 /build/rdp/ /app/rdp/
COPY --from=builder --chown=65532:65532 /build/scripts/ /app/scripts/
COPY --from=builder --chown=65532:65532 /build/user/ /app/user/
COPY --from=builder --chown=65532:65532 /build/user_content/ /app/user_content/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /build/rdp/ /app/rdp/
COPY --from=builder --chown=65532:65532 /build/infrastructure/containers/ /app/infrastructure/containers/
# Generated: apt + RUN scaffold (mkdir/printf/touch/chown) -> FHS (not ./ or /build/; lib_search_and_inject.py).
COPY --from=builder --chown=nonroot:nonroot /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=builder --chown=nonroot:nonroot /usr/lib/*/libssl.so* /app/usr/lib/
COPY --from=builder --chown=nonroot:nonroot /usr/lib/*/ossl-modules/ /app/usr/lib/
COPY --from=builder --chown=nonroot:nonroot /usr/lib/*/libstdc++.so.6 /app/usr/lib/
COPY --from=builder --chown=nonroot:nonroot /usr/lib/*/libgcc_s.so.1 /app/usr/lib/
COPY --from=builder --chown=nonroot:nonroot /etc/ssl/ /app/etc/ssl/
COPY --from=builder --chown=nonroot:nonroot /nodejs/ /app/nodejs/
COPY --from=builder --chown=nonroot:nonroot /usr/bin/ /app/usr/bin/
COPY --from=builder --chown=nonroot:nonroot /usr/lib/python3.11/ /app/usr/lib/python3.11/
COPY --from=builder --chown=nonroot:nonroot /usr/lib/python3/dist-packages/ /app/usr/lib/python3/dist-packages/
COPY --from=builder --chown=nonroot:nonroot /usr/local/bin/ /app/usr/local/bin/
COPY --from=builder --chown=nonroot:nonroot /usr/local/lib/ /app/usr/local/lib/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
RUN ["/app/nodejs/bin/node", "-e", "const fs = require('fs'); const p=(x)=>fs.existsSync(x); const checks = { buildMarker: p('/app/.build-marker'), packMarker: p('/app/.packages-marker'), dist: p('/app/dist'), matUserJson: p('/app/configs/gui-alignment/user-interface.json'), matGuiSvc: p('/app/configs/services/gui-services.json'), matAllocJson: p('/app/infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.json'), userConf: p('/app/configs/api-services-user.conf'), dockerConfig: p('/app/electron_gui/configs/docker.config.json'), prodConfig: p('/app/electron_gui/configs/env.production.json'), torConfig: p('/app/electron_gui/configs/tor.config.json'), hostConfig: p('/app/configs/host-config.yml'), ymlEgCompose: p('/app/infrastructure/containers/electron_gui/docker-compose.electron-gui.yml') }; if (!Object.values(checks).every(v => v)) { console.error('Verification failed:', checks); process.exit(1); } console.log('Build artifacts verified');"]

# Expose ports
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD ["/app/nodejs/bin/node", "-e", "require('http').get('http://127.0.0.1:3001/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => { process.exit(1); })"]

USER nonroot:nonroot

ENTRYPOINT ["/app/usr/bin/tini", "--"]
CMD ["/app/nodejs/bin/node", "/app/dist/main/index.js"]
