RUN ["/app/usr/bin/node", "-e", "const fs = require('fs'); const p=(x)=>fs.existsSync(x); const checks = { buildMarker: p('/app/.build-marker'), packMarker: p('/app/.packages-marker'), dist: p('/app/dist'), matNodeJson: p('/app/configs/gui-alignment/node-interface.json'), matGuiSvc: p('/app/configs/services/gui-services.json'), hostConfig: p('/app/configs/host-config.yml'), nodeConf: p('/app/configs/api-services-node.conf'), dockerConfig: p('/app/electron_gui/configs/docker.config.json'), prodConfig: p('/app/electron_gui/configs/env.production.json'), torConfig: p('/app/electron_gui/configs/tor.config.json'), common: p('/app/common/load_host_config.py'), apiGwCm: p('/app/configs/api-gateway-config.yaml'), ymlBlockchain: p('/app/infrastructure/containers/blockchain/docker-compose.chain.yml') }; if (!Object.values(checks).every(v => v)) { console.error('Verification failed:', checks); process.exit(1); } console.log('Runtime artifacts verified');"]

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD ["/app/usr/bin/node", "-e", "require('http').get('http://127.0.0.1:3002/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => { process.exit(1); })"]

