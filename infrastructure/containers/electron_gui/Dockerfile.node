RUN set -eux; \
  mkdir -p \
    '/dev' \
    '/usr/bin' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/local/lib'; \
  for d in \
    '/dev' \
    '/usr/bin' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
