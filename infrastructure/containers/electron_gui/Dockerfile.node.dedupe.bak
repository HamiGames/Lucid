# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_BEGIN
# alignment-mat electron-gui-node_manifest.json: compose_service='electron-gui-node' — explicit manifest paths → 36 builder COPY line(s) (dockerfile_layout_structure.json section #10 COPY_DIRECTORIES).
