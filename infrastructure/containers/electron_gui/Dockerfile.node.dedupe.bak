COPY configs/container/electron_gui/docker-compose.electron-gui.yml ./configs/container/electron_gui/docker-compose.electron-gui.yml
COPY configs/container/gui/docker-compose.node-gui.yml ./configs/container/gui/docker-compose.node-gui.yml
COPY configs/container/node/docker-compose.node-gui.yml ./configs/container/node/docker-compose.node-gui.yml
COPY electron_gui/utils/load_host_config.py ./electron_gui/utils/load_host_config.py
COPY infrastructure/containers/_sync_dockerfile_lucid_env.py ./infrastructure/containers/_sync_dockerfile_lucid_env.py
COPY infrastructure/containers/config-listings.json ./infrastructure/containers/config-listings.json
COPY infrastructure/containers/dockerfile_recalibration_map.json ./infrastructure/containers/dockerfile_recalibration_map.json
COPY infrastructure/containers/dockerfile_recalibration_map_REPAIRED.json ./infrastructure/containers/dockerfile_recalibration_map_REPAIRED.json
COPY infrastructure/containers/electron_gui/docker-compose.electron-gui.yml ./infrastructure/containers/electron_gui/docker-compose.electron-gui.yml
COPY infrastructure/containers/gui/docker-compose.node-gui.yml ./infrastructure/containers/gui/docker-compose.node-gui.yml
COPY infrastructure/containers/host-config.yml ./infrastructure/containers/host-config.yml
COPY infrastructure/containers/node/docker-compose.node-gui.yml ./infrastructure/containers/node/docker-compose.node-gui.yml
COPY infrastructure/containers/services/gui/electron-gui-node.yml ./infrastructure/containers/services/gui/electron-gui-node.yml
COPY infrastructure/containers/services/middle-ware/master-endpoint.yml ./infrastructure/containers/services/middle-ware/master-endpoint.yml
COPY infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.json ./infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.json
COPY infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml ./infrastructure/containers/services/x_lucid_cluster_calibration/allocation_manifest.yml
COPY infrastructure/containers/services/x_lucid_cluster_calibration/gui-integration-cluster-host-alignment.yml ./infrastructure/containers/services/x_lucid_cluster_calibration/gui-integration-cluster-host-alignment.yml
# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_END
COPY host-config.yml ./configs/host-config.yml

# Container directory layout (03_api_gateway/Dockerfile): common/tor, kubernetes configmaps
COPY common/__init__.py /build/common/__init__.py
COPY common/tor/ /build/common/tor/


# System markers (per Dockerfile-copy-pattern.md)
COPY electron_gui/package*.json ./
COPY electron_gui/tsconfig*.json ./
COPY electron_gui/webpack*.js ./
COPY electron_gui/main/ ./main/
COPY electron_gui/renderer/node/ ./renderer/node/
COPY electron_gui/renderer/common/ ./renderer/common/
COPY electron_gui/shared/ ./shared/
COPY electron_gui/assets/ ./assets/
COPY electron_gui/configs/ ./configs/


RUN rm -rf configs/environment 2>/dev/null || true
RUN printf "LUCID_ELECTRON_GUI_NODE_VAR_RUN" > /var/run/.keep && \
    printf "LUCID_ELECTRON_GUI_NODE_VAR_LIB" > /var/lib/.keep && \
    chown -R 65532:65532 /var/run /var/lib && \
    chmod 644 /var/run/.keep /var/lib/.keep

RUN echo "=== electron_gui node: package manifests ===" && \
    ls -la ./package*.json ./tsconfig*.json ./webpack*.js 2>/dev/null || true && \
    echo "manifests OK"

RUN --mount=type=cache,target=/root/.npm \
    npm cache clean --force && \
    (npm config delete registry 2>/dev/null || true) && \
    npm config set registry https://registry.npmjs.org/ && \
    npm install --production --legacy-peer-deps --no-audit --no-fund

RUN echo "LUCID_ELECTRON_GUI_NODE_BUILT_$(date +%s)" > /build/.build-marker && \
    echo "LUCID_ELECTRON_GUI_NODE_PACKAGES_INSTALLED_$(date +%s)" > /build/.packages-marker && \
    chown 65532:65532 /build/.build-marker /build/.packages-marker

RUN echo "=== Checking electron_gui/main/ ===" && \
    ls -la ./main/ && \
    echo "main/ copied"

RUN echo "=== Verifying node operator source tree ===" && \
    test -d ./main && \
    test -d ./renderer/node && \
    test -d ./renderer/common && \
    test -d ./shared && \
    test -d ./assets && \
    test -d ./configs && \
    test -f ./configs/api-gateway-config.yaml && \
    test -f ./common/__init__.py && \
    test -f ./configs/api-services-node.conf && \
    test -f ./configs/docker.config.json && \
    test -f ./configs/env.production.json && \
    test -f ./configs/tor.config.json && \
    test -f .build-marker && \
    test -f .packages-marker && \
    echo "Source structure verified"

RUN npm run build:node

############################
# Stage 2 – Runtime (Distroless)
############################
FROM --platform=$TARGETPLATFORM gcr.io/distroless/nodejs18-debian11

ARG BUILD_DATE=
ARG VCS_REF=
ARG VERSION=1.0.0
# Lucid Tor egress / network isolation (PUBLIC_TOR_IP: ../../configs/environment/ ; compose: lucid-tor-egress-network)
ARG PUBLIC_TOR_IP=109.70.100.1
ARG LUCID_INTERNAL_NETWORK_NAME=lucid-pi-network
ARG LUCID_TOR_EGRESS_NETWORK_NAME=lucid-tor-egress-network

WORKDIR /app

LABEL maintainer="Lucid Development Team" \
      com.lucid.network.internal="${LUCID_INTERNAL_NETWORK_NAME}" \
      com.lucid.network.tor_egress="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
      com.lucid.tor.public_egress_ip="${PUBLIC_TOR_IP}" \
      org.opencontainers.image.title="Lucid Node Operator Interface" \
      org.opencontainers.image.description="electron_gui Node Operator Interface - Distroless Node" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="support" \
      com.lucid.service="electron-gui-node" \
      com.lucid.layer="3" \
      org.lucid.layer="3" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="3002" \
      com.lucid.cluster="gui-integration" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation" \
      com.lucid.hostconfig.service_name="electron-gui-node" \
      com.lucid.hostconfig.port="3002" \
      com.lucid.hostconfig.upstream_api_gateway_host="api-gateway" \
      com.lucid.hostconfig.upstream_api_gateway_port="8080" \
      com.lucid.phase="gui" \
      com.lucid.service_id="com.lucid.dockerfile.v1.1566acb8cc6665d1.infrastructure.containers.electron_gui.Dockerfile.node" \
      onion.lucid.service_id="lucid-1566acb8cc6665d1-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.1566acb8cc6665d1:infrastructure/containers/electron_gui/Dockerfile.node" \

ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    ELECTRON_GUI_API_BASE_URL="http://api-gateway:8080/api/v1" \
    ELECTRON_GUI_CONFIG_FILE="/app/configs/api-services-node.conf" \
    ELECTRON_GUI_NETWORK="lucid-pi-network" \
    ELECTRON_GUI_PROFILE="node_operator" \
    LUCID_API_GATEWAY_HOST="api-gateway" \
    LUCID_API_GATEWAY_PORT="3002" \
    LUCID_HOST_CONFIG_PATH="/app/configs/host-config.yml" \
    LUCID_HOST_CONFIG_SERVICE_NAME=electron_gui_node \
    LUCID_SERVICE_HOST_IP=172.20.10.76 \
    LUCID_SERVICE_HTTP_PATH=http://electron-gui-node:3002/app \
    NODE_ENV="production"
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /dev/null/ /app/dev/null/
COPY --from=builder --chown=65532:65532 /etc/ssl/certs/ /app/etc/ssl/certs/
COPY --from=builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
COPY --from=builder --chown=65532:65532 /usr/local/bin/ /app/usr/local/bin/
COPY --from=builder --chown=65532:65532 /usr/local/lib/ /app/usr/local/lib/
COPY --from=builder --chown=65532:65532 /var/lib/ /app/var/lib/
COPY --from=builder --chown=65532:65532 /var/run/ /app/var/run/
COPY --from=builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=builder --chown=65532:65532 /build/configs/ /app/configs/
# LUCID_RUNTIME_COPY_FROM_BUILD_END





COPY --from=builder --chown=65532:65532 /build/infrastructure/containers/ /app/infrastructure/containers/
COPY --from=builder --chown=65532:65532 /build/.build-marker /app/.build-marker
COPY --from=builder --chown=65532:65532 /build/.packages-marker /app/.packages-marker


RUN ["/app/usr/bin/node", "-e", "const fs = require('fs'); const p=(x)=>fs.existsSync(x); const checks = { buildMarker: p('/app/.build-marker'), packMarker: p('/app/.packages-marker'), dist: p('/app/dist'), matNodeJson: p('/app/configs/gui-alignment/node-interface.json'), matGuiSvc: p('/app/configs/services/gui-services.json'), hostConfig: p('/app/configs/host-config.yml'), nodeConf: p('/app/configs/api-services-node.conf'), dockerConfig: p('/app/electron_gui/configs/docker.config.json'), prodConfig: p('/app/electron_gui/configs/env.production.json'), torConfig: p('/app/electron_gui/configs/tor.config.json'), common: p('/app/common/load_host_config.py'), apiGwCm: p('/app/configs/api-gateway-config.yaml'), ymlBlockchain: p('/app/infrastructure/containers/blockchain/docker-compose.chain.yml') }; if (!Object.values(checks).every(v => v)) { console.error('Verification failed:', checks); process.exit(1); } console.log('Runtime artifacts verified');"]

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD ["/app/usr/bin/node", "-e", "require('http').get('http://127.0.0.1:3002/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => { process.exit(1); })"]

USER 65532:65532

ENTRYPOINT ["/app/usr/bin/tini", "--"]
CMD ["/app/usr/bin/node", "/app/dist/main/index.js"]
