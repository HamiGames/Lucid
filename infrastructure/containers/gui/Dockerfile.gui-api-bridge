      com.lucid.env.config=".env.master,.env.secrets" \
      com.lucid.phase="gui" \
      com.lucid.service_id="com.lucid.dockerfile.v1.ae1e151ee8579eac.infrastructure.containers.gui.Dockerfile.gui-api-bridge" \
