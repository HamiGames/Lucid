# LUCID GUI API BRIDGE - Distroless Python Service
# Aligned with dockerfile-design.md, Dockerfile-copy-pattern.md, and 03_api_gateway/Dockerfile
# Image: pickme/lucid-gui-api-bridge:latest-arm64
# Port: 8102
# Build context: repository root
# Build: docker build -f infrastructure/containers/gui/Dockerfile.gui-api-bridge -t pickme/lucid-gui-api-bridge:latest-arm64 .

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG PYTHON_VERSION=3.11

############################
# Stage 1 – Builder
############################
FROM --platform=$TARGETPLATFORM python:3.11-slim-bookworm AS builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG PYTHON_VERSION
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PREFER_BINARY=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /build


RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        build-essential \
        bash \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
        pkg-config \
        curl \
        ca-certificates \
        tini \
        python3-wheel \
        python3-dev \
        python3-pip \
        python3-setuptools \
        openssl \
        dnsutils \
        xxd \
        rustc \
        cargo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Onion scaffold: infrastructure/containers/tor/Dockerfile.tor-proxy-02 (TOR_ONION_SERVICE_DIR, TOR_COOKIE_TARGETS).
RUN printf "LUCID_GUI_API_BRIDGE_RUNTIME_DIRECTORY" > /var/run/.keep && \
    printf "LUCID_GUI_API_BRIDGE_LIB_DIRECTORY" > /var/lib/.keep && \
    mkdir -p /app/run/lucid/onion && \
    printf "LUCID_GUI_API_BRIDGE_RUN_LUCID" > /app/run/lucid/.keep && \
    chown -R 65532:65532 /var/run /var/lib /app/run/lucid && \
    chmod 644 /var/run/.keep /var/lib/.keep

RUN mkdir -p /usr/local/lib/python3.11/site-packages /usr/local/bin /build/wheels && \
    printf "LUCID_GUI_API_BRIDGE_WHEELS_$(date +%s)" > /build/wheels/.keep && \
    touch /build/wheels/.keep && \
    chown -R 65532:65532 /usr/local/lib/python3.11 /usr/local/bin /build/wheels

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel

COPY gui_api_bridge/requirements.txt ./requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    echo "building wheels" && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels -r ./requirements.txt && \
    echo "wheel build complete"
