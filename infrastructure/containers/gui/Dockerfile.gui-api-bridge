def main() -> int:
    req_files = [
        "/app/usr/bin/python3.11",
        "/app/usr/bin/tini",
        "/app/gui_api_bridge/gui_api_bridge/entrypoint.py",
        "/app/gui_api_bridge/gui_api_bridge/main.py",
