  mkdir -p \
    '/dev' \
    '/var' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/local' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
