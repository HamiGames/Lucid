# syntax=docker/dockerfile:1.5
# LUCID GUI Docker Manager Service - Distroless Python Container
# Aligned with dockerfile-design.md and Dockerfile-copy-pattern.md
# Image: pickme/lucid-gui-docker-manager:latest-arm64
# Port: 0

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG TARGETPLATFORM=linux/arm64
ARG BUILDPLATFORM=linux/amd64
ARG PYTHON_VERSION=3.11

############################
# Stage 1 – Builder
############################
FROM --platform=$BUILDPLATFORM python:3.11-slim-bookworm AS builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG PYTHON_VERSION

WORKDIR /build
# LUCID_IMAGE_CONFIG: host-config + container services (builder)

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PREFER_BINARY=1 \
    DEBIAN_FRONTEND=noninteractive

# System packages
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
        pkg-config \
        curl \
        tini \
        rustc \
        cargo \
        electron-builder \
        python3.11-dev \
        python3-pip \
        python3.11-setuptools \
        python3.11-wheel \
        openvpn \
        openssl \
        xxd \
        ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# LUCID_LIB_SKELETON_BEGIN
# Generated: FHS dirs for builder (from final-stage COPY --from, excluding /build/ sources;
# ancestor dirs collapsed; see collect_skeleton_paths_from_dockerfile).
RUN set -eux; \
  mkdir -p \
    '/dev' \
    '/var' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/local' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/lib/python3/dist-packages' \
    '/usr/local/lib/python3.11'; \
  for d in \
    '/dev' \
    '/var' \
    '/etc/ssl' \
    '/usr/bin' \
    '/usr/lib' \
    '/usr/local' \
    '/var/lib' \
    '/var/run' \
    '/etc/ssl/certs' \
    '/usr/local/bin' \
    '/usr/lib/python3/dist-packages' \
    '/usr/local/lib/python3.11'; \
  do \
    printf 'LUCID_LIB_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
    touch "$d/.keep"; \
  done
# LUCID_LIB_SKELETON_END
COPY gui_docker_manager/requirements.txt ./requirements.txt

# Step 1: Build wheels explicitly - shows compilation happening
RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /build/wheels && \
    echo "=== BUILDING WHEELS FROM SOURCE ===" && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels -r requirements.txt && \
    echo "=== WHEEL BUILD COMPLETE ===" && \
    ls -lh /build/wheels/ && \
    echo "Total wheels built: $(ls -1 /build/wheels/ | wc -l)"
# LUCID_X_FILES_SKELETON_BEGIN
# Dirs: (listing ∩ COPY-approved) ∪ builder-stage COPY roots; after pip cache RUN or before first /build COPY
RUN set -eux; \
    mkdir -p '.' './common' './configs' './gui_docker_manager' './service_configs' './common/__pycache__' './common/governance' './common/security' './common/server-tools' './common/templates' './common/tor' './configs/.ssh' './configs/alignment-mats' './configs/container' './configs/database' './configs/docker' './configs/env' './configs/environment' './configs/gui-alignment' './configs/integration' './configs/kubernetes' './configs/logging' './configs/pi' './configs/secrets' './configs/security' './configs/tor' './gui_docker_manager/config' './gui_docker_manager/gui_docker_manager' './gui_docker_manager/integration' './gui_docker_manager/middleware' './gui_docker_manager/models' './gui_docker_manager/routers' './gui_docker_manager/services' './gui_docker_manager/utils' './common/governance/__pycache__' './common/security/__pycache__' './common/server-tools/__pycache__' './common/tor/__pycache__' './configs/container/admin' './configs/container/auth' './configs/container/base' './configs/container/blockchain' './configs/container/database' './configs/container/electron_gui' './configs/container/gui' './configs/container/node' './configs/container/payment_systems' './configs/container/rdp' './configs/container/server' './configs/container/sessions' './configs/container/storage' './configs/container/tor' './configs/database/elasticsearch' './configs/database/redis' './configs/docker/distroless' './configs/docker/docs' './configs/docker/multi-stage' './configs/environment/development' './configs/environment/pi' './configs/environment/production' './configs/environment/staging' './configs/pi/ssh' './configs/secrets/runtime' './gui_docker_manager/gui_docker_manager/__pycache__' './gui_docker_manager/gui_docker_manager/config' './gui_docker_manager/gui_docker_manager/integration' './gui_docker_manager/gui_docker_manager/middleware' './gui_docker_manager/gui_docker_manager/models' './gui_docker_manager/gui_docker_manager/routers' './gui_docker_manager/gui_docker_manager/services' './gui_docker_manager/gui_docker_manager/utils' './configs/secrets/runtime/compose' './gui_docker_manager/gui_docker_manager/integration/__pycache__' './gui_docker_manager/gui_docker_manager/middleware/__pycache__' './gui_docker_manager/gui_docker_manager/models/__pycache__' './gui_docker_manager/gui_docker_manager/routers/__pycache__' './gui_docker_manager/gui_docker_manager/services/__pycache__' './gui_docker_manager/gui_docker_manager/utils/__pycache__'; \
    for d in \
      '.' \
      './common' \
      './configs' \
      './gui_docker_manager' \
      './service_configs' \
      './common/__pycache__' \
      './common/governance' \
      './common/security' \
      './common/server-tools' \
      './common/templates' \
      './common/tor' \
      './configs/.ssh' \
      './configs/alignment-mats' \
      './configs/container' \
      './configs/database' \
      './configs/docker' \
      './configs/env' \
      './configs/environment' \
      './configs/gui-alignment' \
      './configs/integration' \
      './configs/kubernetes' \
      './configs/logging' \
      './configs/pi' \
      './configs/secrets' \
      './configs/security' \
      './configs/tor' \
      './gui_docker_manager/config' \
      './gui_docker_manager/gui_docker_manager' \
      './gui_docker_manager/integration' \
      './gui_docker_manager/middleware' \
      './gui_docker_manager/models' \
      './gui_docker_manager/routers' \
      './gui_docker_manager/services' \
      './gui_docker_manager/utils' \
      './common/governance/__pycache__' \
      './common/security/__pycache__' \
      './common/server-tools/__pycache__' \
      './common/tor/__pycache__' \
      './configs/container/admin' \
      './configs/container/auth' \
      './configs/container/base' \
      './configs/container/blockchain' \
      './configs/container/database' \
      './configs/container/electron_gui' \
      './configs/container/gui' \
      './configs/container/node' \
      './configs/container/payment_systems' \
      './configs/container/rdp' \
      './configs/container/server' \
      './configs/container/sessions' \
      './configs/container/storage' \
      './configs/container/tor' \
      './configs/database/elasticsearch' \
      './configs/database/redis' \
      './configs/docker/distroless' \
      './configs/docker/docs' \
      './configs/docker/multi-stage' \
      './configs/environment/development' \
      './configs/environment/pi' \
      './configs/environment/production' \
      './configs/environment/staging' \
      './configs/pi/ssh' \
      './configs/secrets/runtime' \
      './gui_docker_manager/gui_docker_manager/__pycache__' \
      './gui_docker_manager/gui_docker_manager/config' \
      './gui_docker_manager/gui_docker_manager/integration' \
      './gui_docker_manager/gui_docker_manager/middleware' \
      './gui_docker_manager/gui_docker_manager/models' \
      './gui_docker_manager/gui_docker_manager/routers' \
      './gui_docker_manager/gui_docker_manager/services' \
      './gui_docker_manager/gui_docker_manager/utils' \
      './configs/secrets/runtime/compose' \
      './gui_docker_manager/gui_docker_manager/integration/__pycache__' \
      './gui_docker_manager/gui_docker_manager/middleware/__pycache__' \
      './gui_docker_manager/gui_docker_manager/models/__pycache__' \
      './gui_docker_manager/gui_docker_manager/routers/__pycache__' \
      './gui_docker_manager/gui_docker_manager/services/__pycache__' \
      './gui_docker_manager/gui_docker_manager/utils/__pycache__' \
    ; do \
      printf 'LUCID_X_FILES_SKELETON_%s' "$(date +%s)" > "$d/.keep"; \
      touch "$d/.keep"; \
    done
# LUCID_X_FILES_SKELETON_END
# Step 2: Install wheels into system Python
RUN echo "=== INSTALLING WHEELS INTO SYSTEM PYTHON ===" && \
    pip install --no-cache-dir --no-index --find-links /build/wheels -r requirements.txt && \
    echo "LUCID_GUI_DOCKER_MANAGER_PACKAGES_$(date +%s)" > /usr/local/lib/python3.11/site-packages/.lucid-marker && \
    echo "LUCID_GUI_DOCKER_MANAGER_BIN_$(date +%s)" > /usr/local/bin/.lucid-marker && \
    chmod 644 /usr/local/lib/python3.11/site-packages/.lucid-marker /usr/local/bin/.lucid-marker && \
    echo "=== INSTALLATION COMPLETE ===" && \
    rm -rf /build/wheels

# Builder-stage verification - ensure all packages built correctly
RUN echo "=== Verifying pip installation success ===" && \
    python3 -c "import fastapi, uvicorn, pydantic, httpx, docker, websockets, jsonschema, pyyaml; print('✅ All critical packages installed')" && \
    test -d /usr/local/lib/python3.11/site-packages && \
    echo "Package count: $(ls -1 /usr/local/lib/python3.11/site-packages/ | wc -l)" && \
    echo "=== Full package listing ===" && \
    pip list && \
    echo "=== Verifying C extension packages compiled ===" && \
    python3 -m pip show docker && \
    python3 -m pip show httpx && \
    python3 -m pip show websockets && \
    python3 -m pip show jsonschema && \
    echo "=== Verifying site-packages directory ===" && \
    ls -la /usr/local/lib/python3.11/site-packages/ | grep -E "^d" | wc -l && \
    echo "directories found in site-packages" && \
    echo "✅ All packages ready for final image"



# Verify marker files exist with content (critical for distroless COPY)
RUN echo "=== Verifying marker files ===" && \
    test -f /usr/local/lib/python3.11/site-packages/.lucid-marker && \
    cat /usr/local/lib/python3.11/site-packages/.lucid-marker && \
    test -f /usr/local/bin/.lucid-marker && \
    cat /usr/local/bin/.lucid-marker && \
    echo "✅ Both marker files verified with content"

# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_BEGIN
# alignment-mat gui-docker-manager_manifest.json: compose_service='gui-docker-manager' — manifest py/yml/yaml/json → builder COPY (#10).
COPY common/ ./common/
COPY configs/ ./configs/
COPY gui_docker_manager/gui_docker_manager/ ./gui_docker_manager/
COPY infrastructure/containers/ ./infrastructure/containers/
COPY infrastructure/service_mesh/config/ ./infrastructure/service_mesh/config/
# LUCID_ALIGNMENT_MAT_COPY_DIRECTORIES_END
RUN rm -rf configs/environment 2>/dev/null || true
COPY infrastructure/containers/host-config.yml ./configs/host-config.yml

# Create marker files in app directories (ensures COPY won't fail silently)
RUN echo "LUCID_GUI_DOCKER_MANAGER_APP_$(date +%s)" > ./gui_docker_manager/gui_docker_manager/.lucid-marker && \
    find ./gui_docker_manager -name ".lucid-marker" -exec cat {} \;

# Verify application files in builder stage
RUN echo "=== Verifying GUI Docker Manager application files ===" && \
    test -f ./gui_docker_manager/gui_docker_manager/entrypoint.py && echo "✅ entrypoint.py found" && \
    test -f ./gui_docker_manager/gui_docker_manager/main.py && echo "✅ main.py found" && \
    test -f ./gui_docker_manager/gui_docker_manager/config.py && echo "✅ config.py found" && \
    test -d ./gui_docker_manager/gui_docker_manager/routers && echo "✅ routers directory found" && \
    test -d ./gui_docker_manager/gui_docker_manager/services && echo "✅ services directory found" && \
    PYTHONPATH=/build/gui_docker_manager python3 -c "from gui_docker_manager.main import app; print('✅ Application initialization successful in builder')" && \
    echo "All application files verified in builder stage"

############################
# Stage 2 – Runtime (Distroless)
############################
FROM --platform=$TARGETPLATFORM gcr.io/distroless/python3-debian12:latest

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
WORKDIR /app
LABEL maintainer="Lucid Development Team" \
      org.opencontainers.image.title="Lucid GUI Docker Manager" \
      org.opencontainers.image.description="Distroless GUI Docker Manager for Lucid project" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="support" \
      com.lucid.service="gui-docker-manager" \
      com.lucid.layer="3" \
      org.lucid.layer="3" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="0" \
      com.lucid.cluster="gui-integration" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation,.env.secrets" \
      com.lucid.phase="gui" \
      com.lucid.hostconfig.service_name="gui-docker-manager" \
      com.lucid.hostconfig.port="0" \
      com.lucid.hostconfig.upstream_api_gateway_host="api-gateway" \
      com.lucid.hostconfig.upstream_api_gateway_port="8080"

ENV PATH="/usr/local/bin:/usr/bin:/bin" \
    PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONPATH="/app:/app/gui_docker_manager:/usr/local/lib/python3.11/site-packages" \
    PYTHONIOENCODING="utf-8" \
    LANG="C.UTF-8" \
    LC_ALL="C.UTF-8" \
    GUI_DOCKER_MANAGER_HOST="gui-docker-manager" \
    GUI_DOCKER_MANAGER_PORT="0" \
    LUCID_HOST_CONFIG_PATH="/app/configs/host-config.yml" \
    LUCID_HOST_CONFIG_SERVICE_NAME=gui_docker_manager \
    LUCID_API_GATEWAY_HOST="api-gateway" \
    LUCID_API_GATEWAY_PORT="0"
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
COPY --from=builder --chown=65532:65532 /build/common/ /app/common/
COPY --from=builder --chown=65532:65532 /build/configs/ /app/configs/
COPY --from=builder --chown=65532:65532 /build/gui_docker_manager/ /app/gui_docker_manager/
COPY --from=builder --chown=65532:65532 /build/service_configs/ /app/service_configs/
# LUCID_RUNTIME_COPY_FROM_BUILD_END

# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN

COPY --from=builder --chown=65532:65532 /usr/lib/*/libffi.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/libssl.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/ossl-modules/ /app/usr/lib/
COPY --from=builder --chown=65532:65532 /usr/lib/*/libcurl.so* /app/usr/lib/
COPY --from=builder --chown=65532:65532 /dev/null/ /app/dev/null/
COPY --from=builder --chown=65532:65532 /etc/ssl/ /app/etc/ssl/
COPY --from=builder --chown=65532:65532 /usr/bin/ /app/usr/bin/
COPY --from=builder --chown=65532:65532 /usr/lib/python3/dist-packages/ /app/usr/lib/python3/dist-packages/
COPY --from=builder --chown=65532:65532 /usr/local/ /app/usr/local/
COPY --from=builder --chown=65532:65532 /var/ /app/var/
COPY --from=builder --chown=65532:65532 /var/run /app/var/run
COPY --from=builder --chown=65532:65532 /var/lib /app/var/lib
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /app/etc/ssl/certs/ca-certificates.crt
COPY --from=builder /usr/local/lib/python3.11 /app/usr/local/lib/python3.11
COPY --from=builder /usr/local/bin /app/usr/local/bin

# Verify packages were properly copied to runtime stage (distroless-compatible)
RUN ["python3", "-c", "import os; site_packages = '/usr/local/lib/python3.11/site-packages'; app_dirs = ['/app/gui_docker_manager/gui_docker_manager']; checks = [os.path.isdir(site_packages), os.path.isfile(os.path.join(site_packages, '.lucid-marker')), os.path.isdir('/usr/local/bin'), os.path.isfile('/usr/local/bin/.lucid-marker'), os.path.isfile('/app/configs/host-config.yml')] + [os.path.isdir(d) for d in app_dirs]; assert all(checks), 'runtime verification failed'; print('runtime verified')"]

EXPOSE 8098

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD ["python3", "-c", "import socket; s = socket.socket(); s.settimeout(2); result = s.connect_ex(('127.0.0.1', 8098)); s.close(); exit(0 if result == 0 else 1)"]

USER 65532:65532

# Clear base ENTRYPOINT so CMD works as expected
ENTRYPOINT []

CMD ["python3", "/app/gui_docker_manager/gui_docker_manager/entrypoint.py"]
