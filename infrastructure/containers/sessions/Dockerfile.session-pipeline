import os
import sys

dirs = [
    "/app/sessions",
    "/app/sessions/pipeline",
    "/app/configs",
    "/app/service_configs",
    "/app/usr/local/lib/python3.11/site-packages",
    "/app/wheels",
]
for d in dirs:
    if not os.path.isdir(d):
        print(f"ERROR: {d} missing")
        sys.exit(1)
    if d.endswith("site-packages") and not os.listdir(d):
        print(f"ERROR: {d} empty")
        sys.exit(1)
for cfg in ("/app/configs/session-management.yml", "/app/service_configs/session-management.yml"):
    if not os.path.isfile(cfg) or os.path.getsize(cfg) <= 0:
        print(f"ERROR: {cfg} missing or empty")
        sys.exit(1)
layout = "/app/service_configs/container-runtime-layout.yml"
if not os.path.isfile(layout) or os.path.getsize(layout) <= 0:
    print(f"ERROR: {layout} missing or empty")
    sys.exit(1)
main_py = "/app/sessions/pipeline/main.py"
if not os.path.isfile(main_py):
    print(f"ERROR: {main_py} missing")
    sys.exit(1)
print("✅ Session pipeline runtime layout verified")
PY

