      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="session-pipeline" \
      com.lucid.layer="2" \
      org.lucid.layer="2" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="8083" \
      com.lucid.cluster="processing" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.foundation,.env.secrets" \
      com.lucid.service_id="com.lucid.dockerfile.v1.30ffa9b22f2792fb.infrastructure.containers.sessions.Dockerfile.session-pipeline" \
      onion.lucid.service_id="lucid-30ffa9b22f2792fb-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.30ffa9b22f2792fb:infrastructure/containers/sessions/Dockerfile.session-pipeline" \

ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH=/app/usr/local/bin:/app/usr/bin:/app/bin:$PATH \
    PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONPATH="/app:/app/usr/local/lib/python3.11/site-packages" \
    PYTHONIOENCODING="utf-8" \
    LANG="C.UTF-8" \
    LC_ALL="C.UTF-8" \
    LUCID_HOST_CONFIG_PATH="/app/configs/host-config.yml" \
    LUCID_HOST_CONFIG_SERVICE_NAME=session_pipeline \
    LUCID_SERVICE_HTTP_PATH=http://session-pipeline:8083/app \
    SESSION_PIPELINE_HOST="session-pipeline" \
    SESSION_PIPELINE_PORT="8083"
