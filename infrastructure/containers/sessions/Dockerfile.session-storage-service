      com.lucid.plane="ops" \
      com.lucid.service="session-storage-service" \
      com.lucid.layer="5" \
      org.lucid.layer="5" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="8020" \
      com.lucid.cluster="storage" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.tunnel-tools,.env.foundation" \
      com.lucid.service_id="com.lucid.dockerfile.v1.0491f551b52254df.infrastructure.containers.sessions.Dockerfile.session-storage-service" \
      onion.lucid.service_id="lucid-0491f551b52254df-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.0491f551b52254df:infrastructure/containers/sessions/Dockerfile.session-storage-service" \

ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH=/app/usr/local/bin:/app/usr/bin:/app/bin:$PATH \
