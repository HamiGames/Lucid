COPY --from=builder --chown=65532:65532 /usr/lib/python3/dist-packages/ /app/usr/lib/python3/dist-packages/
COPY --from=builder --chown=65532:65532 /usr/local/bin/ /app/usr/local/bin/
COPY --from=builder --chown=65532:65532 /usr/local/lib/python3.11/ /app/usr/local/lib/python3.11/
COPY --from=builder --chown=65532:65532 /var/lib/ /app/var/lib/
COPY --from=builder --chown=65532:65532 /var/run/ /app/var/run/
# LUCID_RUNTIME_COPY_FROM_BUILDER_APT_END
# LUCID_RUNTIME_COPY_FROM_BUILD_BEGIN
# Generated: same directory set as LUCID_X_FILES_SKELETON (./ under WORKDIR /build).
RUN ["/app/usr/bin/python3.11", "-c", \
    "import os; os.environ['OVERLORD_DOMAIN']='admin'; import sys; sys.path[:0]=['/app/admin/overlord','/app/usr/local/lib/python3.11/site-packages']; \
     import app as a; print('admin app module ok')"]

RUN ["/app/usr/bin/python3.11", "-c", \
    "import os, sys; sys.path[:0]=['/app/usr/local/lib/python3.11/site-packages']; \
     import fastapi, uvicorn, yaml, pymongo, motor, redis; \
     assert os.path.isfile('/app/configs/host-config.yml'); \
     assert os.path.isfile('/app/configs/database-config.yaml'); \
     assert os.path.isfile('/app/over_lord/triggers.yaml'); print('admin-overlord runtime ok')"]

EXPOSE 8140

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["/app/usr/bin/python3.11", "-c", \
    "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8140/health', timeout=2)"]
USER 65532:65532

ENTRYPOINT ["/app/usr/bin/tini", "--"]

CMD ["/app/usr/bin/python3.11", "/app/admin/overlord/entrypoint.py"]
