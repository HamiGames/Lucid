      org.opencontainers.image.description="Distroless admin portal gateway (openssl-api + /app/node layout)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      com.lucid.plane="ops" \
      com.lucid.service="admin-system-gateway" \
      com.lucid.layer="1" \
      org.lucid.layer="1" \
      com.lucid.platform="arm64" \
      com.lucid.architecture="linux/arm64" \
      com.lucid.security="distroless" \
      com.lucid.vulnerabilities="zero" \
      com.lucid.expose="8155" \
      com.lucid.cluster="core" \
      com.lucid.tor.compatible="true" \
      com.lucid.env.config=".env.admin-system-gateway,.env.foundation,.env.secrets" \
      com.lucid.service_id="com.lucid.dockerfile.v1.fc3684a4624a54de.infrastructure.containers.admin.Dockerfile.admin-system-gateway" \
      onion.lucid.service_id="lucid-fc3684a4624a54de-infrastructure-container" \
      org.lucid.service_id="org.lucid.dockerfile.v1.fc3684a4624a54de:infrastructure/containers/admin/Dockerfile.admin-system-gateway" \

ENV     PUBLIC_TOR_IP="${PUBLIC_TOR_IP}" \
    LUCID_INTERNAL_NETWORK_NAME="${LUCID_INTERNAL_NETWORK_NAME}" \
    LUCID_TOR_EGRESS_NETWORK_NAME="${LUCID_TOR_EGRESS_NETWORK_NAME}" \
    PATH=/app/usr/local/bin:/app/usr/bin:/app/bin:$PATH \
    PYTHONUNBUFFERED="1" \
